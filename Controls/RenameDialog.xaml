<Window x:Class="PaDDY.Controls.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:p="clr-namespace:PaDDY.Helpers"
        Title="{p:Loc RenameDialogTitle}"
        Icon="/PaDDY.ico"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="5"
                            ResizeBorderThickness="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarGradient}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="12,12,0,0">
            <Grid>
                <TextBlock Text="{p:Loc RenameDialogTitle}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <Button Style="{StaticResource ChromeCloseBtn}"
                        HorizontalAlignment="Right"
                        ToolTip="Close"
                        IsCancel="True"
                        Click="ChromeClose_Click">
                    <TextBlock Text="&#xE8BB;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1"
                Margin="10,0,10,10"
                Padding="16"
                CornerRadius="0,0,12,12"
                Background="{DynamicResource SecondaryWindowBackgroundBrush}"
                BorderBrush="{DynamicResource WindowEdgeBrush}"
                BorderThickness="0"
                Effect="{StaticResource SecondaryWindowShadow}">
            <StackPanel>
                <TextBox x:Name="NameTextBox"
                         Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="OkButton"
                            Content="{p:Loc OK}"
                            Width="75"
                            Margin="0,0,8,0"
                            Foreground="{DynamicResource AccentGreenBrush}"
                            IsDefault="True"
                            Click="Ok_Click"/>
                    <Button Content="{p:Loc Cancel}"
                            Width="75"
                            IsCancel="True"
                            Click="Cancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
