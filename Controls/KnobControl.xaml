<UserControl x:Class="PaDDY.Controls.KnobControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="84" Height="96"
             Cursor="Hand"
             Focusable="True"
             MouseDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseUp="OnMouseUp"
             MouseWheel="OnMouseWheel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dial Canvas / Graphic -->
        <Grid Grid.Row="0" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Outer Track Arc (Background Ring) -->
            <Path x:Name="TrackArc"
                  Stroke="{DynamicResource InputBorderBrush}"
                  StrokeThickness="4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

            <!-- Active Value Arc (Green Accent Ring) -->
            <Path x:Name="ValueArc"
                  Stroke="{DynamicResource AccentGreenBrush}"
                  StrokeThickness="4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="6" Color="#4CAF50" Opacity="0.6" ShadowDepth="0"/>
                </Path.Effect>
            </Path>

            <!-- Inner Dial Face -->
            <Ellipse Width="46" Height="46"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="{DynamicResource InputBgBrush}"
                     Stroke="{DynamicResource CardBorderBrush}">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.25" ShadowDepth="2"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Pointer Line / Indicator Notch -->
            <Grid Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="PointerRotation" CenterX="23" CenterY="23" Angle="-135"/>
                </Grid.RenderTransform>
                <Rectangle Width="3" Height="8"
                           Fill="{DynamicResource AccentGreenBrush}"
                           RadiusX="1.5" RadiusY="1.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,3,0,0">
                    <Rectangle.Effect>
                        <DropShadowEffect BlurRadius="4" Color="#4CAF50" Opacity="0.8" ShadowDepth="0"/>
                    </Rectangle.Effect>
                </Rectangle>
            </Grid>
        </Grid>

        <!-- Label / Value Text below Knob -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0">
            <TextBlock x:Name="LabelText"
                       Text="Knob"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="80"/>
            <TextBlock x:Name="ValueText"
                       Text="0"
                       FontSize="9.5"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentGreenBrush}"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
