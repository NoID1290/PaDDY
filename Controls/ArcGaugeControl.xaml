<UserControl x:Class="PaDDY.Controls.ArcGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="190" Height="125"
             Cursor="Hand"
             Focusable="True"
             MouseDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseUp="OnMouseUp"
             MouseWheel="OnMouseWheel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Arc Canvas -->
        <Grid Grid.Row="0" Width="170" Height="90" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <!-- Background Arc Track -->
            <Path x:Name="TrackArc"
                  Stroke="#242838"
                  StrokeThickness="7"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

            <!-- Active Green Arc -->
            <Path x:Name="ValueArc"
                  Stroke="{DynamicResource AccentGreenBrush}"
                  StrokeThickness="7"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#4CAF50" Opacity="0.75" ShadowDepth="0"/>
                </Path.Effect>
            </Path>

            <!-- Center Content: Title & Gain Value -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,0">
                <TextBlock x:Name="TitleText"
                           Text="Master Gain"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="GainValueText"
                           Text="0 dB"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentGreenBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Pointer Needle -->
            <Grid Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="NeedleRotation" CenterX="85" CenterY="85" Angle="-90"/>
                </Grid.RenderTransform>
                <Rectangle Width="3.5" Height="14"
                           Fill="#FFFFFF"
                           RadiusX="1.5" RadiusY="1.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,6,0,0">
                    <Rectangle.Effect>
                        <DropShadowEffect BlurRadius="4" Color="#FFFFFF" Opacity="0.9" ShadowDepth="0"/>
                    </Rectangle.Effect>
                </Rectangle>
            </Grid>
        </Grid>

        <!-- Bottom Subtitle / Info -->
        <TextBlock x:Name="SubtitleText"
                   Grid.Row="1"
                   Text="OUTPUT BUS"
                   FontSize="9"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SubtleTextBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
