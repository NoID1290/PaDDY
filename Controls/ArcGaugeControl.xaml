<UserControl x:Class="PaDDY.Controls.ArcGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="115"
             Cursor="Hand"
             Focusable="True"
             MouseDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseUp="OnMouseUp"
             MouseWheel="OnMouseWheel">
    <Viewbox Stretch="Uniform">
        <Grid Width="170" Height="110">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <!-- Arc Canvas -->
            <Grid Grid.Row="0" Width="170" Height="90" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <!-- Background Arc Track -->
                <Path x:Name="TrackArc"
                      Stroke="#242838"
                      StrokeThickness="6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>

                <!-- Active Green Arc -->
                <Path x:Name="ValueArc"
                      Stroke="{DynamicResource AccentGreenBrush}"
                      StrokeThickness="6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="8" Color="#4CAF50" Opacity="0.75" ShadowDepth="0"/>
                    </Path.Effect>
                </Path>

                <!-- Center Content: Title & Gain Value -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock x:Name="TitleText"
                               Text="Master Gain"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GainValueText"
                               Text="0 dB"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentGreenBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Pointer Needle (Aligned precisely with radius = 70) -->
                <Grid Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="NeedleRotation" CenterX="85" CenterY="85" Angle="-90"/>
                    </Grid.RenderTransform>
                    <Rectangle Width="3" Height="10"
                               Fill="#FFFFFF"
                               RadiusX="1.5" RadiusY="1.5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,10,0,0">
                        <Rectangle.Effect>
                            <DropShadowEffect BlurRadius="4" Color="#FFFFFF" Opacity="0.9" ShadowDepth="0"/>
                        </Rectangle.Effect>
                    </Rectangle>
                </Grid>
            </Grid>

            <!-- Bottom Subtitle / Info -->
            <TextBlock x:Name="SubtitleText"
                       Grid.Row="1"
                       Text="OUTPUT BUS"
                       FontSize="8.5"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Viewbox>
</UserControl>
