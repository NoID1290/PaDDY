<UserControl x:Class="PaDDY.Controls.RecordingPadButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="145"
        Height="90"
             Cursor="Hand"
             RenderTransformOrigin="0.5,0.5"
             MouseRightButtonDown="OnPadMouseRightButtonDown">
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <!-- Entrance animation: fade + slide up -->
        <Storyboard x:Key="EntranceAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Small overlay-button style -->
        <Style x:Key="OverlayBtn"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="Width"
                    Value="18"/>
            <Setter Property="Height"
                    Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

<Border x:Name="TileBorder"
             BorderBrush="{DynamicResource CardBorderBrush}"
             Background="{DynamicResource CardBgBrush}"
             BorderThickness="0.8"
             CornerRadius="6"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.1"/>
                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.04" Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction> 
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.04" Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction> 
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                         Storyboard.TargetProperty="Opacity"
                                         To="0" Duration="0:0:0.1"/>
                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.0" Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.0" Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="0.96" Duration="0:0:0.08"/>
                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="0.96" Duration="0:0:0.08"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.02" Duration="0:0:0.1">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.04" Duration="0:0:0.1">
                            <DoubleAnimation.EasingFunction> 
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <!-- Root grid: content + overlay buttons -->
        <Grid>
            <!-- Darken Overlay to increase contrast -->
            <Border Background="#33000000"
                    CornerRadius="6"
                    IsHitTestVisible="False" />

            <!-- Hover Overlay -->
            <Border x:Name="HoverOverlay"
                    Background="#15FFFFFF"
                    Opacity="0"
                    CornerRadius="6"
                    IsHitTestVisible="False" />

            <!-- Main content -->
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Play/Stop icon -->
                <TextBlock x:Name="IconText"
                           Grid.Row="0"
                           Text="🎤"
                           Foreground="{DynamicResource ControlTextBrush}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Recording name -->
                <TextBlock x:Name="NameLabel"
                           Grid.Row="1"
                           Text="Recording"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="10"
                           Margin="0,-20,0,0"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           MaxWidth="125"
                           MaxHeight="28"/>

                <!-- Duration and Non-Destructive badge -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,25,0,0">
                    <TextBlock x:Name="DurationLabel"
                               Text="0.0s"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="9"/>
                    <TextBlock x:Name="NdIndicator"
                               Text=" ⚡"
                               Foreground="{DynamicResource AccentGreenBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               ToolTip="Non-destructive real-time playback"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Overlay buttons -->
            <Grid>
                <!-- ⭐ Favourite — top-left -->
                <Button x:Name="FavBtn"
                        Style="{StaticResource OverlayBtn}"
                        Content="☆"
                        Foreground="{DynamicResource SubtleTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="4,4,0,0"
                        FontSize="15"
                        ToolTip="Toggle favourite"
                        Click="FavBtn_Click"/>

                <!-- 🎨 Color — top-left (right of Favorite) -->
                <Button x:Name="ColorBtn"
                        Style="{StaticResource OverlayBtn}"
                        Content="🎨"
                        Foreground="{DynamicResource SubtleTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="24,4,0,0"
                        ToolTip="Change Color"
                        Click="ColorBtn_Click"/>

                <!-- ✕ Delete — top-right -->
                <Button x:Name="DelBtn"
                        Content="✕"
                        Foreground="{DynamicResource SubtleTextBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,4,0"
                        ToolTip="Delete"
                        Click="DelBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button"
                                BasedOn="{StaticResource OverlayBtn}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                        Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource AccentRedBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 💾 Export — top-right (left of Delete) -->
                <Button x:Name="ExportBtn"
                        Style="{StaticResource OverlayBtn}"
                        Content="💾"
                        Foreground="{DynamicResource SubtleTextBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,24,0"
                        ToolTip="Export…"
                        Click="ExportBtn_Click"/>

                <!-- ✏ Rename — bottom-right -->
                <Button x:Name="RenameBtn"
                        Style="{StaticResource OverlayBtn}"
                        Content="✏"
                        Foreground="{DynamicResource SubtleTextBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,4,4"
                        ToolTip="Rename"
                        Click="RenameBtn_Click"/>

                <!-- ✂ Trim — bottom-left -->
                <Button x:Name="TrimBtn"
                        Style="{StaticResource OverlayBtn}"
                        Content="✂"
                        Foreground="{DynamicResource SubtleTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="4,0,0,4"
                        ToolTip="Trim / Edit"
                        Click="TrimBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
