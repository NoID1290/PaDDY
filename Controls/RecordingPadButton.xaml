<UserControl x:Class="PaDDY.Controls.RecordingPadButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="145"
        Height="90"
             RenderTransformOrigin="0.5,0.5"
             RightTapped="OnRightTapped">
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <!-- Entrance animation: fade + slide up -->
        <Storyboard x:Key="EntranceAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Small overlay-button style -->
        <Style x:Key="OverlayBtn"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="Width"
                    Value="18"/>
            <Setter Property="Height"
                    Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

<Border x:Name="TileBorder"
             BorderBrush="{ThemeResource CardBorderBrush}"
             Background="{ThemeResource CardBgBrush}"
             BorderThickness="0.8"
             CornerRadius="6"
             UseLayoutRounding="True"
             >

        

        <!-- Root grid: content + overlay buttons -->
        <Grid>
            <!-- Darken Overlay to increase contrast -->
            <Border Background="#33000000"
                    CornerRadius="6"
                    IsHitTestVisible="False" />

            <!-- Hover Overlay -->
            <Border x:Name="HoverOverlay"
                    Background="#15FFFFFF"
                    Opacity="0"
                    CornerRadius="6"
                    IsHitTestVisible="False" />

            <!-- Main content -->
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Play/Stop icon -->
                <TextBlock x:Name="IconText"
                           Grid.Row="0"
                           Text="🎤"
                           Foreground="{ThemeResource ControlTextBrush}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Recording name -->
                <TextBlock x:Name="NameLabel"
                           Grid.Row="1"
                           Text="Recording"
                           Foreground="{ThemeResource PrimaryTextBrush}"
                           FontSize="10"
                           Margin="0,-20,0,0"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           MaxWidth="125"
                           MaxHeight="28"/>

                <!-- Duration -->
                <TextBlock x:Name="DurationLabel"
                           Grid.Row="1"
                           Text="0.0s"
                           Margin="0,25,0,0"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           FontSize="9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"/>
            </Grid>

            <!-- Overlay buttons -->
            <Grid>
                <!-- ⭐ Favourite — top-left -->
                <Button x:Name="FavBtn"
                        Style="{StaticResource OverlayBtn}"
                        Content="☆"
                        Foreground="{ThemeResource SubtleTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="4,4,0,0"
                        FontSize="15"
                        ToolTipService.ToolTip="Toggle favourite"
                        Click="FavBtn_Click"/>

                <!-- ✕ Delete — top-right -->
                <Button x:Name="DelBtn"
                        Content="✕"
                        Foreground="{ThemeResource SubtleTextBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,4,0"
                        ToolTipService.ToolTip="Delete"
                        Click="DelBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button"
                                BasedOn="{StaticResource OverlayBtn}">
                            
                        </Style>
                    </Button.Style>
                </Button>

                <!-- ✏ Rename — bottom-right -->
                <Button x:Name="RenameBtn"
                        Style="{StaticResource OverlayBtn}"
                        Content="✏"
                        Foreground="{ThemeResource SubtleTextBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,4,4"
                        ToolTipService.ToolTip="Rename"
                        Click="RenameBtn_Click"/>

                <!-- ✂ Trim — bottom-left -->
                <Button x:Name="TrimBtn"
                        Style="{StaticResource OverlayBtn}"
                        Content="✂"
                        Foreground="{ThemeResource SubtleTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="4,0,0,4"
                        ToolTipService.ToolTip="Trim / Edit"
                        Click="TrimBtn_Click"/>

                <!-- 💾 Export — bottom-center -->
                <Button x:Name="ExportBtn"
                        Style="{StaticResource OverlayBtn}"
                        Content="💾"
                        Foreground="{ThemeResource SubtleTextBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,20,0"
                        ToolTipService.ToolTip="Export…"
                        Click="ExportBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>






