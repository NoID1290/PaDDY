<UserControl x:Class="PaDDY.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Visibility="Collapsed"
             IsHitTestVisible="True">
    
    <UserControl.Resources>
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <!-- Fast inner ring spin (Counter-Clockwise) -->
            <DoubleAnimation 
                Storyboard.TargetName="InnerRing"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="360" To="0" Duration="0:0:1.5" />
                
            <!-- Slow outer ring spin (Clockwise) -->
            <DoubleAnimation 
                Storyboard.TargetName="OuterRing"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="0" To="360" Duration="0:0:2.5" />
            
            <!-- Pulse the logo glow -->
            <DoubleAnimation 
                Storyboard.TargetName="LogoGlow"
                Storyboard.TargetProperty="Opacity"
                From="0.3" To="0.8" Duration="0:0:1.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Pulse the text opacity -->
            <DoubleAnimation 
                Storyboard.TargetName="LoadingText"
                Storyboard.TargetProperty="Opacity"
                From="0.4" To="1" Duration="0:0:1.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Logo Container -->
                <Grid Width="140" Height="140" Margin="0,0,0,20">
                    <!-- Outer spinning ring -->
                    <Path x:Name="OuterRing"
                          Data="M 70,10 A 60,60 0 1 1 10,70"
                          StrokeThickness="4" 
                          StrokeEndLineCap="Round" 
                          StrokeStartLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#004CAF50" Offset="0"/>
                                <GradientStop Color="#FF4CAF50" Offset="0.5"/>
                                <GradientStop Color="#FF81C784" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                        <Path.Effect>
                            <DropShadowEffect Color="#FF4CAF50" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                        </Path.Effect>
                    </Path>

                    <!-- Inner spinning ring -->
                    <Path x:Name="InnerRing"
                          Data="M 70,25 A 45,45 0 1 0 115,70"
                          StrokeThickness="3" 
                          StrokeEndLineCap="Round" 
                          StrokeStartLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                <GradientStop Color="#007070A8" Offset="0"/>
                                <GradientStop Color="#FF7070A8" Offset="0.5"/>
                                <GradientStop Color="#FFAAAAFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                        <Path.Effect>
                            <DropShadowEffect Color="#FF7070A8" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                        </Path.Effect>
                    </Path>

                    <!-- Inner Logo -->
                    <Border Width="70" Height="70" 
                            CornerRadius="35"
                            Background="#15FFFFFF" 
                            BorderBrush="#25FFFFFF" 
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect x:Name="LogoGlow"
                                              ShadowDepth="0"
                                              BlurRadius="20"
                                              Color="#FF4CAF50"
                                              Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LogoTextPa" Text="Pa"
                                       FontSize="18"
                                       FontWeight="ExtraBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFAAAAFF" Offset="0"/>
                                        <GradientStop Color="#FF7070A8" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock x:Name="LogoTextDdy" Text="DDY"
                                       FontSize="18"
                                       FontWeight="ExtraBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF81C784" Offset="0"/>
                                        <GradientStop Color="#FF4CAF50" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Status Text -->
                <TextBlock x:Name="LoadingText" 
                           Text="Processing..." 
                           Foreground="#FFE0E0E0" 
                           FontSize="16" 
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF000000" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Download Progress Bar (hidden by default) -->
                <Grid x:Name="ProgressBarContainer" Visibility="Collapsed" 
                      Width="200" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Track -->
                    <Border Grid.Row="0" Background="#20FFFFFF" CornerRadius="4" Height="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF000000" BlurRadius="3" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                    </Border>
                    <!-- Fill -->
                    <Border x:Name="ProgressBarFill" Grid.Row="0"
                            CornerRadius="4" Height="8"
                            HorizontalAlignment="Left" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF4CAF50" Offset="0"/>
                                <GradientStop Color="#FF81C784" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF4CAF50" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                    <!-- Percentage -->
                    <TextBlock x:Name="ProgressPercentText" Grid.Row="1"
                               Text="0%"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               Foreground="#FFB0B0B0"/>
                </Grid>
                
            </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>
