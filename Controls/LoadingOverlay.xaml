<UserControl x:Class="PaDDY.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Visibility="Collapsed"
             IsHitTestVisible="True">
    
    <UserControl.Resources>
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <!-- Spin the outer ring -->
            <DoubleAnimation 
                Storyboard.TargetName="SpinningRing"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="0" To="360" Duration="0:0:1.5" />
            
            <!-- Pulse the logo glow -->
            <DoubleAnimation 
                Storyboard.TargetName="LogoGlow"
                Storyboard.TargetProperty="Opacity"
                From="0.2" To="1.0" Duration="0:0:1.0" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Pulse the text opacity -->
            <DoubleAnimation 
                Storyboard.TargetName="LoadingText"
                Storyboard.TargetProperty="Opacity"
                From="0.4" To="1" Duration="0:0:1" AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{Binding Background, RelativeSource={RelativeSource Self}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Logo Container -->
            <Grid Width="120" Height="120">
                <!-- Outer spinning ring -->
                <Path x:Name="SpinningRing"
                      Data="M 60,10 A 50,50 0 1 1 10,60"
                      Stroke="#FF4CAF50" 
                      StrokeThickness="4" 
                      StrokeEndLineCap="Round" 
                      StrokeStartLineCap="Round"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Path.RenderTransform>
                    
                </Path>

                <!-- Inner Logo -->
                <Border Width="70" Height="70" 
                        CornerRadius="35"
                        Background="#0F4CAF50" 
                        BorderBrush="#1EFFFFFF" 
                        BorderThickness="1">
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Pa"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FF7070A8"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="DDY"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FF4CAF50"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Status Text -->
            <TextBlock x:Name="LoadingText" 
                       Text="Processing..." 
                       Foreground="#FFC0C0D8" 
                       FontSize="16" 
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       Margin="0,24,0,0" 
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>



