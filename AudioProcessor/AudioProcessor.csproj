<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765;CS8767;CS8769</NoWarn>
    <AssemblyName>NoIDSoftwork.AudioProcessor</AssemblyName>
    <RootNamespace>NoIDSoftwork.AudioProcessor</RootNamespace>
    <Description>NoIDSoftwork.AudioProcessor</Description>
    <Product>NoIDSoftwork.AudioProcessor</Product>
    <Company>NoID Softwork</Company>
    <Copyright>Copyright (c) NoID Softwork 2020-2026. All rights reserved.</Copyright>
    <Version>1.4.1.0620</Version>
    <AssemblyVersion>1.4.1.0620</AssemblyVersion>
    <FileVersion>1.4.1.0620</FileVersion>
    <InformationalVersion>1.4.1.0620</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlatformTarget)' == 'x64'">
    <DefineConstants>$(DefineConstants);X64</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EffectProcessor\EffectProcessor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Use vendored source for deterministic single-DLL compilation. -->
    <Compile Remove="vendors/**/*.cs" />
    <!-- Prevent any vendor app.config from being treated as this project's app.config,
         which would otherwise produce a spurious NoIDSoftwork.AudioProcessor.dll.config. -->
    <None Remove="vendors/**/*.config" />
    <EmbeddedResource Remove="vendors/**/*.resx" />
    <Page Remove="vendors/**/*.xaml" />
    <ApplicationDefinition Remove="vendors/**/*.xaml" />
    <Compile Include="vendors/NAudio/NAudio.Core/**/*.cs" />
    <Compile Include="vendors/NAudio/NAudio/**/*.cs" />
    <Compile Include="vendors/NAudio/NAudio.Wasapi/**/*.cs" />
    <Compile Include="vendors/NAudio/NAudio.WinForms/**/*.cs" />
    <Compile Include="vendors/NAudio/NAudio.WinMM/**/*.cs" />
    <Compile Include="vendors/NAudio.Lame/LameDLLWrap/**/*.cs" />
    <Compile Include="vendors/NAudio.Lame/NAudio.Lame/**/*.cs" />
    <Compile Include="vendors/NAudio.Vorbis/NAudio.Vorbis/**/*.cs" />
    <Compile Include="vendors/NVorbis/NVorbis/**/*.cs" />
    <Compile Include="vendors/Concentus/CSharp/Concentus/**/*.cs" />
    <Compile Include="vendors/Concentus.OggFile/Concentus.Oggfile/**/*.cs" />
    <Compile Include="vendors/OggVorbisEncoder/OggVorbisEncoder/**/*.cs" />
    <Compile Include="vendors/CUETools.Flake/**/*.cs" />
    <Compile Include="vendors/NAudio.Flac/**/*.cs" />
    <Compile Remove="vendors/**/bin/**/*.cs;vendors/**/obj/**/*.cs;vendors/**/tests/**/*.cs;vendors/**/test/**/*.cs;vendors/**/example/**/*.cs;vendors/**/examples/**/*.cs;vendors/**/benchmark/**/*.cs" />
    <!-- NAudio.Lame depends on native libmp3lame binaries at runtime. -->
    <!-- Link="..." flattens the output path so the DLL lands in the app root, where DllImport can find it. -->
    <None Include="vendors/NAudio.Lame/NAudio.Lame/libmp3lame.32.dll" Link="libmp3lame.32.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="vendors/NAudio.Lame/NAudio.Lame/libmp3lame.64.dll" Link="libmp3lame.64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep upstream vendored sources untouched while limiting warning noise to app-owned code. -->
    <Compile Update="vendors/**/*.cs" NoWarn="CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765;CS8767;CS8769" />
  </ItemGroup>
</Project>