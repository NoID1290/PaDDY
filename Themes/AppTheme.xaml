<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- ═══════════════════════════════════════════════════════════════
         BRUSH / COLOR RESOURCES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="WindowBgBrush"       Color="#FF0D0D14"/>
    <SolidColorBrush x:Key="CardBgBrush"         Color="#FF1A1A28"/>
    <SolidColorBrush x:Key="CardBorderBrush"     Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="SubtleTextBrush"     Color="#FF7070A0"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"    Color="#FFE8E8F4"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"  Color="#FFB0B0CC"/>
    <SolidColorBrush x:Key="AccentGreenBrush"    Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="AccentRedBrush"      Color="#FFC62828"/>
    <SolidColorBrush x:Key="AccentAmberBrush"    Color="#FFFFC107"/>
    <SolidColorBrush x:Key="InputBgBrush"        Color="#FF141420"/>
    <SolidColorBrush x:Key="InputBorderBrush"    Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="WindowEdgeBrush"     Color="#2CFFFFFF"/>
    <SolidColorBrush x:Key="WindowGlowBrush"     Color="#FF1A2030"/>

    <!-- Extended semantic surfaces (swapped at runtime by ThemeManager.ApplyTheme) -->
    <SolidColorBrush x:Key="ControlTextBrush"    Color="#FFD0D0E0"/>
    <SolidColorBrush x:Key="ButtonBgBrush"       Color="#FF1C1C2C"/>
    <SolidColorBrush x:Key="ButtonHoverBgBrush"  Color="#FF282840"/>
    <SolidColorBrush x:Key="ButtonPressedBgBrush" Color="#FF0F0F1C"/>
    <SolidColorBrush x:Key="MenuBgBrush"         Color="#FF10101E"/>
    <SolidColorBrush x:Key="MenuHighlightBrush"  Color="#FF3E4A5A"/>
    <SolidColorBrush x:Key="MenuSelectedBrush"   Color="#FF2A5A8E"/>
    <SolidColorBrush x:Key="DividerBrush"        Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BadgeBgBrush"        Color="#FF0C0C18"/>
    <SolidColorBrush x:Key="AccentTitleBrush"    Color="#FF5A9070"/>
    <SolidColorBrush x:Key="ChromeButtonFgBrush" Color="#FFB0B8D0"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#FFE9EDF9"/>

    <!-- Dynamic CornerRadius resources (mutated at runtime by ThemeManager.ApplyTheme) -->
    <CornerRadius x:Key="CardCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="SecondaryWindowCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="TopWindowCornerRadius">12,12,0,0</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">17</CornerRadius>
    <CornerRadius x:Key="ThumbCornerRadius">3</CornerRadius>

    <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF18182A" Offset="0"/>
        <GradientStop Color="#FF10101C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SecondaryWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF171827" Offset="0"/>
        <GradientStop Color="#FF11131E" Offset="0.58"/>
        <GradientStop Color="#FF0C0D15" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SecondaryFooterBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF171A28" Offset="0"/>
        <GradientStop Color="#FF11131D" Offset="1"/>
    </LinearGradientBrush>

    <!-- Audio meter fill gradients (swapped at runtime by ThemeManager.ApplyMeterSkin) -->
    <LinearGradientBrush x:Key="MeterInBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF000000" Offset="0.0"/>
        <GradientStop Color="#FF2E7D32" Offset="0.015"/>
        <GradientStop Color="#FF4CAF50" Offset="0.35"/>
        <GradientStop Color="#FFFDD835" Offset="0.70"/>
        <GradientStop Color="#FFFF9800" Offset="0.85"/>
        <GradientStop Color="#FFF44336" Offset="0.95"/>
        <GradientStop Color="#FFD50000" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MeterVerticalBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#FF000000" Offset="0.0"/>
        <GradientStop Color="#FF2E7D32" Offset="0.015"/>
        <GradientStop Color="#FF4CAF50" Offset="0.35"/>
        <GradientStop Color="#FFFDD835" Offset="0.70"/>
        <GradientStop Color="#FFFF9800" Offset="0.85"/>
        <GradientStop Color="#FFF44336" Offset="0.95"/>
        <GradientStop Color="#FFD50000" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MeterOutBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF000000" Offset="0.0"/>
        <GradientStop Color="#FF1565C0" Offset="0.015"/>
        <GradientStop Color="#FF42A5F5" Offset="0.35"/>
        <GradientStop Color="#FF80DEEA" Offset="0.70"/>
        <GradientStop Color="#FFFDD835" Offset="0.85"/>
        <GradientStop Color="#FFF44336" Offset="0.95"/>
        <GradientStop Color="#FFD50000" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MeterMonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF000000" Offset="0.0"/>
        <GradientStop Color="#FFFF00EA" Offset="0.015"/>
        <GradientStop Color="#FFFF79D7" Offset="0.35"/>
        <GradientStop Color="#FFCA23BC" Offset="0.70"/>
        <GradientStop Color="#FFFF00BF" Offset="0.85"/>
        <GradientStop Color="#FFFF6BFF" Offset="0.95"/>
        <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="SecondaryWindowShadow"
                      ShadowDepth="5"
                      BlurRadius="26"
                      Color="#FF000000"
                      Opacity="0.52"/>

    <DropShadowEffect x:Key="PanelShadow"
                      ShadowDepth="2"
                      BlurRadius="16"
                      Color="#FF000000"
                      Opacity="0.48"/>

    <!-- ═══════════════════════════════════════════════════════════════
         BASE CONTROL STYLES (implicit / no x:Key = apply to all)
    ═══════════════════════════════════════════════════════════════ -->

    <!-- TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{DynamicResource AppFont}"/>
        <Setter Property="Foreground"        Value="{DynamicResource ControlTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Label -->
    <Style TargetType="Label">
        <Setter Property="FontFamily"        Value="{DynamicResource AppFont}"/>
        <Setter Property="Foreground"        Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding"           Value="0"/>
    </Style>

    <!-- Slider -->
    <Style x:Key="DarkSliderThumb" TargetType="Thumb">
        <Setter Property="Width"  Value="12"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd"
                            Background="{DynamicResource ScrollThumbBrush}"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ThumbCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="#FF000000" Opacity="0.35"/>
                        </Border.Effect>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="#FFFFFFFF"/>
                            <Setter TargetName="ThumbBd" Property="BorderBrush" Value="#99FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
                            <Setter TargetName="ThumbBd" Property="BorderBrush" Value="#AA7CFF7F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"        Value="{DynamicResource AccentGreenBrush}"/>
        <Setter Property="Background"        Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="MinHeight"         Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="0">
                        <!-- Horizontal track background -->
                        <Border x:Name="TrackBg"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"/>
                        <!-- Vertical track background (hidden by default) -->
                        <Border x:Name="TrackBgVertical"
                                Width="4"
                                HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Visibility="Collapsed"/>
                        
                        <Track x:Name="PART_Track"
                               VerticalAlignment="Center"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Background="{TemplateBinding Foreground}"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid>
                                                <!-- Horizontal: Height for progress bar -->
                                                <Border x:Name="HorizontalTrack"
                                                        Height="4"
                                                        VerticalAlignment="Center"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="2"/>
                                                <!-- Vertical: Width for progress bar (shown via trigger) -->
                                                <Border x:Name="VerticalTrack"
                                                        Width="4"
                                                        HorizontalAlignment="Center"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="2"
                                                        Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=Orientation}" Value="Vertical">
                                                    <Setter TargetName="HorizontalTrack" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="VerticalTrack" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DarkSliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid>
                                                <!-- Horizontal: Height for background -->
                                                <Border x:Name="HorizontalTrackIncrease"
                                                        Height="4"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        CornerRadius="2"/>
                                                <!-- Vertical: Width for background (shown via trigger) -->
                                                <Border x:Name="VerticalTrackIncrease"
                                                        Width="4"
                                                        HorizontalAlignment="Center"
                                                        Background="Transparent"
                                                        CornerRadius="2"
                                                        Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=Orientation}" Value="Vertical">
                                                    <Setter TargetName="HorizontalTrackIncrease" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="VerticalTrackIncrease" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="TrackBg" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="TrackBgVertical" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Track" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_Track" Property="HorizontalAlignment" Value="Center"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar -->
    <Style x:Key="DarkScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}"/>
        <Setter Property="BorderBrush" Value="#66FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ThumbCornerRadius}"
                            SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#88FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource InputBorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Width="{TemplateBinding Width}" Background="Transparent">
                                <Border Margin="2,0" CornerRadius="3" Background="{TemplateBinding Background}"/>
                                <Track x:Name="PART_Track"
                                       Margin="2,0"
                                       Orientation="Vertical"
                                       IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Style="{StaticResource DarkScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DarkScrollBarThumb}" MinHeight="28" Width="10"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Style="{StaticResource DarkScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="14"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Height="{TemplateBinding Height}" Background="Transparent">
                                <Border Margin="0,2" CornerRadius="3" Background="{TemplateBinding Background}"/>
                                <Track x:Name="PART_Track"
                                       Margin="0,2"
                                       Orientation="Horizontal"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{StaticResource DarkScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DarkScrollBarThumb}" MinWidth="28" Height="10"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{StaticResource DarkScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Illuminated Smooth-Animated Sliding Studio Rack Power Switch -->
    <Style x:Key="RackPowerSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <!-- Sliding Track Container -->
                        <Border x:Name="Track"
                                Width="38" Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1">
                            <!-- Sliding Round Thumb with TranslateTransform -->
                            <Border x:Name="Thumb"
                                    Width="14" Height="14"
                                    CornerRadius="7"
                                    Background="{DynamicResource SubtleTextBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource CardBgBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource RackPowerSwitch}">
        <Setter Property="Foreground"        Value="{DynamicResource ControlTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource SmallCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background"              Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="Foreground"              Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush"             Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness"         Value="1"/>
        <Setter Property="Height"                  Value="28"/>
        <Setter Property="Padding"                 Value="7,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush"              Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <!-- Button -->
    <Style TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource ButtonBgBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource ControlTextBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,5"/>
        <Setter Property="Height"          Value="30"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"   Value="{DynamicResource ButtonHoverBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"  Value="{DynamicResource AccentGreenBrush}"/>
                            <Setter Property="Foreground"                   Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"   Value="{DynamicResource ButtonPressedBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"  Value="{DynamicResource AccentGreenBrush}"/>
                            <Setter Property="Foreground"                   Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBox & ListBoxItem -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource SmallCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHighlightBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton -->
    <Style TargetType="ToggleButton">
        <Setter Property="Background"      Value="{DynamicResource ButtonBgBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource ControlTextBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,5"/>
        <Setter Property="Height"          Value="30"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource ButtonHoverBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                            <Setter Property="Foreground"                  Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource ButtonHoverBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                            <Setter Property="Foreground"                  Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource ButtonPressedBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                            <Setter Property="Foreground"                  Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground"        Value="{DynamicResource ControlTextBrush}"/>
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="BorderBrush"       Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="Padding"           Value="8,4"/>
        <Setter Property="Cursor"            Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <Border x:Name="DotOuter"
                                Width="16" Height="16"
                                CornerRadius="8"
                                Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="DotInner"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource AccentGreenBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="DotInner" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="DotOuter" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DotOuter" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox (fully retemplated glass dark) -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"               Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="Foreground"               Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="Height"                   Value="28"/>
        <Setter Property="Padding"                  Value="7,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground"              Value="{DynamicResource PrimaryTextBrush}"/>
                    <Setter Property="Background"              Value="{DynamicResource MenuBgBrush}"/>
                    <Setter Property="Padding"                 Value="9,6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="0"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHighlightBrush}"/>
                                        <Setter Property="Foreground"                 Value="#FFFFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuSelectedBrush}"/>
                                        <Setter Property="Foreground"                 Value="#FFFFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#FF606070"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd"
                                                        Background="{DynamicResource InputBgBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="22"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="1"
                                                              Width="10" Height="6"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Fill="{DynamicResource SubtleTextBrush}"
                                                              Data="M 0 0 L 10 0 L 5 6 Z"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#604CAF50"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource ButtonBgBrush}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#44FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          Margin="8,0,26,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource MenuBgBrush}"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="300"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="4" BlurRadius="16"
                                                      Color="#FF000000" Opacity="0.7"/>
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         KEYED STYLES
    ═══════════════════════════════════════════════════════════════ -->

    <!-- GlassCard: main card surface with subtle glow border -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding"         Value="14,10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="2" BlurRadius="14"
                                  Color="#FF000000" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryWindowFrame" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource SecondaryWindowBackgroundBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource WindowEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource SecondaryWindowCornerRadius}"/>
        <Setter Property="Effect"          Value="{StaticResource SecondaryWindowShadow}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="SecondaryWindowHeaderCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    </Style>

    <!-- SectionTitle: uppercase glassmorphic card title -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground"   Value="{DynamicResource AccentTitleBrush}"/>
        <Setter Property="FontSize"     Value="10"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Margin"       Value="0,0,0,8"/>
    </Style>

    <Style x:Key="GroupHeader" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin"      Value="0,0,0,8"/>
    </Style>

    <Style x:Key="HeaderAccentBar" TargetType="Rectangle">
        <Setter Property="Width"        Value="3"/>
        <Setter Property="Height"       Value="11"/>
        <Setter Property="Fill"         Value="{DynamicResource AccentGreenBrush}"/>
        <Setter Property="RadiusX"      Value="1"/>
        <Setter Property="RadiusY"      Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"       Value="0,0,7,0"/>
    </Style>

    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{DynamicResource AccentTitleBrush}"/>
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsLabel" TargetType="TextBlock">
        <Setter Property="Foreground"        Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize"          Value="11"/>
    </Style>

    <!-- ConfigLabel: label beside a control inside the config panel -->
    <Style x:Key="ConfigLabel" TargetType="TextBlock">
        <Setter Property="Foreground"        Value="{DynamicResource SubtleTextBrush}"/>
        <Setter Property="FontSize"          Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="0,0,6,0"/>
    </Style>

    <!-- ValueBadge: small readout box next to sliders -->
    <Style x:Key="ValueBadge" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource BadgeBgBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource BadgeCornerRadius}"/>
        <Setter Property="Padding"         Value="5,1"/>
        <Setter Property="Margin"          Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- InfoLineLabel: compact info text in the status bar -->
    <Style x:Key="InfoLineLabel" TargetType="TextBlock">
        <Setter Property="Foreground"    Value="{DynamicResource SubtleTextBrush}"/>
        <Setter Property="FontSize"      Value="10.5"/>
        <Setter Property="Margin"        Value="0,4,0,0"/>
        <Setter Property="TextTrimming"  Value="CharacterEllipsis"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         CUSTOM WINDOW CHROME BUTTONS
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Shared base for all chrome caption buttons -->
    <Style x:Key="ChromeCaptionBtn" TargetType="Button">
        <Setter Property="Width"           Value="46"/>
        <Setter Property="Height"          Value="30"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="{DynamicResource ChromeButtonFgBrush}"/>
        <Setter Property="FontSize"        Value="10"/>
        <Setter Property="Cursor"          Value="Arrow"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/> 
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource SmallCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimize button -->
    <Style x:Key="ChromeMinBtn" TargetType="Button" BasedOn="{StaticResource ChromeCaptionBtn}"/>

    <!-- Maximize / Restore button -->
    <Style x:Key="ChromeMaxBtn" TargetType="Button" BasedOn="{StaticResource ChromeCaptionBtn}"/>    

    <!-- Close button — red hover -->
    <Style x:Key="ChromeCloseBtn" TargetType="Button" BasedOn="{StaticResource ChromeCaptionBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource SmallCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE81123"/>
                            <Setter Property="Foreground"                 Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF1707A"/>
                            <Setter Property="Foreground"                 Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hardware Rack Module Card -->
    <Style x:Key="RackModuleCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="2" BlurRadius="10" Color="#000000" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
