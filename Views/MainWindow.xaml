<Window x:Class="PaDDY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PaDDY.Controls">

    

    <Window.Resources>

        <!-- Monitor toggle: green (idle) → red+pulse (active) -->
        <Style x:Key="MonitorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Width"           Value="185"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Content">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="▶ Start Monitoring"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.1"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Content">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="▶ Start Monitoring"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.80" Duration="0:0:0.1"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Content">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="▶ Start Monitoring"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Content">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="■  Stop Monitoring"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFD32F2F" Offset="0"/>
                                                            <GradientStop Color="#FFC62828" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFEF5350" Offset="0"/>
                                                            <GradientStop Color="#FFD32F2F" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.1"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Content">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="■  Stop Monitoring"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFD32F2F" Offset="0"/>
                                                            <GradientStop Color="#FFC62828" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.80" Duration="0:0:0.1"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Content">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="■  Stop Monitoring"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFD32F2F" Offset="0"/>
                                                            <GradientStop Color="#FFC62828" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Bd"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF388E3C" Offset="0"/>
                                        <GradientStop Color="#FF2E7D32" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF66BB6A" Offset="0"/>
                                        <GradientStop Color="#FF388E3C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" Content="▶ Start Monitoring"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top-bar action button -->
        <Style x:Key="TopBarBtn" TargetType="Button" >
            <Setter Property="Padding"    Value="14,6"/>
            <Setter Property="Height"     Value="34"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#FFC0C0D8"/>
        </Style>

        <!-- Icon-only top bar button -->
        <Style x:Key="TopBarIconBtn" TargetType="Button" BasedOn="{StaticResource TopBarBtn}">
            <Setter Property="Width"   Value="36"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="LogoAboutBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LogoShell" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#0CFFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LogoShell" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1EFFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LogoShell" Storyboard.TargetProperty="Opacity" To="0.82" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="LogoShell"
                                    Padding="8,6"
                                    CornerRadius="10"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <TextBlock Text="Pa" FontSize="20" FontWeight="Bold" Foreground="#FF7070A8" VerticalAlignment="Center"/>
                                        <TextBlock Text="DDY" FontSize="20" FontWeight="Bold" Foreground="#FF4CAF50" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact info line style for runtime details -->
        <Style x:Key="InfoLineLabel" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#FF606088"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="Margin"       Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="MainRootGrid">
        
        <Grid.RowDefinitions>
            <RowDefinition/>   <!-- Row 0: Compact top bar -->
            <RowDefinition/> <!-- Row 1: Collapsible config panel -->
            <RowDefinition/> <!-- Row 2: Status + RMS meters -->
            <RowDefinition/>    <!-- Row 3: Pad panel -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ Row 0: Compact Top Bar ═══════════════════════ -->
        <Border Grid.Row="0"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource TitleBarGradient}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Button Grid.Column="0"
                    Style="{StaticResource LogoAboutBtn}"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0"
                    ToolTipService.ToolTip="Open About PaDDY"
                    Click="AboutButton_Click"/>

                <!-- Monitor toggle -->
                <ToggleButton x:Name="MonitorToggle"
                              Grid.Column="1"
                              Style="{StaticResource MonitorToggleStyle}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              
                              Checked="MonitorToggle_Checked"
                              Unchecked="MonitorToggle_Unchecked"/>
                                          

                <!-- Action buttons + custom caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConfigToggleBtn"
                            Style="{StaticResource TopBarBtn}"
                            Margin="0,0,6,0"
                            ToolTipService.ToolTip="Show / hide configuration panel"
                            
                            Click="ToggleConfigPanel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ConfigToggleText" Text="▲" FontSize="10"
                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Audio Panel" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopBarBtn}"
                            Content="Settings"
                            Margin="0,0,6,0"
                            FontSize="14"
                            
                            Click="SettingsButton_Click"/>
                    <!-- Custom caption / window control buttons -->
                    <Rectangle Fill="#18FFFFFF" Margin="10,8,0,8" VerticalAlignment="Stretch"/>
                    <Button Style="{StaticResource ChromeMinBtn}"
                            ToolTipService.ToolTip="Minimize"
                            Click="ChromeMinimize_Click">
                            
                        <TextBlock Text="&#x2014;" FontSize="14" FontFamily="Segoe UI"/>
                    </Button>
                    <Button x:Name="ChromeMaxRestoreBtn"
                            Style="{StaticResource ChromeMaxBtn}"
                            ToolTipService.ToolTip="Maximize"
                            Click="ChromeMaximize_Click">
                            
                        <TextBlock x:Name="ChromeMaxIcon" Text="&#x2610;" FontSize="14" FontFamily="Segoe UI"/>
                    </Button>
                    <Button Style="{StaticResource ChromeCloseBtn}"
                            ToolTipService.ToolTip="Close"
                            Click="ChromeClose_Click">
                            
                        <TextBlock Text="&#x2715;" FontSize="14" FontFamily="Segoe UI"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════════════ Row 1: Collapsible Config Panel ═════════════════════ -->
        <Border x:Name="ConfigPanelBorder"
                Grid.Row="1"
                Background="{ThemeResource CardBgBrush}"
                BorderBrush="#14FFFFFF"
                BorderThickness="0,0,0,1"
                MaxHeight="290"
                ClipToBounds="True">
            <Grid Margin="10,8,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- ─── INPUT ─── -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="INPUT" Style="{StaticResource SectionTitle}"/>

                        <!-- Source -->
                        <Grid Margin="0,0,0,5">
                            <TextBlock  Text="Source"
                                       Style="{StaticResource ConfigLabel}"/>
                            <ComboBox x:Name="CaptureSourceCombo"
                                      SelectionChanged="CaptureSourceCombo_SelectionChanged"/>
                        </Grid>

                        <!-- Mic/Line device -->
                        <Grid>
                            <TextBlock x:Name="InputDeviceLabel" 
                                       Text="Mic/Line" Style="{StaticResource ConfigLabel}" Margin="0,0,6,5" Visibility="Collapsed"/>
                            <ComboBox x:Name="InputDeviceCombo"
                                      Margin="0,0,0,5"
                                      Visibility="Collapsed"
                                      SelectionChanged="InputDeviceCombo_SelectionChanged"/>
                        </Grid>

                        <!-- Loopback device -->
                        <Grid>
                            <TextBlock x:Name="LoopbackDeviceLabel" 
                                       Text="Loopback" Style="{StaticResource ConfigLabel}" Margin="0,0,6,5" Visibility="Collapsed"/>
                            <ComboBox x:Name="LoopbackDeviceCombo"
                                      Margin="0,0,0,5"
                                      Visibility="Collapsed"
                                      SelectionChanged="LoopbackDeviceCombo_SelectionChanged"/>
                        </Grid>

                        <!-- App loopback -->
                        <Grid>
                            <TextBlock x:Name="AppLoopbackLabel" 
                                       Text="App" Style="{StaticResource ConfigLabel}" Margin="0,0,6,5" Visibility="Collapsed"/>
                            <Button x:Name="RefreshAppLoopbackBtn" 
                                    Content="&#x21BA;" FontSize="14" Padding="0"
                                    Margin="4,0,0,5"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="Refresh list of apps producing audio"
                                    Click="RefreshAppLoopback_Click"/>
                            <ComboBox x:Name="AppLoopbackCombo"
                                      Margin="0,0,0,5"
                                      Visibility="Collapsed"
                                      SelectionChanged="AppLoopbackCombo_SelectionChanged"/>
                        </Grid>

                        <!-- Input Volume -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="InputVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="80"
                                    TickFrequency="5"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="InputVolumeSlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="InputVolumeValueLabel"
                                           Text="80" FontSize="10" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── PAD MONITOR ─── -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="PAD MONITORING" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="ListenOutputEnabledCheck"
                                  Content="Enable monitor"
                                  Margin="0,0,0,10"
                                  Checked="ListenOutputEnabledCheck_Changed"
                                  Unchecked="ListenOutputEnabledCheck_Changed"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock  Text="Device"
                                       Style="{StaticResource ConfigLabel}"/>
                            <ComboBox x:Name="ListenOutputDeviceCombo"
                                      ToolTipService.ToolTip="Playback device used when clicking a recording pad"
                                      SelectionChanged="ListenOutputDeviceCombo_SelectionChanged"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="PadListenVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="100"
                                    TickFrequency="5"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="PadListenVolumeSlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="PadListenVolumeValueLabel"
                                           Text="100" FontSize="10" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ─── DETECTION ─── -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="DETECTION" Style="{StaticResource SectionTitle}"/>

                        <!-- Mode -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock  Text="Mode"
                                       Style="{StaticResource ConfigLabel}"/>
                            <ComboBox x:Name="RecordingModeCombo"
                                      SelectionChanged="RecordingModeCombo_SelectionChanged"
                                      ToolTipService.ToolTip="AutoVAD: auto-detect speech. Key Buffer: save last N seconds on hotkey press."/>
                        </Grid>

                        <!-- Sensitivity -->
                        <Grid x:Name="SensitivityRow" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sensitivity"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="SensitivitySlider"
                                    Grid.Column="1"
                                    Minimum="1" Maximum="99" Value="30"
                                    TickFrequency="5"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="SensitivitySlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="SensitivityValueLabel"
                                           Text="30" FontSize="10" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Silence -->
                        <Grid x:Name="SilenceRow" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Silence"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="SilenceSlider"
                                    Grid.Column="1"
                                    Minimum="300" Maximum="2000" Value="700"
                                    TickFrequency="100"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="SilenceSlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="SilenceValueLabel"
                                           Text="0.70s" FontSize="10" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Hotkey hint (Key Buffer mode) -->
                        <StackPanel x:Name="KeyBufferHint"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <TextBlock Text="Hotkey" Style="{StaticResource ConfigLabel}"/>
                            <Border Style="{StaticResource ValueBadge}" Margin="2,0,0,0">
                                <TextBlock x:Name="HotkeyLabel"
                                           Text="Ctrl+F9"
                                           Foreground="#FFFFC107"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ─── OUTPUT ─── -->
                <Border Grid.Column="3" Style="{StaticResource GlassCard}" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="OUTPUT" Style="{StaticResource SectionTitle}"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock  Text="Device"
                                       Style="{StaticResource ConfigLabel}"/>
                            <ComboBox x:Name="OutputDeviceCombo"
                                      ToolTipService.ToolTip="Primary output device for pad playback"
                                      SelectionChanged="OutputDeviceCombo_SelectionChanged"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="OutputVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="100"
                                    TickFrequency="5"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="OutputVolumeSlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="OutputVolumeValueLabel"
                                           Text="100" FontSize="10" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="OverlayConfigPanel" Visibility="Collapsed">
                            <Rectangle Fill="#1AFFFFFF" Margin="0,9,0,8"/>

                            <TextBlock Text="OVERLAY" Style="{StaticResource ConfigLabel}" Margin="0,0,0,4"/>

                            <CheckBox x:Name="OverlayEnabledCheck"
                                      Content="Enable in-game overlay"
                                      Margin="0,0,0,8"
                                      Checked="OverlayEnabledCheck_Changed"
                                      Unchecked="OverlayEnabledCheck_Changed"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Opacity"
                                           Style="{StaticResource ConfigLabel}"/>
                                <Slider x:Name="OverlayOpacitySlider"
                                        Grid.Column="1"
                                        Minimum="20" Maximum="100" Value="90"
                                        TickFrequency="5"
                                        HorizontalAlignment="Stretch"
                                        ValueChanged="OverlayOpacitySlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                    <TextBlock x:Name="OverlayOpacityValueLabel"
                                               Text="90%" FontSize="10" TextAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FPS"
                                           Style="{StaticResource ConfigLabel}"/>
                                <Slider x:Name="OverlayFpsSlider"
                                        Grid.Column="1"
                                        Minimum="30" Maximum="240" Value="60"
                                        TickFrequency="10"
                                        HorizontalAlignment="Stretch"
                                        ValueChanged="OverlayFpsSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                    <TextBlock x:Name="OverlayFpsValueLabel"
                                               Text="60" FontSize="10" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═════════════════════ Row 2: Status + IN/OUT RMS meters ═════════════════════ -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBgBrush}"
                BorderBrush="#15FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>   <!-- IN/OUT labels -->
                    <ColumnDefinition/>      <!-- Meter bars -->
                    <ColumnDefinition/>   <!-- dB + peak -->
                    <ColumnDefinition/>   <!-- Status -->
                </Grid.ColumnDefinitions>

                <!-- IN / OUT labels -->
                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <TextBlock Text="IN"
                               Foreground="#B431FF9F"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Padding="0,5,0,0"/>
                    <TextBlock Text="OUT"
                               Foreground="#FF42A5F5"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Margin="0,5,0,0"
                               Padding="0,5,0,0"/>
                    <TextBlock Text="MON"
                               Foreground="#81F54242"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Margin="0,5,0,0"
                               Padding="0,5,0,0"/>
                </StackPanel>

                <!-- Meter bars column -->
                <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            VerticalAlignment="Center">
                    <!-- Input L channel -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="L" Grid.Column="0"
                                   Foreground="#FF7070A0" FontSize="9"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Grid Grid.Column="1" ClipToBounds="True">
                            <Rectangle Fill="{ThemeResource MeterInBrush}"/>
                            <Rectangle x:Name="MeterOverlayL"
                                       Fill="#FF0D0D18"
                                       HorizontalAlignment="Right"/>
                            <Canvas x:Name="ThresholdCanvas">
                                <Rectangle x:Name="ThresholdLine"
                                           Fill="#FFFF9800"
                                           Canvas.Top="0"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                    <!-- Input R channel -->
                    <Grid x:Name="RmsMeterRRow" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Grid.Column="0"
                                   Foreground="#FF7070A0" FontSize="9"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Grid Grid.Column="1" ClipToBounds="True">
                            <Rectangle Fill="{ThemeResource MeterInBrush}"/>
                            <Rectangle x:Name="MeterOverlayR"
                                       Fill="#FF0D0D18"
                                       HorizontalAlignment="Right"/>
                            <Canvas x:Name="ThresholdCanvasR">
                                <Rectangle x:Name="ThresholdLineR"
                                           Fill="#FFFF9800"
                                           Canvas.Top="0"/>
                            </Canvas>
                        </Grid>
                    </Grid>

                    <!-- Separator -->
                    <Rectangle Fill="#1AFFFFFF" Margin="14,4,0,4"/>

                    <!-- Output L channel -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="L" Grid.Column="0"
                                   Foreground="#FF505070" FontSize="9"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Grid Grid.Column="1" ClipToBounds="True">
                            <Rectangle Fill="{ThemeResource MeterOutBrush}"/>
                            <Rectangle x:Name="OutputMeterOverlayL"
                                       Fill="#FF0D0D18"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                    <!-- Output R channel -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Grid.Column="0"
                                   Foreground="#FF505070" FontSize="9"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Grid Grid.Column="1" ClipToBounds="True">
                            <Rectangle Fill="{ThemeResource MeterOutBrush}"/>
                            <Rectangle x:Name="OutputMeterOverlayR"
                                       Fill="#FF0D0D18"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="PadMonitorMeterPanel" Margin="0,0,0,0" Opacity="0.35">
                        <!-- Separator -->
                        <Rectangle Fill="#1AFFFFFF" Margin="14,4,0,4"/>

                        <!-- Monitor L channel -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="L" Grid.Column="0"
                                       Foreground="#FF505070" FontSize="9"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Grid x:Name="PadMonitorMeterHostL" Grid.Column="1" ClipToBounds="True">
                                <Rectangle Fill="{ThemeResource MeterMonBrush}"/>
                                <Rectangle x:Name="PadMonitorMeterOverlayL"
                                           Fill="#FF0D0D18"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <!-- Monitor R channel -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R" Grid.Column="0"
                                       Foreground="#FF505070" FontSize="9"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Grid x:Name="PadMonitorMeterHostR" Grid.Column="1" ClipToBounds="True">
                                <Rectangle Fill="{ThemeResource MeterMonBrush}"/>
                                <Rectangle x:Name="PadMonitorMeterOverlayR"
                                           Fill="#FF0D0D18"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- dB values + peak indicators -->
                <StackPanel Grid.Column="2"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <!-- Input dB -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RmsValueLabel"
                                   Text="-∞"
                                   FontSize="10"
                                   Foreground="#FF7070A0"/>
                        <Border x:Name="PeakIndicatorL"
                                CornerRadius="4"
                                Background="#FF252535"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Peak clip indicator"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="RmsValueLabelR"
                                   Text="-∞"
                                   FontSize="10"
                                   Foreground="#FF7070A0"/>
                        <Border x:Name="PeakIndicatorR"
                                CornerRadius="4"
                                Background="#FF252535"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Peak clip indicator"/>
                    </StackPanel>
                    <!-- Separator spacing -->
                    <Rectangle Fill="Transparent"/>
                    <!-- Output dB -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="OutputRmsValueLabel"
                                   Text="-∞"
                                   FontSize="10"
                                   Foreground="#FF404060"/>
                        <Border x:Name="OutputPeakIndicatorL"
                                CornerRadius="4"
                                Background="#FF252535"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Output peak clip indicator"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="OutputRmsValueLabelR"
                                   Text="-∞"
                                   FontSize="10"
                                   Foreground="#FF404060"/>
                        <Border x:Name="OutputPeakIndicatorR"
                                CornerRadius="4"
                                Background="#FF252535"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Output peak clip indicator"/>
                    </StackPanel>

                    <!-- Separator spacing -->
                    <Rectangle Fill="Transparent"/>

                    <!-- Monitor dB -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MonitorRmsValueLabel"
                                   Text="-∞"
                                   FontSize="10"
                                   Foreground="#FF805080"/>
                        <Border x:Name="MonitorPeakIndicatorL"
                                CornerRadius="4"
                                Background="#FF252535"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Monitor peak clip indicator"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="MonitorRmsValueLabelR"
                                   Text="-∞"
                                   FontSize="10"
                                   Foreground="#FF805080"/>
                        <Border x:Name="MonitorPeakIndicatorR"
                                CornerRadius="4"
                                Background="#FF252535"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Monitor peak clip indicator"/>
                    </StackPanel>

                </StackPanel>

                <!-- Runtime status panel -->
                <Border Grid.Column="3"
                        Margin="18,0,0,0"
                        Padding="12,8"
                        Background="#18FFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="7"
                        MaxWidth="420">
                    
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Fill="#FF404055"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusLabel"
                                       Text="Idle — press Start to begin"
                                       FontSize="11"
                                       Foreground="#FF9090B8"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360"/>
                        </StackPanel>

                        <TextBlock x:Name="InputFormatInfoLabel"
                                   Text="Input format: waiting for monitoring"
                                   Style="{StaticResource InfoLineLabel}"
                                   MaxWidth="380"/>
                        <TextBlock x:Name="OutputFormatInfoLabel"
                                   Text="Recording format: WAV | 48.0 kHz | 16-bit | stereo"
                                   Style="{StaticResource InfoLineLabel}"
                                   MaxWidth="380"/>
                        <TextBlock x:Name="WhisperStatusLabel"
                                   Text="AR-STT : unavailable"
                                   Style="{StaticResource InfoLineLabel}"
                                   MaxWidth="380"/>           
                        <TextBlock x:Name="StorageInfoLabel"
                                   Text="Output folder: calculating usage…"
                                   Style="{StaticResource InfoLineLabel}"
                                   MaxWidth="380"/>
                        <TextBlock x:Name="StreamDeckStatusLabel"
                                   Text="Stream Deck plugin: not connected"
                                   Style="{StaticResource InfoLineLabel}"
                                   Visibility="Collapsed"
                                   MaxWidth="380"/>
                        

                        <TextBlock x:Name="UpdateNoticeText"
                                   Visibility="Collapsed"
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   FontStyle="Normal"
                                   Foreground="#FFF0C04A">
                            <Hyperlink x:Name="UpdateNoticeLink"
                                       Foreground="#FFF0C04A"
                                       RequestNavigate="UpdateNoticeLink_RequestNavigate">
                                New PaDDY release available - open downloads
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═════════════════════ Row 3: Favorites + Recordings pad panel ═════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition/> <!-- Favorites header -->
                <RowDefinition/> <!-- Favorites panel -->
                <RowDefinition/> <!-- Recordings header -->
                <RowDefinition/>    <!-- Recordings scrollable area -->
            </Grid.RowDefinitions>

            <!-- ── Favorites header (hidden when empty) ── -->
            <Border x:Name="FavoritesHeader"
                    Grid.Row="0"
                    Background="#12FFC107"
                    BorderBrush="#28FFC107"
                    BorderThickness="0,0,0,1"
                    Padding="14,6"
                    Visibility="Collapsed">
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="★"
                                       Foreground="#FFFFC107"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <StackPanel x:Name="PadPageTabBar"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                            <Button x:Name="AddPadPageButton"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="#33FFC107"
                                    BorderThickness="1"
                                    Foreground="#FFFFC107"
                                    Content="+"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    ToolTipService.ToolTip="Add a new pad page"
                                    Click="AddPadPageButton_Click"/>
                            <TextBlock x:Name="FavoriteCountLabel"
                                       Text=" — 0"
                                       Foreground="#FF8A8A60"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RenamePadPageButton"
                                Margin="4,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Foreground="#FFFFC107"
                                Content="✎"
                                FontSize="11"
                                ToolTipService.ToolTip="Rename current page"
                                Click="RenamePadPageButton_Click"/>
                        <Button x:Name="DeletePadPageButton"
                                Margin="2,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Foreground="#FFE57373"
                                Content="🗑"
                                FontSize="11"
                                ToolTipService.ToolTip="Delete current page (pads move to Favorites)"
                                Click="DeletePadPageButton_Click"/>
                        <Button x:Name="FavoritesCollapseButton"
                                Margin="4,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Collapse favorites"
                                Click="FavoritesCollapseButton_Click">
                            <TextBlock x:Name="FavoritesCollapseIcon"
                                       Text="▼"
                                       Foreground="#FFFFC107"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Favorites WrapPanel ── -->
            <Border x:Name="FavoritesPanelBorder"
                    Grid.Row="1"
                    Background="#0AFFC107"
                    Visibility="Collapsed"
                    Padding="12,6,12,6">
                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="318">
                    <VariableSizedWrapGrid Orientation="Horizontal" x:Name="FavoritesPanel" Orientation="Horizontal"
                               Background="Transparent"
                               AllowDrop="True"
                               DragOver="FavoritesPanel_DragOver"
                               Drop="FavoritesPanel_Drop"/>
                </ScrollViewer>
            </Border>

            <!-- ── Recordings header ── -->
            <Border Grid.Row="2"
                    Background="{ThemeResource InputBgBrush}"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="0,0,0,1"
                    Padding="14,7">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Fill="#FF4CAF50"
                                   VerticalAlignment="Center" RadiusX="1" RadiusY="1"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="RECORDINGS"
                                   Foreground="{ThemeResource AccentTitleBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="RecordingCountLabel"
                                   Text="0 clips"
                                   Foreground="#FF505070"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>
                        <ComboBox x:Name="SortOrderCombo"
                                  Margin="0,0,8,0"
                                  ToolTipService.ToolTip="Sort order for recordings"
                                  SelectionChanged="SortOrderCombo_SelectionChanged"/>
                        <Button Content="Clear Pads"
                                Padding="10,2"
                                Margin="0,0,6,0"
                                ToolTipService.ToolTip="Permanently delete all non-favorite recordings (favorites are kept)"
                                Click="ClearPadsButton_Click"/>
                        <Button Content="&#x1F5D1; Delete All Files"
                                Padding="10,2"
                                ToolTipService.ToolTip="Permanently delete recordings from disk"
                                Click="DeleteAllFilesButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Scrollable recordings area ── -->
            <ScrollViewer Grid.Row="3"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Background="{ThemeResource WindowBgBrush}"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch">
                <StackPanel VerticalAlignment="Top">
                    <VariableSizedWrapGrid Orientation="Horizontal" x:Name="PadPanel"
                               Margin="12"
                               Background="Transparent"
                               AllowDrop="True"
                               DragOver="PadPanel_DragOver"
                               Drop="PadPanel_Drop"
                               Orientation="Horizontal"/>
                    <TextBlock x:Name="EmptyHint"
                               Text="No recordings yet&#x0a;Start monitoring to capture sounds!"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FF303048"
                               FontSize="14"
                               TextAlignment="Center"
                               Margin="0,70,0,0"/>
                </StackPanel>
            </ScrollViewer>
        <!-- Loading overlay covering the entire window -->
        <controls:LoadingOverlay x:Name="MainLoadingOverlay" Background="#CC0A0A12" Grid.RowSpan="4" Panel.ZIndex="100"/>
        </Grid>
    </Grid>
</Window>
