<Window x:Class="PaDDY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PaDDY.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PaDDY"
        Icon="/PaDDY.ico"
        Height="740"
        Width="1380"
        MinWidth="1100"
        MinHeight="600"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60"
                      GlassFrameThickness="1"
                      ResizeBorderThickness="4"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Monitor toggle: green (idle) → red+pulse (active) -->
        <Style x:Key="MonitorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="22,0"/>
            <Setter Property="Width"           Value="185"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Content"         Value="▶ Start Monitoring"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF388E3C" Offset="0"/>
                                    <GradientStop Color="#FF2E7D32" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF66BB6A" Offset="0"/>
                                    <GradientStop Color="#FF388E3C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="0"
                                                  Color="#FF55DD55" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFD32F2F" Offset="0"/>
                                            <GradientStop Color="#FFC62828" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFEF5350" Offset="0"/>
                                            <GradientStop Color="#FFD32F2F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Content" Value="■  Stop Monitoring"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="GlowPulse">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Bd"
                                                Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                From="6" To="24" Duration="0:0:1.2"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Bd"
                                                Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                From="0.3" To="0.85" Duration="0:0:1.2"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="GlowPulse"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top-bar action button -->
        <Style x:Key="TopBarBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding"    Value="14,6"/>
            <Setter Property="Height"     Value="34"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#FFC0C0D8"/>
        </Style>

        <!-- Icon-only top bar button -->
        <Style x:Key="TopBarIconBtn" TargetType="Button" BasedOn="{StaticResource TopBarBtn}">
            <Setter Property="Width"   Value="36"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="LogoAboutBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LogoShell"
                                Padding="8,6"
                                CornerRadius="10"
                                Background="#00000000"
                                BorderBrush="#00FFFFFF"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect x:Name="LogoGlow"
                                                  ShadowDepth="0"
                                                  BlurRadius="0"
                                                  Color="#FF4CAF50"
                                                  Opacity="0"/>
                            </Border.Effect>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <TextBlock Text="Pa"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#FF7070A8"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="DDY"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#FF4CAF50"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LogoShell" Property="Background" Value="#0CFFFFFF"/>
                                <Setter TargetName="LogoShell" Property="BorderBrush" Value="#1EFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="LogoHoverStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="12"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.38"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="LogoHoverStoryboard"/>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LogoShell" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact info line style for runtime details -->
        <Style x:Key="InfoLineLabel" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#FF606088"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="Margin"       Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="MainRootGrid">
        <Grid.Effect>
            <DropShadowEffect ShadowDepth="0"
                              BlurRadius="18"
                              Color="#FF000000"
                              Opacity="0.36"/>
        </Grid.Effect>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>   <!-- Row 0: Compact top bar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Collapsible config panel -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Status + RMS meters -->
            <RowDefinition Height="*"/>    <!-- Row 3: Pad panel -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ Row 0: Compact Top Bar ═══════════════════════ -->
        <Border Grid.Row="0"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource TitleBarGradient}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Button Grid.Column="0"
                    Style="{StaticResource LogoAboutBtn}"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0"
                    ToolTip="Open About PaDDY"
                    Click="AboutButton_Click"/>

                <!-- Monitor toggle -->
                <ToggleButton x:Name="MonitorToggle"
                              Grid.Column="1"
                              Style="{StaticResource MonitorToggleStyle}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              Checked="MonitorToggle_Checked"
                              Unchecked="MonitorToggle_Unchecked"/>
                                          

                <!-- Action buttons + custom caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConfigToggleBtn"
                            Style="{StaticResource TopBarBtn}"
                            Margin="0,0,6,0"
                            ToolTip="Show / hide configuration panel"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="ToggleConfigPanel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ConfigToggleText" Text="▲" FontSize="10"
                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Audio Panel" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopBarBtn}"
                            Content="Settings"
                            Margin="0,0,6,0"
                            FontSize="14"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="SettingsButton_Click"/>
                    <!-- Custom caption / window control buttons -->
                    <Rectangle Width="1" Fill="#18FFFFFF" Margin="10,8,0,8" VerticalAlignment="Stretch"/>
                    <Button Style="{StaticResource ChromeMinBtn}"
                            ToolTip="Minimize"
                            Click="ChromeMinimize_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="#FFFFFFFF" BlurRadius="5" ShadowDepth="0"/>
                            </Button.Effect>
                        <TextBlock Text="&#x2014;" FontSize="14" FontFamily="Segoe UI"/>
                    </Button>
                    <Button x:Name="ChromeMaxRestoreBtn"
                            Style="{StaticResource ChromeMaxBtn}"
                            ToolTip="Maximize"
                            Click="ChromeMaximize_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="#FFFFFFFF" BlurRadius="5" ShadowDepth="0"/>
                            </Button.Effect>
                        <TextBlock x:Name="ChromeMaxIcon" Text="&#x2610;" FontSize="14" FontFamily="Segoe UI"/>
                    </Button>
                    <Button Style="{StaticResource ChromeCloseBtn}"
                            ToolTip="Close"
                            Click="ChromeClose_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="#FFFF5555" BlurRadius="8" ShadowDepth="0"/>
                            </Button.Effect>
                        <TextBlock Text="&#x2715;" FontSize="14" FontFamily="Segoe UI"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════════════ Row 1: Collapsible Config Panel ═════════════════════ -->
        <Border x:Name="ConfigPanelBorder"
                Grid.Row="1"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="#14FFFFFF"
                BorderThickness="0,0,0,1"
                MaxHeight="290"
                ClipToBounds="True">
            <Grid Margin="10,8,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─── INPUT ─── -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="INPUT" Style="{StaticResource SectionTitle}"/>

                        <!-- Source -->
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Left" Text="Source"
                                       Style="{StaticResource ConfigLabel}" Width="58"/>
                            <ComboBox x:Name="CaptureSourceCombo"
                                      SelectionChanged="CaptureSourceCombo_SelectionChanged"/>
                        </DockPanel>

                        <!-- Mic/Line device -->
                        <DockPanel>
                            <TextBlock x:Name="InputDeviceLabel" DockPanel.Dock="Left"
                                       Text="Mic/Line" Style="{StaticResource ConfigLabel}"
                                       Width="58" Margin="0,0,6,5" Visibility="Collapsed"/>
                            <ComboBox x:Name="InputDeviceCombo"
                                      Margin="0,0,0,5"
                                      Visibility="Collapsed"
                                      SelectionChanged="InputDeviceCombo_SelectionChanged"/>
                        </DockPanel>

                        <!-- Loopback device -->
                        <DockPanel>
                            <TextBlock x:Name="LoopbackDeviceLabel" DockPanel.Dock="Left"
                                       Text="Loopback" Style="{StaticResource ConfigLabel}"
                                       Width="58" Margin="0,0,6,5" Visibility="Collapsed"/>
                            <ComboBox x:Name="LoopbackDeviceCombo"
                                      Margin="0,0,0,5"
                                      Visibility="Collapsed"
                                      SelectionChanged="LoopbackDeviceCombo_SelectionChanged"/>
                        </DockPanel>

                        <!-- App loopback -->
                        <DockPanel>
                            <TextBlock x:Name="AppLoopbackLabel" DockPanel.Dock="Left"
                                       Text="App" Style="{StaticResource ConfigLabel}"
                                       Width="58" Margin="0,0,6,5" Visibility="Collapsed"/>
                            <Button x:Name="RefreshAppLoopbackBtn" DockPanel.Dock="Right"
                                    Content="&#x21BA;" Width="30" FontSize="14" Padding="0"
                                    Margin="4,0,0,5"
                                    Visibility="Collapsed"
                                    ToolTip="Refresh list of apps producing audio"
                                    Click="RefreshAppLoopback_Click"/>
                            <ComboBox x:Name="AppLoopbackCombo"
                                      Margin="0,0,0,5"
                                      Visibility="Collapsed"
                                      SelectionChanged="AppLoopbackCombo_SelectionChanged"/>
                        </DockPanel>

                        <!-- Input Volume -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="InputVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="80"
                                    TickFrequency="5"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="InputVolumeSlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="InputVolumeValueLabel"
                                           Text="80" FontSize="10" Width="26" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── PAD MONITOR ─── -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="PAD MONITORING" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="ListenOutputEnabledCheck"
                                  Content="Enable monitor"
                                  Margin="0,0,0,10"
                                  Checked="ListenOutputEnabledCheck_Changed"
                                  Unchecked="ListenOutputEnabledCheck_Changed"/>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Device"
                                       Style="{StaticResource ConfigLabel}" Width="52"/>
                            <ComboBox x:Name="ListenOutputDeviceCombo"
                                      ToolTip="Playback device used when clicking a recording pad"
                                      SelectionChanged="ListenOutputDeviceCombo_SelectionChanged"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="PadListenVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="100"
                                    TickFrequency="5"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="PadListenVolumeSlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="PadListenVolumeValueLabel"
                                           Text="100" FontSize="10" Width="26" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ─── DETECTION ─── -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="DETECTION" Style="{StaticResource SectionTitle}"/>

                        <!-- Mode -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Mode"
                                       Style="{StaticResource ConfigLabel}" Width="72"/>
                            <ComboBox x:Name="RecordingModeCombo"
                                      SelectionChanged="RecordingModeCombo_SelectionChanged"
                                      ToolTip="AutoVAD: auto-detect speech. Key Buffer: save last N seconds on hotkey press."/>
                        </DockPanel>

                        <!-- Sensitivity -->
                        <Grid x:Name="SensitivityRow" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sensitivity"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="SensitivitySlider"
                                    Grid.Column="1"
                                    Minimum="1" Maximum="99" Value="30"
                                    TickFrequency="5"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="SensitivitySlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="SensitivityValueLabel"
                                           Text="30" FontSize="10" Width="26" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Silence -->
                        <Grid x:Name="SilenceRow" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Silence"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="SilenceSlider"
                                    Grid.Column="1"
                                    Minimum="300" Maximum="2000" Value="700"
                                    TickFrequency="100"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="SilenceSlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="SilenceValueLabel"
                                           Text="0.70s" FontSize="10" Width="42" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Hotkey hint (Key Buffer mode) -->
                        <StackPanel x:Name="KeyBufferHint"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <TextBlock Text="Hotkey" Style="{StaticResource ConfigLabel}"/>
                            <Border Style="{StaticResource ValueBadge}" Margin="2,0,0,0">
                                <TextBlock x:Name="HotkeyLabel"
                                           Text="Ctrl+F9"
                                           Foreground="#FFFFC107"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ─── OUTPUT ─── -->
                <Border Grid.Column="3" Style="{StaticResource GlassCard}" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="OUTPUT" Style="{StaticResource SectionTitle}"/>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Device"
                                       Style="{StaticResource ConfigLabel}" Width="52"/>
                            <ComboBox x:Name="OutputDeviceCombo"
                                      ToolTip="Primary output device for pad playback"
                                      SelectionChanged="OutputDeviceCombo_SelectionChanged"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume"
                                       Style="{StaticResource ConfigLabel}"/>
                            <Slider x:Name="OutputVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="100"
                                    TickFrequency="5"
                                    HorizontalAlignment="Stretch"
                                    ValueChanged="OutputVolumeSlider_ValueChanged"/>
                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="OutputVolumeValueLabel"
                                           Text="100" FontSize="10" Width="26" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="OverlayConfigPanel" Visibility="Collapsed">
                            <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,9,0,8"/>

                            <TextBlock Text="OVERLAY" Style="{StaticResource ConfigLabel}" Margin="0,0,0,4"/>

                            <CheckBox x:Name="OverlayEnabledCheck"
                                      Content="Enable in-game overlay"
                                      Margin="0,0,0,8"
                                      Checked="OverlayEnabledCheck_Changed"
                                      Unchecked="OverlayEnabledCheck_Changed"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Opacity"
                                           Style="{StaticResource ConfigLabel}"/>
                                <Slider x:Name="OverlayOpacitySlider"
                                        Grid.Column="1"
                                        Minimum="20" Maximum="100" Value="90"
                                        TickFrequency="5"
                                        HorizontalAlignment="Stretch"
                                        ValueChanged="OverlayOpacitySlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                    <TextBlock x:Name="OverlayOpacityValueLabel"
                                               Text="90%" FontSize="10" Width="36" TextAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FPS"
                                           Style="{StaticResource ConfigLabel}"/>
                                <Slider x:Name="OverlayFpsSlider"
                                        Grid.Column="1"
                                        Minimum="30" Maximum="240" Value="60"
                                        TickFrequency="10"
                                        HorizontalAlignment="Stretch"
                                        ValueChanged="OverlayFpsSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                    <TextBlock x:Name="OverlayFpsValueLabel"
                                               Text="60" FontSize="10" Width="30" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═════════════════════ Row 2: Status + IN/OUT RMS meters ═════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="#15FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>      <!-- Audio Meters Card -->
                    <ColumnDefinition Width="Auto"/>   <!-- Status -->
                </Grid.ColumnDefinitions>

                <!-- Audio Meters Card -->
                <Border Grid.Column="0"
                        Padding="16,12"
                        Background="{DynamicResource BadgeBgBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" Direction="270" BlurRadius="6" Color="#FF000000" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>   <!-- IN/OUT labels -->
                            <ColumnDefinition Width="*"/>      <!-- Meter bars -->
                            <ColumnDefinition Width="Auto"/>   <!-- dB + peak -->
                        </Grid.ColumnDefinitions>

                        <!-- IN / OUT labels -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Vertical"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <Label Content="IN"
                                   Foreground="#B431FF9F"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalContentAlignment="Center"
                                   Height="30"
                                   Padding="0"/>
                            <Rectangle Height="11" Fill="Transparent"/>
                            <Label Content="OUT"
                                   Foreground="#FF42A5F5"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalContentAlignment="Center"
                                   Height="30"
                                   Padding="0"/>
                            <Rectangle Height="11" Fill="Transparent"/>
                            <Label Content="MON"
                                   Foreground="#81F54242"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalContentAlignment="Center"
                                   Height="30"
                                   Padding="0"/>
                        </StackPanel>

                        <!-- Meter bars column -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Vertical"
                                    VerticalAlignment="Center">
                            <!-- Input L channel -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="L" Grid.Column="0"
                                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="9.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Height="14"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <Grid ClipToBounds="True">
                                        <Rectangle Fill="{DynamicResource MeterInBrush}"/>
                                        <Rectangle x:Name="MeterOverlayL"
                                                   Fill="{DynamicResource InputBgBrush}"
                                                   HorizontalAlignment="Right"
                                                   Width="1000"/>
                                        <Canvas x:Name="ThresholdCanvas" Height="12">
                                            <Rectangle x:Name="ThresholdLine"
                                                       Width="2" Height="12"
                                                       Fill="#FFFF9800"
                                                       Canvas.Top="0"/>
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </Grid>
                            <!-- Input R channel -->
                            <Grid x:Name="RmsMeterRRow" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="R" Grid.Column="0"
                                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="9.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Height="14"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <Grid ClipToBounds="True">
                                        <Rectangle Fill="{DynamicResource MeterInBrush}"/>
                                        <Rectangle x:Name="MeterOverlayR"
                                                   Fill="{DynamicResource InputBgBrush}"
                                                   HorizontalAlignment="Right"
                                                   Width="1000"/>
                                        <Canvas x:Name="ThresholdCanvasR" Height="12">
                                            <Rectangle x:Name="ThresholdLineR"
                                                       Width="2" Height="12"
                                                       Fill="#FFFF9800"
                                                       Canvas.Top="0"/>
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Separator -->
                            <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="14,5,0,5"/>

                            <!-- Output L channel -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="L" Grid.Column="0"
                                           Foreground="{DynamicResource SubtleTextBrush}" Opacity="0.6" FontSize="9.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Height="14"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <Grid ClipToBounds="True">
                                        <Rectangle Fill="{DynamicResource MeterOutBrush}"/>
                                        <Rectangle x:Name="OutputMeterOverlayL"
                                                   Fill="{DynamicResource InputBgBrush}"
                                                   HorizontalAlignment="Right"
                                                   Width="1000"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <!-- Output R channel -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="R" Grid.Column="0"
                                           Foreground="{DynamicResource SubtleTextBrush}" Opacity="0.6" FontSize="9.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Height="14"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <Grid ClipToBounds="True">
                                        <Rectangle Fill="{DynamicResource MeterOutBrush}"/>
                                        <Rectangle x:Name="OutputMeterOverlayR"
                                                   Fill="{DynamicResource InputBgBrush}"
                                                   HorizontalAlignment="Right"
                                                   Width="1000"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="PadMonitorMeterPanel" Margin="0,0,0,0" Opacity="0.35">
                                <!-- Separator -->
                                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="14,5,0,5"/>

                                <!-- Monitor L channel -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="L" Grid.Column="0"
                                               Foreground="{DynamicResource SubtleTextBrush}" Opacity="0.6" FontSize="9.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Border x:Name="PadMonitorMeterHostL" Grid.Column="1"
                                            Height="14"
                                            Background="{DynamicResource InputBgBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            SnapsToDevicePixels="True">
                                        <Grid ClipToBounds="True">
                                            <Rectangle Fill="{DynamicResource MeterMonBrush}"/>
                                            <Rectangle x:Name="PadMonitorMeterOverlayL"
                                                       Fill="{DynamicResource InputBgBrush}"
                                                       HorizontalAlignment="Right"
                                                       Width="1000"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <!-- Monitor R channel -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="R" Grid.Column="0"
                                               Foreground="{DynamicResource SubtleTextBrush}" Opacity="0.6" FontSize="9.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Border x:Name="PadMonitorMeterHostR" Grid.Column="1"
                                            Height="14"
                                            Background="{DynamicResource InputBgBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            SnapsToDevicePixels="True">
                                        <Grid ClipToBounds="True">
                                            <Rectangle Fill="{DynamicResource MeterMonBrush}"/>
                                            <Rectangle x:Name="PadMonitorMeterOverlayR"
                                                       Fill="{DynamicResource InputBgBrush}"
                                                       HorizontalAlignment="Right"
                                                       Width="1000"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- dB values + peak indicators -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <!-- Input dB -->
                            <StackPanel Orientation="Horizontal" Height="14" VerticalAlignment="Center">
                                <TextBlock x:Name="RmsValueLabel"
                                           Text="-∞"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Width="38"
                                           VerticalAlignment="Center"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#FF09090F" BorderThickness="1" BorderBrush="#15FFFFFF" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Border x:Name="PeakIndicatorL"
                                            Width="6" Height="6"
                                            CornerRadius="3"
                                            Background="#FF252535"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip="Peak clip indicator"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Height="14" VerticalAlignment="Center">
                                <TextBlock x:Name="RmsValueLabelR"
                                           Text="-∞"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Width="38"
                                           VerticalAlignment="Center"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#FF09090F" BorderThickness="1" BorderBrush="#15FFFFFF" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Border x:Name="PeakIndicatorR"
                                            Width="6" Height="6"
                                            CornerRadius="3"
                                            Background="#FF252535"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip="Peak clip indicator"/>
                                </Border>
                            </StackPanel>

                            <!-- Separator spacing -->
                            <Rectangle Height="11" Fill="Transparent"/>

                            <!-- Output dB -->
                            <StackPanel Orientation="Horizontal" Height="14" VerticalAlignment="Center">
                                <TextBlock x:Name="OutputRmsValueLabel"
                                           Text="-∞"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Opacity="0.6"
                                           Width="38"
                                           VerticalAlignment="Center"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#FF09090F" BorderThickness="1" BorderBrush="#15FFFFFF" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Border x:Name="OutputPeakIndicatorL"
                                            Width="6" Height="6"
                                            CornerRadius="3"
                                            Background="#FF252535"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip="Output peak clip indicator"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Height="14" VerticalAlignment="Center">
                                <TextBlock x:Name="OutputRmsValueLabelR"
                                           Text="-∞"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Opacity="0.6"
                                           Width="38"
                                           VerticalAlignment="Center"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#FF09090F" BorderThickness="1" BorderBrush="#15FFFFFF" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Border x:Name="OutputPeakIndicatorR"
                                            Width="6" Height="6"
                                            CornerRadius="3"
                                            Background="#FF252535"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip="Output peak clip indicator"/>
                                </Border>
                            </StackPanel>

                            <!-- Separator spacing -->
                            <Rectangle Height="11" Fill="Transparent"/>

                            <!-- Monitor dB -->
                            <StackPanel Orientation="Horizontal" Height="14" VerticalAlignment="Center">
                                <TextBlock x:Name="MonitorRmsValueLabel"
                                           Text="-∞"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Opacity="0.8"
                                           Width="38"
                                           VerticalAlignment="Center"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#FF09090F" BorderThickness="1" BorderBrush="#15FFFFFF" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Border x:Name="MonitorPeakIndicatorL"
                                            Width="6" Height="6"
                                            CornerRadius="3"
                                            Background="#FF252535"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip="Monitor peak clip indicator"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Height="14" VerticalAlignment="Center">
                                <TextBlock x:Name="MonitorRmsValueLabelR"
                                           Text="-∞"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Opacity="0.8"
                                           Width="38"
                                           VerticalAlignment="Center"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#FF09090F" BorderThickness="1" BorderBrush="#15FFFFFF" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Border x:Name="MonitorPeakIndicatorR"
                                            Width="6" Height="6"
                                            CornerRadius="3"
                                            Background="#FF252535"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip="Monitor peak clip indicator"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Runtime status panel -->
                <Border Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12,8"
                        Background="#18FFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="7"
                        MaxWidth="420">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10"
                                          Color="#FF000000" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="9" Height="9"
                                     Fill="#FF404055"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusLabel"
                                       Text="Idle — press Start to begin"
                                       FontSize="11"
                                       Foreground="#FF9090B8"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360"/>
                        </StackPanel>

                        <TextBlock x:Name="InputFormatInfoLabel"
                                   Text="Input format: waiting for monitoring"
                                   Style="{StaticResource InfoLineLabel}"
                                   MaxWidth="380"/>
                        <TextBlock x:Name="OutputFormatInfoLabel"
                                   Text="Recording format: WAV | 48.0 kHz | 16-bit | stereo"
                                   Style="{StaticResource InfoLineLabel}"
                                   MaxWidth="380"/>
                        <TextBlock x:Name="WhisperStatusLabel"
                                   Text="AR-STT : unavailable"
                                   Style="{StaticResource InfoLineLabel}"
                                   MaxWidth="380"/>           
                        <TextBlock x:Name="StorageInfoLabel"
                                   Text="Output folder: calculating usage…"
                                   Style="{StaticResource InfoLineLabel}"
                                   MaxWidth="380"/>
                        <TextBlock x:Name="StreamDeckStatusLabel"
                                   Text="Stream Deck plugin: not connected"
                                   Style="{StaticResource InfoLineLabel}"
                                   Visibility="Collapsed"
                                   MaxWidth="380"/>
                        

                        <TextBlock x:Name="UpdateNoticeText"
                                   Visibility="Collapsed"
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   FontStyle="Normal"
                                   Foreground="#FFF0C04A">
                            <Hyperlink x:Name="UpdateNoticeLink"
                                       Foreground="#FFF0C04A"
                                       RequestNavigate="UpdateNoticeLink_RequestNavigate">
                                New PaDDY release available - open downloads
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═════════════════════ Row 3: Favorites + Recordings pad panel ═════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Favorites header -->
                <RowDefinition Height="Auto"/> <!-- Favorites panel -->
                <RowDefinition Height="Auto"/> <!-- Recordings header -->
                <RowDefinition Height="*"/>    <!-- Recordings scrollable area -->
            </Grid.RowDefinitions>

            <!-- ── Favorites header (hidden when empty) ── -->
            <Border x:Name="FavoritesHeader"
                    Grid.Row="0"
                    Background="#12FFC107"
                    BorderBrush="#28FFC107"
                    BorderThickness="0,0,0,1"
                    Padding="14,6"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="8"
                                      Color="#FFFFC107" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="★"
                                       Foreground="#FFFFC107"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <StackPanel x:Name="PadPageTabBar"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                            <Button x:Name="AddPadPageButton"
                                    Width="20" Height="20"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="#33FFC107"
                                    BorderThickness="1"
                                    Foreground="#FFFFC107"
                                    Content="+"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    ToolTip="Add a new pad page"
                                    Click="AddPadPageButton_Click"/>
                            <TextBlock x:Name="FavoriteCountLabel"
                                       Text=" — 0"
                                       Foreground="#FF8A8A60"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RenamePadPageButton"
                                Width="22" Height="22"
                                Margin="4,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Foreground="#FFFFC107"
                                Content="✎"
                                FontSize="11"
                                ToolTip="Rename current page"
                                Click="RenamePadPageButton_Click"/>
                        <Button x:Name="DeletePadPageButton"
                                Width="22" Height="22"
                                Margin="2,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Foreground="#FFE57373"
                                Content="🗑"
                                FontSize="11"
                                ToolTip="Delete current page (pads move to Favorites)"
                                Click="DeletePadPageButton_Click"/>
                        <Button x:Name="FavoritesCollapseButton"
                                Width="22"
                                Height="22"
                                Margin="4,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                ToolTip="Collapse favorites"
                                Click="FavoritesCollapseButton_Click">
                            <TextBlock x:Name="FavoritesCollapseIcon"
                                       Text="▼"
                                       Foreground="#FFFFC107"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Favorites WrapPanel ── -->
            <Border x:Name="FavoritesPanelBorder"
                    Grid.Row="1"
                    Background="#0AFFC107"
                    Visibility="Collapsed"
                    Padding="12,6,12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="318">
                    <WrapPanel x:Name="FavoritesPanel" Orientation="Horizontal"
                               Background="Transparent"
                               AllowDrop="True"
                               DragOver="FavoritesPanel_DragOver"
                               Drop="FavoritesPanel_Drop"/>
                </ScrollViewer>
            </Border>

            <!-- ── Recordings header ── -->
            <Border Grid.Row="2"
                    Background="{DynamicResource InputBgBrush}"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="0,0,0,1"
                    Padding="14,7">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="12" Fill="#FF4CAF50"
                                   VerticalAlignment="Center" RadiusX="1" RadiusY="1"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="RECORDINGS"
                                   Foreground="{DynamicResource AccentTitleBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="RecordingCountLabel"
                                   Text="0 clips"
                                   Foreground="#FF505070"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>
                        <ComboBox x:Name="SortOrderCombo"
                                  Width="115"
                                  Height="24"
                                  Margin="0,0,8,0"
                                  ToolTip="Sort order for recordings"
                                  SelectionChanged="SortOrderCombo_SelectionChanged"/>
                        <Button Content="Clear Pads"
                                Height="24"
                                Padding="10,2"
                                Margin="0,0,6,0"
                                ToolTip="Permanently delete all non-favorite recordings (favorites are kept)"
                                Click="ClearPadsButton_Click"/>
                        <Button Content="&#x1F5D1; Delete All Files"
                                Height="24"
                                Padding="10,2"
                                ToolTip="Permanently delete recordings from disk"
                                Click="DeleteAllFilesButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Scrollable recordings area ── -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{DynamicResource WindowBgBrush}"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch">
                <StackPanel VerticalAlignment="Top">
                    <WrapPanel x:Name="PadPanel"
                               Margin="12"
                               Background="Transparent"
                               AllowDrop="True"
                               DragOver="PadPanel_DragOver"
                               Drop="PadPanel_Drop"
                               Orientation="Horizontal"/>
                    <TextBlock x:Name="EmptyHint"
                               Text="No recordings yet&#x0a;Start monitoring to capture sounds!"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FF303048"
                               FontSize="14"
                               TextAlignment="Center"
                               Margin="0,70,0,0"/>
                </StackPanel>
            </ScrollViewer>
        <!-- Loading overlay covering the entire window -->
        <controls:LoadingOverlay x:Name="MainLoadingOverlay" Background="#CC0A0A12" Grid.RowSpan="4" Panel.ZIndex="100"/>
        </Grid>
    </Grid>
</Window>
