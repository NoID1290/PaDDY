<Window x:Class="PaDDY.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PaDDY.Controls"
        xmlns:p="clr-namespace:PaDDY.Helpers"
        Title="{p:Loc SettingsTitle}"
        Icon="/PaDDY.ico"
        Width="1150"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="5"
                            ResizeBorderThickness="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="10">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{DynamicResource TopWindowCornerRadius}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="PaDDY — Settings"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTip="Close"
                                Click="ChromeClose_Click">
                            <TextBlock Text="&#xE8BB;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Settings Body -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Vertical Sidebar Navigation -->
                        <ColumnDefinition Width="220"/>
                        <!-- Column 1: Main Content Panels -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Background Pane -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            Background="#07FFFFFF"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,1,0"/>

                    <!-- TabControl (Template splits headers to Col 0, content to Col 1) -->
                    <TabControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Sidebar Tab Items List -->
                                    <Border Grid.Column="0" Padding="0,16,0,0" Background="Transparent">
                                        <StackPanel IsItemsHost="True" Background="Transparent"/>
                                    </Border>
                                    
                                    <!-- Content Viewport -->
                                    <Border Grid.Column="1" Background="Transparent">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="28,20,28,16">
                                            <ContentPresenter ContentSource="SelectedContent"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        
                        <TabControl.Resources>
                            <!-- Custom styled TabItem to behave like modern sidebar options -->
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FF8080A8"/>
                                <Setter Property="Padding" Value="20,12,20,12"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="4,0,0,0"
                                                    BorderBrush="Transparent"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="0,1,0,1">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  TextElement.FontSize="12.5"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  TextElement.FontFamily="{DynamicResource AppFont}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#12FFFFFF"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#0AFFFFFF"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#16FFFFFF"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- ══ 1. RECORDING TAB ═════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabGeneral}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc RecConfigHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc RecConfigSubtitle}" FontSize="11.5" Foreground="#FF8080A8" Margin="0,0,0,18"/>

                                <!-- Recording Format Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc RecFormatGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Codec Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc CodecLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc CodecDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CodecCombo" Grid.Column="1" Width="220" VerticalAlignment="Center" SelectionChanged="CodecCombo_SelectionChanged"/>
                                        </Grid>
                                        
                                        <!-- Info label block -->
                                        <TextBlock x:Name="CodecInfoText"
                                                   TextWrapping="Wrap"
                                                   Foreground="#FF606090"
                                                   FontSize="11"
                                                   Margin="0,4,0,10"/>
                                                   
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Non-Destructive Mode -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc NonDestructiveLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc NonDestructiveDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="NewRecordingsNonDestructiveCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}" Checked="NewRecordingsNonDestructiveCheck_Checked" Unchecked="NewRecordingsNonDestructiveCheck_Unchecked"/>
                                        </Grid>

                                        <StackPanel x:Name="VstSettingsPanel" Visibility="Visible">
                                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                            <!-- VST2 Plugins -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="360"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0">
                                                    <TextBlock Text="VST2 Plugins" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="Imported .dll plugins are copied to the local app folder and become available in the Audio Editor." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Width="360" VerticalAlignment="Top">
                                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4">
                                                        <ListBox x:Name="Vst2PluginsListBox" Height="120" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                        <Button x:Name="AddVst2Button" Content="Add..." Width="70" Height="28" Margin="0,0,6,0" Click="AddVst2Button_Click"/>
                                                        <Button x:Name="DeleteVst2Button" Content="Delete" Width="70" Height="28" Click="DeleteVst2Button_Click"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="Vst2TotalSizeText" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- VST3 Plugin Path (Dev Mode Only) -->
                                            <StackPanel x:Name="Vst3PluginRow" Visibility="Collapsed">
                                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="240"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="VST3 Plugin Path (Experimental)" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="Select a .vst3 plugin to be available in the Audio Editor." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Grid Grid.Column="1" Width="240" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="Vst3PluginPathTextBox" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Margin="0,0,6,0" IsReadOnly="True" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>
                                                        <Button x:Name="BrowseVst3Button" Grid.Column="1" Content="..." Width="32" Height="28" Click="BrowseVst3Button_Click"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Buffer Recording Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc BufferRecGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Duration Slider Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="260"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc PastBufferLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc PastBufferDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="260">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="45"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="BufferDurationSlider" Grid.Column="0" Minimum="0.5" Maximum="60" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="BufferDurationSlider_Changed"/>
                                                <TextBlock x:Name="BufferDurationLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="10s" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </Grid>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Hotkey Modifiers Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc BufferHotkeyLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc BufferHotkeyDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="ModCtrl" Content="Ctrl" Style="{StaticResource RackPowerSwitch}" Margin="0,0,16,0"/>
                                                <CheckBox x:Name="ModAlt" Content="Alt" Style="{StaticResource RackPowerSwitch}" Margin="0,0,16,0"/>
                                                <CheckBox x:Name="ModShift" Content="Shift" Style="{StaticResource RackPowerSwitch}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Hotkey Key Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Hotkey Trigger Key" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Click the box then press any key to bind quick capture shortcut." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="HotkeyKeyBox" Grid.Column="1" Width="220" Height="28" IsReadOnly="True" Cursor="Hand" TextAlignment="Center" ToolTip="Click then press any key to assign" PreviewKeyDown="HotkeyKeyBox_PreviewKeyDown" GotFocus="HotkeyKeyBox_GotFocus" LostFocus="HotkeyKeyBox_LostFocus" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ 2. AUDIO & PLAYBACK TAB ══════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabAudio}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc AudioDevicesHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc AudioDevicesSubtitle}" FontSize="11.5" Foreground="#FF8080A8" Margin="0,0,0,18"/>

                                <!-- Audio Engine Selection Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc AudioEngineGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="280"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{p:Loc AudioEngineLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{p:Loc AudioEngineDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="AudioEngineCombo" Grid.Column="1" Width="280" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Trim Editor Output Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc TrimOutputGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <!-- Playback device selection -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="280"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{p:Loc TrimOutputLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{p:Loc TrimOutputDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="TrimOutputDeviceCombo" Grid.Column="1" Width="280" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Live Microphone Configuration Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="Live Microphone Configuration" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Live Mic Input Device -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="280"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Live Microphone Device" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Select physical microphone device for real-time live mic streaming and dual-bus routing." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="LiveMicDeviceCombo" Grid.Column="1" Width="280" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Live Mic Output Device -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="280"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Live Microphone Output Device" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Select audio output device (or virtual audio cable) to stream live microphone audio." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="LiveMicOutputDeviceCombo" Grid.Column="1" Width="280" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Live Mic Input Gain -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="280"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Live Microphone Input Gain" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Adjust real-time input gain boost for live microphone feed." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="280">
                                                <Slider x:Name="LiveMicGainSlider" Minimum="0.0" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="210" VerticalAlignment="Center" ValueChanged="LiveMicGainSlider_ValueChanged"/>
                                                <TextBlock x:Name="LiveMicGainValueText" Text="100%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Live Mic FX Modulation Toggle (Unimplemented) -->
                                        <Grid Margin="0,6" IsEnabled="False" Opacity="0.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Enable Voice FX Modulation" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Apply real-time pitch shift, reverb, and VST DSP voice modulation to live mic feed." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="LiveMicFxCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Virtual Audio Driver (Discord & OBS Routing) Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="Virtual Audio Cable &amp; Driver (Discord / OBS Routing)" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Driver Status & Info Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="VB-Audio Virtual Cable (WHQL Signed)" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                    <Border x:Name="VirtualDriverStatusBadge" Margin="10,0,0,0" Padding="8,2" CornerRadius="4" Background="#264CAF50" VerticalAlignment="Center">
                                                        <TextBlock x:Name="VirtualDriverStatusBadgeText" Text="Installed &amp; Ready" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="VirtualDriverDescriptionText"
                                                           Text="VB-CABLE is high-performance donationware developed by Vincent Burel / VB-Audio Software. It provides Microsoft WHQL-certified virtual playback ('CABLE Input') and microphone ('CABLE Output') endpoints to route soundboard clips and live voice modulator into Discord, OBS, Zoom, Teams, and games without requiring Test-Signing mode."
                                                           FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button Content="About VB-Audio" MinWidth="110" Height="32" Padding="12,0" Margin="0,0,8,0" Click="OpenVbAudioNotice_Click"/>
                                                <Button x:Name="VirtualDriverInstallBtn" Content="Install Driver" MinWidth="130" Height="32" Padding="16,0" Margin="0,0,8,0" Click="VirtualDriverInstallBtn_Click"/>
                                                <Button x:Name="VirtualDriverUninstallBtn" Content="Uninstall" MinWidth="95" Height="32" Padding="14,0" Click="VirtualDriverUninstallBtn_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- 1-Click Routing Presets Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="1-Click Routing Presets" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Quickly configure PaDDY to route soundboard clips or live voice effects straight to your virtual mic." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button x:Name="RouteSoundboardPresetBtn" Content="Route Soundboard to Discord" MinWidth="200" Height="32" Padding="14,0" Margin="0,0,8,0" Click="RouteSoundboardPresetBtn_Click"/>
                                                <Button x:Name="RouteLiveMicPresetBtn" Content="Route Voice Modulator" MinWidth="170" Height="32" Padding="14,0" Click="RouteLiveMicPresetBtn_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Windows Sound Control Panel Shortcuts -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Windows Sound Diagnostics" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Open Windows Sound settings or Control Panel to inspect audio endpoint levels and properties." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button Content="Sound Settings" MinWidth="130" Height="30" Padding="14,0" Margin="0,0,8,0" Click="OpenSoundSettings_Click"/>
                                                <Button Content="Classic Control Panel" MinWidth="160" Height="30" Padding="14,0" Click="OpenClassicSoundPanel_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Loudness Normalization Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc LoudnessNormGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Auto Normalize toggle -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc AutoNormLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc AutoNormDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoNormalizeCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}" Checked="AutoNormalizeCheck_Changed" Unchecked="AutoNormalizeCheck_Changed"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Target LUFS slider -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="280"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc TargetLoudnessLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc TargetLoudnessDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Slider x:Name="TargetLufsSlider" Width="180" Minimum="-24.0" Maximum="-6.0" Value="-14.0" TickFrequency="1.0" SmallChange="0.5" LargeChange="1.0" ValueChanged="TargetLufsSlider_ValueChanged" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TargetLufsValueText" Text="-14.0 LUFS" Width="90" Margin="8,0,0,0" TextAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Global Auto Fade & Multi-Pad Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc GlobalAutoFadeGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Enable Toggle Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc GlobalFadeLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc GlobalFadeDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="GlobalFadeCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Fade-In Duration Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="280"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc GlobalFadeInLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc GlobalFadeInDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="280">
                                                <Slider x:Name="GlobalFadeInSlider"
                                                        Minimum="0" Maximum="5000" TickFrequency="50"
                                                        IsSnapToTickEnabled="True"
                                                        Width="200"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="GlobalFadeInSlider_ValueChanged"/>
                                                <TextBlock x:Name="GlobalFadeInValueText"
                                                           Width="70"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Fade-Out Duration Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="280"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc GlobalFadeOutLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc GlobalFadeOutDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="280">
                                                <Slider x:Name="GlobalFadeOutSlider"
                                                        Minimum="0" Maximum="5000" TickFrequency="50"
                                                        IsSnapToTickEnabled="True"
                                                        Width="200"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="GlobalFadeOutSlider_ValueChanged"/>
                                                <TextBlock x:Name="GlobalFadeOutValueText"
                                                           Width="70"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Allow Multi-Pad Playback Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc AllowMultiPadPlaybackLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc AllowMultiPadPlaybackDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AllowMultiPadPlaybackCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ 3. NAMING & AI TAB ═══════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE134;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabNaming}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc NamingHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc NamingSubtitle}" FontSize="11.5" Foreground="#FF8080A8" Margin="0,0,0,18"/>

                                <!-- Naming Options Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc PadNamingGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Template Title -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="250"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc TitleTemplateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc TitleTemplateDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="DefaultPadTitleBox" Grid.Column="1" Width="250" Height="28" ToolTip="Use placeholders: {timestamp}, {codec}, {app}." VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Focused App Name -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc IncludeAppLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc IncludeAppDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="UseFocusedAppNameCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AI Speech to Text Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc SpeechGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Auto Rename Checkbox -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc AutoRenameSpeechLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc AutoRenameSpeechDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoRenameSpeechCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <!-- Voice-Only Detector Checkbox -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc CancelRecordingIfNoVoiceLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc CancelRecordingIfNoVoiceDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="CancelRecordingIfNoVoiceCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Model Selection Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="280"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc WhisperModelLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc WhisperModelDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="280">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="SpeechModelCombo" Grid.Column="0" SelectionChanged="SpeechModelCombo_SelectionChanged" VerticalAlignment="Center"/>
                                                <Button x:Name="DownloadModelBtn" Grid.Column="1" Content="{p:Loc Download}" Margin="8,0,0,0" Padding="12,0" Height="28" Click="DownloadModelBtn_Click" VerticalAlignment="Center"/>
                                                <Button x:Name="UninstallModelBtn" Grid.Column="1" Content="{p:Loc Remove}" Margin="8,0,0,0" Padding="12,0" Height="28" Click="UninstallModelBtn_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Model download stats -->
                                        <ProgressBar x:Name="ModelDownloadProgress" Height="6" Margin="0,4,0,8" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                                        <TextBlock x:Name="ModelDownloadStatusText" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed" Foreground="{DynamicResource AccentAmberBrush}"/>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Whisper Language Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc WhisperLangLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc WhisperLangDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="SpeechLanguageBox" Grid.Column="1" Width="220" Height="28" ToolTip="Language code, e.g. en, fr, de, or 'auto' to detect." VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ 4. APPEARANCE TAB ════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabAppearance}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc AppearanceHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc AppearanceSubtitle}" FontSize="11.5" Foreground="#FF8080A8" Margin="0,0,0,18"/>

                                <!-- Theme & Typography Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc ThemeGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Overall Theme Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc ThemeLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc ThemeDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="220" VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Font Variant Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc FontLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc FontDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="FontVariantCombo" Grid.Column="1" Width="220" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Language Setting Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc LanguageSetting}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc SelectLanguageDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="220" VerticalAlignment="Center" SelectionChanged="LanguageCombo_SelectionChanged">
                                                <ComboBoxItem x:Name="LangEnItem" Content="{p:Loc LanguageEnglish}" Tag="en"/>
                                                <ComboBoxItem x:Name="LangFrItem" Content="{p:Loc LanguageFrench}" Tag="fr"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Interface Zoom & Scaling Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc ZoomGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- UI Zoom Slider Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="340"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc UiScaleLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc UiScaleDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="340">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="UiZoomSlider" Grid.Column="0"
                                                        Minimum="50" Maximum="200" Value="100"
                                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="UiZoomSlider_ValueChanged"/>
                                                <TextBlock x:Name="UiZoomValueLabel" Grid.Column="1"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Text="100%" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <Button x:Name="ResetUiZoomBtn" Grid.Column="2"
                                                        Content="{p:Loc ResetZoomBtn}"
                                                        Padding="10,0" Height="26" Margin="6,0,0,0"
                                                        Click="ResetUiZoomBtn_Click"
                                                        ToolTip="Reset UI zoom to 100% (Ctrl+0)"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Quick Presets -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="75%" Height="24" Padding="10,0" Margin="0,0,4,0" FontSize="11" Click="ZoomPreset_Click" Tag="75"/>
                                            <Button Content="100%" Height="24" Padding="10,0" Margin="0,0,4,0" FontSize="11" Click="ZoomPreset_Click" Tag="100"/>
                                            <Button Content="125%" Height="24" Padding="10,0" Margin="0,0,4,0" FontSize="11" Click="ZoomPreset_Click" Tag="125"/>
                                            <Button Content="150%" Height="24" Padding="10,0" Margin="0,0,4,0" FontSize="11" Click="ZoomPreset_Click" Tag="150"/>
                                            <Button Content="175%" Height="24" Padding="10,0" Margin="0,0,4,0" FontSize="11" Click="ZoomPreset_Click" Tag="175"/>
                                            <Button Content="200%" Height="24" Padding="10,0" Margin="0,0,0,0" FontSize="11" Click="ZoomPreset_Click" Tag="200"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Audio VU Meters & Skins Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="AUDIO VISUALIZERS &amp; METERS" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Meter Skin Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc MeterSkinLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc MeterSkinDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="MeterSkinCombo" Grid.Column="1" Width="220" VerticalAlignment="Center" SelectionChanged="MeterSkinCombo_SelectionChanged"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- LED dots -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc DigitalDotsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc DigitalDotsDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="MeterDigitalDotsCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}" Checked="MeterDigitalDotsCheck_Changed" Unchecked="MeterDigitalDotsCheck_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ 5. PERFORMANCE TAB (NEW) ═════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabPerformance}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="Performance &amp; Optimization" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Optimize rendering, CPU usage, hardware GPU acceleration, and audio memory caching." FontSize="11.5" Foreground="#FF8080A8" Margin="0,0,0,18"/>

                                <!-- Rendering & Graphics Optimization Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="GRAPHICS &amp; CPU OPTIMIZATION" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel Margin="0,6">
                                        <!-- Low-resource performance mode -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc PerfModeLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc PerfModeDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="PerformanceModeCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <!-- Divider -->
                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,10"/>

                                        <!-- Pause animations when unfocused -->
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc PauseAnimLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc PauseAnimDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="PauseAnimationsWhenUnfocusedCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Audio RAM & Storage Caching Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="AUDIO RAM &amp; DISK CLEANUP" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Preload Audio RAM Cache -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc PreloadAudioCacheLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc PreloadAudioCacheDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="PreloadAudioCacheCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Max Records Auto-Cleanup Slider -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="260"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc MaxRecordsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc MaxRecordsDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="260">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="45"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="MaxRecordsSlider" Grid.Column="0" Minimum="0" Maximum="500" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="MaxRecordsSlider_Changed"/>
                                                <TextBlock x:Name="MaxRecordsLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="∞" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="0 = unlimited. Favorites are never auto-deleted."/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Hardware GPU Acceleration Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="HARDWARE GPU ACCELERATION" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- CUDA GPU Support -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc CudaLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc CudaDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="UseCudaCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}" Click="UseCudaCheck_Click"/>
                                        </Grid>

                                        <!-- CUDA Actions & Status -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CudaStatusText" Grid.Column="0" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="DownloadCudaBtn" Content="{p:Loc DownloadCudaPack}" Padding="12,0" Height="28" Click="DownloadCudaBtn_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
                                                <Button x:Name="RemoveCudaBtn" Content="{p:Loc RemoveCudaPack}" Padding="12,0" Height="28" Click="RemoveCudaBtn_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- CUDA Download Progress Bar -->
                                        <ProgressBar x:Name="CudaDownloadProgress" Height="6" Margin="0,8,0,4" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                                        <TextBlock x:Name="CudaDownloadStatusText" FontSize="11" Margin="0,0,0,4" Visibility="Collapsed" Foreground="{DynamicResource AccentAmberBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ 6. SYSTEM TAB ════════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabSystem}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc SystemHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc SystemSubtitle}" FontSize="11.5" Foreground="#FF8080A8" Margin="0,0,0,18"/>

                                <!-- System Tray Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc TrayGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Minimize to tray -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc MinTrayLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc MinTrayDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="MinimizeToTrayCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Close to tray -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc CloseTrayLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc CloseTrayDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="CloseToTrayCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Start minimized -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc StartMinLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc StartMinDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="StartMinimizedCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- OS Startup and Update Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc StartupGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Windows Startup -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc RunStartupLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc RunStartupDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="RunOnStartupCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Silent Auto Updates -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc AutoUpdateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc AutoUpdateDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoInstallUpdatesCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Download Beta Updates -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc BetaUpdateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc BetaUpdateDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="DownloadBetaUpdatesCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ 7. THIRD PARTY TAB ══════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabThirdParty}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc ThirdPartyHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc ThirdPartySubtitle}" FontSize="11.5" Foreground="#FF8080A8" Margin="0,0,0,18"/>

                                <!-- Hardware Integrations Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc StreamDeckGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <!-- Stream deck plugin installation -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="240"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{p:Loc StreamDeckLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{p:Loc StreamDeckDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="InstallStreamDeckBtn" Grid.Column="1" Content="{p:Loc InstallStreamDeckBtn}" Width="240" Height="30" Click="InstallStreamDeckBtn_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Discord Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc DiscordGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Discord Check -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc DiscordLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc DiscordDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="DiscordRichPresenceCheck" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RackPowerSwitch}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Client ID -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="240"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc DiscordClientIdLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc DiscordClientIdDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="DiscordClientIdBox" Grid.Column="1" Width="240" Height="28" ToolTip="Custom Application ID from Discord Developer Portal. Default test ID is 461618159171141643." VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ 8. BACKUP & RESTORE TAB ══════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabBackup}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc BackupHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc BackupSubtitle}" FontSize="11.5" Foreground="#FF8080A8" Margin="0,0,0,18"/>

                                <!-- Backup and Restore operations group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc DataMgmtGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Backup Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc BackupLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc BackupDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="BackupButton" Grid.Column="1" Content="{p:Loc BackupBtn}" Width="220" Height="30" Click="ExportData_Click" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Restore Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc RestoreLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc RestoreDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="RestoreButton" Grid.Column="1" Content="{p:Loc RestoreBtn}" Width="220" Height="30" Click="ImportData_Click" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Clear All Data Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Clear All Data" FontWeight="SemiBold" Foreground="{DynamicResource AccentRedBrush}"/>
                                                <TextBlock Text="Permanently delete all audio pads, custom folders, recordings database, and reset application settings." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="ClearAllDataBtn" Grid.Column="1" Content="Clear All Data" Width="220" Height="30" Background="{DynamicResource AccentRedBrush}" Foreground="White" Click="ClearAllDataBtn_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- Footer Section at bottom left sidebar column -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Padding="16,10,16,10"
                            Background="{DynamicResource SecondaryFooterBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,1,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VersionInfoText"
                                       Text="PaDDY v0.0.0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DependenciesInfoText"
                                       Text="Dependencies —"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="9.5"
                                       Margin="0,3,0,0"
                                       LineHeight="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer Section at bottom right content column -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Padding="24,12,24,16"
                            Background="{DynamicResource SecondaryFooterBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{p:Loc OK}"
                                    Width="96"
                                    Height="32"
                                    Margin="0,0,12,0"
                                    Click="OkButton_Click"
                                    IsDefault="True"
                                    Foreground="{DynamicResource AccentGreenBrush}"/>
                            <Button Content="{p:Loc Cancel}"
                                    Width="96"
                                    Height="32"
                                    Click="CancelButton_Click"
                                    IsCancel="True"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <controls:LoadingOverlay x:Name="SettingsLoadingOverlay" Grid.RowSpan="2" Panel.ZIndex="100"/>
            </Grid>
        </Border>
    </Grid>
</Window>
