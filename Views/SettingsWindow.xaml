<Window x:Class="PaDDY.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    

    <Grid Margin="10">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        Background="{ThemeResource TitleBarGradient}"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0">
                    <Grid>
                        <TextBlock Text="PaDDY — Settings"
                                   Foreground="#FF8080A8"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTipService.ToolTip="Close"
                                Click="ChromeClose_Click">
                                
                            <TextBlock Text="&#x2715;" FontSize="14" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

        <Pivot Grid.Row="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
            
            

            <!-- ══ RECORDING TAB ════════════════════════════════════ -->
            <PivotItem Header="Recording">
        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── Recording Format ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="RECORDING FORMAT" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Codec:"
                                       Style="{StaticResource SettingsLabel}"/>
                            <ComboBox x:Name="CodecCombo"
                                      Grid.Column="1"
                                      SelectionChanged="CodecCombo_SelectionChanged"/>
                        </Grid>
                        <TextBlock x:Name="CodecInfoText"
                                   TextWrapping="Wrap"
                                   Foreground="#FF606090"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- ── Buffer Recording ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="BUFFER RECORDING" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Past buffer duration:"
                                   Style="{StaticResource SettingsLabel}"/>
                        <Slider x:Name="BufferDurationSlider"
                                Grid.Column="1"
                                Minimum="0.5"
                                Maximum="60"
                                SnapsTo="Ticks"
                                StepFrequency="0.5"
                                VerticalAlignment="Center"
                                ValueChanged="BufferDurationSlider_Changed"/>
                        <TextBlock x:Name="BufferDurationLabel"
                                   Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="10s"
                                   Foreground="#FFB0B0CC"/>
                    </Grid>
                </Border>

                <!-- ── Buffer Trigger Hotkey ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="BUFFER TRIGGER HOTKEY" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Modifiers:"
                                   Style="{StaticResource SettingsLabel}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal">
                            <CheckBox x:Name="ModCtrl"  Content="Ctrl"  Margin="0,0,14,0"/>
                            <CheckBox x:Name="ModAlt"   Content="Alt"   Margin="0,0,14,0"/>
                            <CheckBox x:Name="ModShift" Content="Shift"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Key (click to capture):"
                                   Style="{StaticResource SettingsLabel}"/>
                        <TextBox x:Name="HotkeyKeyBox"
                                 Grid.Row="2" Grid.Column="1"
                                 IsReadOnly="True"
                                 ToolTipService.ToolTip="Click then press any key to assign"
                                 KeyDown="HotkeyKeyBox_PreviewKeyDown"
                                 GotFocus="HotkeyKeyBox_GotFocus"
                                 LostFocus="HotkeyKeyBox_LostFocus"/>
                    </Grid>
                </Border>

                <!-- ── Auto-Cleanup ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="AUTO-CLEANUP" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Max recordings:"
                                   Style="{StaticResource SettingsLabel}"/>
                        <Slider x:Name="MaxRecordsSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="500"
                                SnapsTo="Ticks"
                                StepFrequency="5"
                                VerticalAlignment="Center"
                                ValueChanged="MaxRecordsSlider_Changed"/>
                        <TextBlock x:Name="MaxRecordsLabel"
                                   Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="∞"
                                   Foreground="#FFB0B0CC"
                                   ToolTipService.ToolTip="0 = unlimited. Favorites are never auto-deleted."/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
            </PivotItem>

            <!-- ══ NAMING TAB ══════════════════════════════════════ -->
            <PivotItem Header="Naming">
        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── New Pad Naming ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="NEW PAD NAMING" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Default title:"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="DefaultPadTitleBox"
                                     Grid.Column="1"
                                  ToolTipService.ToolTip="Use curly-brace placeholders only: {timestamp}, {codec}, {app}. Example: Recording {timestamp}. Parentheses like (timestamp) stay as literal text."/>
                        </Grid>
                           <TextBlock Text="Placeholders must use curly braces: {timestamp}, {codec}, {app}. Parentheses like (timestamp) are treated as normal text."
                                TextWrapping="Wrap"
                                Foreground="#FF606090"
                                FontSize="11"/>
                        <CheckBox x:Name="UseFocusedAppNameCheck"
                                  Content="Use focused app name when available"
                                  Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── Speech-to-text ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="SPEECH-TO-TEXT" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="AutoRenameSpeechCheck"
                                  Content="Auto-rename new recordings from detected speech"
                                  Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Model:"
                                       Style="{StaticResource SettingsLabel}"/>
                            <ComboBox x:Name="SpeechModelCombo" Grid.Column="1"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Language:"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="SpeechLanguageBox" Grid.Column="1"
                                     ToolTipService.ToolTip="Language code, e.g. en, fr, de, or 'auto' to detect."/>
                        </Grid>
                        <CheckBox x:Name="UseCudaCheck"
                                  Content="Use CUDA GPU acceleration (NVIDIA only)"
                                  Margin="0,10,0,0"/>
                        <TextBlock x:Name="CudaStatusText"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
            </PivotItem>

            <!-- ══ PLAYBACK TAB ═════════════════════════════════════ -->
            <PivotItem Header="Playback">
        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── Trim Editor Output ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="TRIM EDITOR OUTPUT" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Output device:"
                                   Style="{StaticResource SettingsLabel}"/>
                        <ComboBox x:Name="TrimOutputDeviceCombo"
                                  Grid.Column="1"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
            </PivotItem>

            <!-- ══ APPEARANCE TAB ═══════════════════════════════════ -->
            <PivotItem Header="Appearance">
        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── Font Variant ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="FONT VARIANT" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="App font:"
                                   Style="{StaticResource SettingsLabel}"/>
                        <ComboBox x:Name="FontVariantCombo"
                                  Grid.Column="1"/>
                    </Grid>
                </Border>

                <!-- ── Theme ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="THEME" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Overall theme:"
                                       Style="{StaticResource SettingsLabel}"/>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1"
                                      SelectionChanged="ThemeCombo_SelectionChanged"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Audio meter:"
                                       Style="{StaticResource SettingsLabel}"/>
                            <ComboBox x:Name="MeterSkinCombo" Grid.Column="1"
                                      SelectionChanged="MeterSkinCombo_SelectionChanged"/>
                        </Grid>
                        <CheckBox x:Name="MeterDigitalDotsCheck"
                                  Content="Segmented digital LED dots"
                                  Margin="140,10,0,0"
                                  Checked="MeterDigitalDotsCheck_Changed"
                                  Unchecked="MeterDigitalDotsCheck_Changed"/>
                    </StackPanel>
                </Border>

                <!-- ── Performance ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="PERFORMANCE" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="PerformanceModeCheck"
                                  Content="Performance mode (CPU-only rendering, limited animations)"/>
                        <TextBlock Text="Disables hardware acceleration and decorative animations to reduce GPU/CPU load on low-end machines. Takes full effect after restart."
                                   TextWrapping="Wrap"
                                   Foreground="#FF606090"
                                   FontSize="11"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
            </PivotItem>

            <!-- ══ SYSTEM TAB ═══════════════════════════════════════ -->
            <PivotItem Header="System">
        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── System Tray ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="SYSTEM TRAY" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheck"
                                  Content="Minimize to system tray"
                                  Margin="0,0,0,8"/>
                        <CheckBox x:Name="CloseToTrayCheck"
                                  Content="Close button minimizes to system tray"
                                  Margin="0,0,0,8"/>
                        <CheckBox x:Name="StartMinimizedCheck"
                                  Content="Start minimized in system tray"/>
                    </StackPanel>
                </Border>

                <!-- ── Startup ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="STARTUP" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <CheckBox x:Name="RunOnStartupCheck"
                              Content="Start PaDDY when Windows starts"/>
                </Border>

                <!-- ── Integrations ── -->
                <StackPanel Style="{StaticResource GroupHeader}">
                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                    <TextBlock Text="INTEGRATIONS" Style="{StaticResource HeaderText}"/>
                </StackPanel>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Stream Deck Plugin" Foreground="#E0E0E0" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Control PaDDY using Elgato Stream Deck." Foreground="#B0B0B0" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button x:Name="InstallStreamDeckBtn" Content="Install Stream Deck Plugin" HorizontalAlignment="Left" Click="InstallStreamDeckBtn_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
            </PivotItem>

        </Pivot>
                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="0,12,0,0"
                            Background="{StaticResource SecondaryFooterBackgroundBrush}"
                            BorderBrush="#14FFFFFF"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="OK"
                                    Margin="0,0,10,0"
                                    Click="OkButton_Click"
                                    
                                    Background="#FF1A2E1A"
                                    BorderBrush="#404CAF50"
                                    Foreground="#FF9ECC9E"/>
                            <Button Content="Cancel"
                                    Click="CancelButton_Click"
                                    />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
