<Window x:Class="PaDDY.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PaDDY — Settings"
        Icon="/PaDDY.ico"
        Width="880"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="5"
                            ResizeBorderThickness="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="10">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0">
                    <Grid>
                        <TextBlock Text="PaDDY — Settings"
                                   Foreground="#FF8080A8"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTip="Close"
                                Click="ChromeClose_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="#FFFF5555" BlurRadius="8" ShadowDepth="0"/>
                            </Button.Effect>
                            <TextBlock Text="&#x2715;" FontSize="14" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Settings Body -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Vertical Sidebar Navigation -->
                        <ColumnDefinition Width="210"/>
                        <!-- Column 1: Main Content Panels -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Background Pane -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            Background="#07FFFFFF"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,1,0"/>

                    <!-- TabControl (Template splits headers to Col 0, content to Col 1) -->
                    <TabControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Sidebar Tab Items List -->
                                    <Border Grid.Column="0" Padding="0,16,0,0" Background="Transparent">
                                        <StackPanel IsItemsHost="True" Background="Transparent"/>
                                    </Border>
                                    
                                    <!-- Content Viewport -->
                                    <Border Grid.Column="1" Background="Transparent">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="24,16,24,12">
                                            <ContentPresenter ContentSource="SelectedContent"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        
                        <TabControl.Resources>
                            <!-- Custom styled TabItem to behave like modern sidebar options -->
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FF8080A8"/>
                                <Setter Property="Padding" Value="18,11,18,11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="4,0,0,0"
                                                    BorderBrush="Transparent"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="0,1,0,1">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  TextElement.FontSize="12"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  TextElement.FontFamily="{DynamicResource AppFont}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#12FFFFFF"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#0AFFFFFF"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#16FFFFFF"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- ══ RECORDING TAB ════════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="Recording" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="Recording Configuration" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Configure audio capture formats, past-buffer duration, hotkeys, and automated disk cleanup." FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Recording Format Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="RECORDING FORMAT" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Codec Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Codec" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Choose the audio compression format for new recordings." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CodecCombo" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="CodecCombo_SelectionChanged"/>
                                        </Grid>
                                        
                                        <!-- Info label block -->
                                        <TextBlock x:Name="CodecInfoText"
                                                   TextWrapping="Wrap"
                                                   Foreground="#FF606090"
                                                   FontSize="11"
                                                   Margin="0,4,0,10"/>
                                                   
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Non-Destructive Mode -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Non-Destructive Effects &amp; Trim" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Keep the raw source audio intact to allow adjusting real-time gain, effects, and boundaries later." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="NewRecordingsNonDestructiveCheck" Grid.Column="1" VerticalAlignment="Center" Checked="NewRecordingsNonDestructiveCheck_Checked" Unchecked="NewRecordingsNonDestructiveCheck_Unchecked"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Buffer Recording Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="BUFFER RECORDING" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Duration Slider Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="240"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Past Buffer Duration" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Specify the duration of audio kept in memory to capture retrospectively." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="240">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="BufferDurationSlider" Grid.Column="0" Minimum="0.5" Maximum="60" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="BufferDurationSlider_Changed"/>
                                                <TextBlock x:Name="BufferDurationLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="10s" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </Grid>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Hotkey Modifiers Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Trigger Modifiers" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Keys required in combination to capture the past buffer." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="ModCtrl" Content="Ctrl" Margin="0,0,14,0"/>
                                                <CheckBox x:Name="ModAlt" Content="Alt" Margin="0,0,14,0"/>
                                                <CheckBox x:Name="ModShift" Content="Shift"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Hotkey Key Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Hotkey Trigger Key" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Click the field and press a key to capture it as the buffer hotkey." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="HotkeyKeyBox" Grid.Column="1" Width="200" Height="28" IsReadOnly="True" Cursor="Hand" TextAlignment="Center" ToolTip="Click then press any key to assign" PreviewKeyDown="HotkeyKeyBox_PreviewKeyDown" GotFocus="HotkeyKeyBox_GotFocus" LostFocus="HotkeyKeyBox_LostFocus" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Auto-Cleanup Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="AUTO-CLEANUP" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="240"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Maximum Recordings" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Auto-delete old recordings when count is exceeded. Favorites are never deleted." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="240">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="MaxRecordsSlider" Grid.Column="0" Minimum="0" Maximum="500" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="MaxRecordsSlider_Changed"/>
                                            <TextBlock x:Name="MaxRecordsLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="∞" Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="0 = unlimited. Favorites are never auto-deleted."/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ NAMING TAB ══════════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE134;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="Naming &amp; AI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="File Naming &amp; AI Transcription" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Manage default title naming templates and configure localized Whisper speech-to-text models." FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Naming Options Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="NEW PAD NAMING" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Template Title -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Default Title Template" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Placeholders must use curly braces: {timestamp}, {codec}, {app}." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="DefaultPadTitleBox" Grid.Column="1" Width="220" Height="28" ToolTip="Use placeholders: {timestamp}, {codec}, {app}." VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Focused App Name -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Include Focused App Name" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Detect and append the currently active application's name to new pad titles." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="UseFocusedAppNameCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AI Speech to Text Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="AI SPEECH-TO-TEXT" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Auto Rename Checkbox -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Auto-Rename via Transcription" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Process speech audio with Whisper AI to name files based on spoken content." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoRenameSpeechCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Model Selection Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="260"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Whisper Model Size" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Select speech recognition model. Larger models are more accurate but use more space and resources." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="260">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="SpeechModelCombo" Grid.Column="0" SelectionChanged="SpeechModelCombo_SelectionChanged" VerticalAlignment="Center"/>
                                                <Button x:Name="DownloadModelBtn" Grid.Column="1" Content="Download" Margin="8,0,0,0" Padding="12,0" Height="28" Click="DownloadModelBtn_Click" VerticalAlignment="Center"/>
                                                <Button x:Name="UninstallModelBtn" Grid.Column="1" Content="Remove" Margin="8,0,0,0" Padding="12,0" Height="28" Click="UninstallModelBtn_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Model download stats -->
                                        <ProgressBar x:Name="ModelDownloadProgress" Height="6" Margin="0,4,0,8" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                                        <TextBlock x:Name="ModelDownloadStatusText" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed" Foreground="{DynamicResource AccentAmberBrush}"/>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Whisper Language Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Transcription Language" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Specify Whisper language code (e.g. 'en', 'es', 'de') or set to 'auto'." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="SpeechLanguageBox" Grid.Column="1" Width="200" Height="28" ToolTip="Language code, e.g. en, fr, de, or 'auto' to detect." VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- CUDA GPU Support -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="CUDA GPU Acceleration" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Leverage NVIDIA CUDA hardware to speed up speech model execution." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="UseCudaCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="CudaStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ PLAYBACK TAB ═════════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="Playback" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="Playback Settings" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Configure output routing and monitoring configurations for post-editing." FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Trim Editor Output Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="TRIM EDITOR OUTPUT" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <!-- Playback device selection -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Trim Editor Output Device" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Redirect playback audio to a specific output device during editing and listening." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="TrimOutputDeviceCombo" Grid.Column="1" Width="260" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ APPEARANCE TAB ═══════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="Visual Customization" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Customize typography, app themes, volume meters, and UI hardware rendering modes." FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Font Variant Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="FONT VARIANT" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <!-- Font selection -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="App Typography Font" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Choose the UI font weight and width layout styles." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="FontVariantCombo" Grid.Column="1" Width="200" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Theme Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="THEME &amp; SKINS" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Overall Theme Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Application Theme" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Select overall visual theme and color palette settings." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Meter Skin Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Audio Level Meter Style" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Change color themes and gradient layouts of input volume meters." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="MeterSkinCombo" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="MeterSkinCombo_SelectionChanged"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- LED dots -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Segmented Digital LED Dots" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Draw meters as segmented vintage LED dots instead of solid gradients." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="MeterDigitalDotsCheck" Grid.Column="1" VerticalAlignment="Center" Checked="MeterDigitalDotsCheck_Changed" Unchecked="MeterDigitalDotsCheck_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Performance Mode Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="PERFORMANCE" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Low-Resource Performance Mode" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Enforces CPU-only rendering and limits decorative animations. Helpful on older laptops to reduce resource usage." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="PerformanceModeCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ SYSTEM TAB ═══════════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="System" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="System &amp; Integrations" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Manage background services, system tray toggles, startup operations, and plugins." FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- System Tray Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="SYSTEM TRAY OPERATIONS" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Minimize to tray -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Minimize to System Tray" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Move the application window to the Windows notification tray area when minimized." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="MinimizeToTrayCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Close to tray -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Close button minimizes to Tray" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Clicking the close button hides the window to the tray instead of shutting down PaDDY." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="CloseToTrayCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Start minimized -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Start Minimized in System Tray" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Launch the application in a minimized state inside the notification area." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="StartMinimizedCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- OS Startup and Update Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="STARTUP &amp; UPDATES" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Windows Startup -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Run on Windows Startup" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Automatically start PaDDY when Windows boots up." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="RunOnStartupCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Silent Auto Updates -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Silent Auto-Update Installation" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Checks, downloads, backs up, installs and restores data automatically on startup." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoInstallUpdatesCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Hardware Integrations Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="ELGATO STREAM DECK PLUGIN" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <!-- Stream deck plugin installation -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Install Elgato Plugin" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Register custom plugin inside Stream Deck for macro level deck control mappings." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="InstallStreamDeckBtn" Grid.Column="1" Content="Install Stream Deck Plugin" Width="220" Height="28" Click="InstallStreamDeckBtn_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Discord Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="DISCORD RICH PRESENCE" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Discord Check -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Enable Discord Rich Presence" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Display status updates and current recording activities directly on Discord." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="DiscordRichPresenceCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Client ID -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Discord Application Client ID" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Set custom developer application ID. Leave blank to use default test client." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="DiscordClientIdBox" Grid.Column="1" Width="220" Height="28" ToolTip="Custom Application ID from Discord Developer Portal. Default test ID is 461618159171141643." VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- Footer Section at the bottom right content column -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Padding="24,12,24,16"
                            Background="{DynamicResource SecondaryFooterBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="OK"
                                    Width="88"
                                    Margin="0,0,10,0"
                                    Click="OkButton_Click"
                                    IsDefault="True"
                                    Foreground="{DynamicResource AccentGreenBrush}"/>
                            <Button Content="Cancel"
                                    Width="88"
                                    Click="CancelButton_Click"
                                    IsCancel="True"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
