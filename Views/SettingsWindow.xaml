<Window x:Class="PaDDY.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PaDDY.Controls"
        xmlns:p="clr-namespace:PaDDY.Helpers"
        Title="{p:Loc SettingsTitle}"
        Icon="/PaDDY.ico"
        Width="880"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="5"
                            ResizeBorderThickness="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="10">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0">
                    <Grid>
                        <TextBlock Text="PaDDY — Settings"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTip="Close"
                                Click="ChromeClose_Click">
                            <TextBlock Text="&#xE8BB;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Settings Body -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Vertical Sidebar Navigation -->
                        <ColumnDefinition Width="210"/>
                        <!-- Column 1: Main Content Panels -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Background Pane -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            Background="#07FFFFFF"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,1,0"/>

                    <!-- TabControl (Template splits headers to Col 0, content to Col 1) -->
                    <TabControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Sidebar Tab Items List -->
                                    <Border Grid.Column="0" Padding="0,16,0,0" Background="Transparent">
                                        <StackPanel IsItemsHost="True" Background="Transparent"/>
                                    </Border>
                                    
                                    <!-- Content Viewport -->
                                    <Border Grid.Column="1" Background="Transparent">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="24,16,24,12">
                                            <ContentPresenter ContentSource="SelectedContent"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        
                        <TabControl.Resources>
                            <!-- Custom styled TabItem to behave like modern sidebar options -->
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FF8080A8"/>
                                <Setter Property="Padding" Value="18,11,18,11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="4,0,0,0"
                                                    BorderBrush="Transparent"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="0,1,0,1">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  TextElement.FontSize="12"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  TextElement.FontFamily="{DynamicResource AppFont}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#12FFFFFF"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#0AFFFFFF"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#16FFFFFF"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- ══ RECORDING TAB ════════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabGeneral}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc RecConfigHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc RecConfigSubtitle}" FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Recording Format Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc RecFormatGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Codec Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc CodecLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc CodecDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CodecCombo" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="CodecCombo_SelectionChanged"/>
                                        </Grid>
                                        
                                        <!-- Info label block -->
                                        <TextBlock x:Name="CodecInfoText"
                                                   TextWrapping="Wrap"
                                                   Foreground="#FF606090"
                                                   FontSize="11"
                                                   Margin="0,4,0,10"/>
                                                   
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Non-Destructive Mode -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc NonDestructiveLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc NonDestructiveDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="NewRecordingsNonDestructiveCheck" Grid.Column="1" VerticalAlignment="Center" Checked="NewRecordingsNonDestructiveCheck_Checked" Unchecked="NewRecordingsNonDestructiveCheck_Unchecked"/>
                                        </Grid>

                                        <StackPanel x:Name="VstSettingsPanel" Visibility="Collapsed">
                                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                            <!-- VST2 Plugin Path -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="VST2 Plugin Path" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="Select a .dll VST2 plugin to be available in the Audio Editor." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" Width="200" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="VstPluginPathTextBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0" IsReadOnly="True" Background="#0CFFFFFF" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource DividerBrush}"/>
                                                    <Button x:Name="BrowseVstButton" Grid.Column="1" Content="..." Width="30" Height="26" Click="BrowseVstButton_Click"/>
                                                </Grid>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                            <!-- VST3 Plugin Path -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="VST3 Plugin Path" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="Select a .vst3 plugin to be available in the Audio Editor." FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" Width="200" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="Vst3PluginPathTextBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0" IsReadOnly="True" Background="#0CFFFFFF" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource DividerBrush}"/>
                                                    <Button x:Name="BrowseVst3Button" Grid.Column="1" Content="..." Width="30" Height="26" Click="BrowseVst3Button_Click"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Loudness Normalization Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc LoudnessNormGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Auto Normalize toggle -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc AutoNormLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc AutoNormDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoNormalizeCheck" Grid.Column="1" VerticalAlignment="Center" Checked="AutoNormalizeCheck_Changed" Unchecked="AutoNormalizeCheck_Changed"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Target LUFS slider -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="250"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc TargetLoudnessLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc TargetLoudnessDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Slider x:Name="TargetLufsSlider" Width="150" Minimum="-24.0" Maximum="-6.0" Value="-14.0" TickFrequency="1.0" SmallChange="0.5" LargeChange="1.0" ValueChanged="TargetLufsSlider_ValueChanged" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TargetLufsValueText" Text="-14.0 LUFS" Width="80" Margin="8,0,0,0" TextAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Buffer Recording Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc BufferRecGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Duration Slider Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="240"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc PastBufferLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc PastBufferDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="240">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="BufferDurationSlider" Grid.Column="0" Minimum="0.5" Maximum="60" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="BufferDurationSlider_Changed"/>
                                                <TextBlock x:Name="BufferDurationLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="10s" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </Grid>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Hotkey Modifiers Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc BufferHotkeyLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc BufferHotkeyDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="ModCtrl" Content="Ctrl" Margin="0,0,14,0"/>
                                                <CheckBox x:Name="ModAlt" Content="Alt" Margin="0,0,14,0"/>
                                                <CheckBox x:Name="ModShift" Content="Shift"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Hotkey Key Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc BufferHotkeyLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc BufferHotkeyDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="HotkeyKeyBox" Grid.Column="1" Width="200" Height="28" IsReadOnly="True" Cursor="Hand" TextAlignment="Center" ToolTip="Click then press any key to assign" PreviewKeyDown="HotkeyKeyBox_PreviewKeyDown" GotFocus="HotkeyKeyBox_GotFocus" LostFocus="HotkeyKeyBox_LostFocus" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Auto-Cleanup Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc DiskCleanupGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="240"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{p:Loc MaxRecordsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{p:Loc MaxRecordsDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="240">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="MaxRecordsSlider" Grid.Column="0" Minimum="0" Maximum="500" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="MaxRecordsSlider_Changed"/>
                                            <TextBlock x:Name="MaxRecordsLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="∞" Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="0 = unlimited. Favorites are never auto-deleted."/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ NAMING TAB ══════════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE134;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabNaming}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc NamingHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc NamingSubtitle}" FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Naming Options Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc PadNamingGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Template Title -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc TitleTemplateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc TitleTemplateDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="DefaultPadTitleBox" Grid.Column="1" Width="220" Height="28" ToolTip="Use placeholders: {timestamp}, {codec}, {app}." VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Focused App Name -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc IncludeAppLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc IncludeAppDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="UseFocusedAppNameCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AI Speech to Text Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc SpeechGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Auto Rename Checkbox -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc AutoRenameSpeechLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc AutoRenameSpeechDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoRenameSpeechCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Model Selection Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="260"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc WhisperModelLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc WhisperModelDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="260">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="SpeechModelCombo" Grid.Column="0" SelectionChanged="SpeechModelCombo_SelectionChanged" VerticalAlignment="Center"/>
                                                <Button x:Name="DownloadModelBtn" Grid.Column="1" Content="{p:Loc Download}" Margin="8,0,0,0" Padding="12,0" Height="28" Click="DownloadModelBtn_Click" VerticalAlignment="Center"/>
                                                <Button x:Name="UninstallModelBtn" Grid.Column="1" Content="{p:Loc Remove}" Margin="8,0,0,0" Padding="12,0" Height="28" Click="UninstallModelBtn_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Model download stats -->
                                        <ProgressBar x:Name="ModelDownloadProgress" Height="6" Margin="0,4,0,8" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                                        <TextBlock x:Name="ModelDownloadStatusText" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed" Foreground="{DynamicResource AccentAmberBrush}"/>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Whisper Language Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc WhisperLangLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc WhisperLangDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="SpeechLanguageBox" Grid.Column="1" Width="200" Height="28" ToolTip="Language code, e.g. en, fr, de, or 'auto' to detect." VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- CUDA GPU Support -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc CudaLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc CudaDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="UseCudaCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="CudaStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ PLAYBACK TAB ═════════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabAudio}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc AudioDevicesHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc AudioDevicesSubtitle}" FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Trim Editor Output Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc TrimOutputGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <!-- Playback device selection -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{p:Loc TrimOutputLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{p:Loc TrimOutputDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="TrimOutputDeviceCombo" Grid.Column="1" Width="260" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ APPEARANCE TAB ═══════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabAppearance}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc AppearanceHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc AppearanceSubtitle}" FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Language Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc LanguageSetting}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{p:Loc LanguageSetting}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{p:Loc SelectLanguageDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="LanguageCombo_SelectionChanged">
                                            <ComboBoxItem x:Name="LangEnItem" Content="{p:Loc LanguageEnglish}" Tag="en"/>
                                            <ComboBoxItem x:Name="LangFrItem" Content="{p:Loc LanguageFrench}" Tag="fr"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Font Variant Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc FontGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <!-- Font selection -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{p:Loc FontLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{p:Loc FontDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="FontVariantCombo" Grid.Column="1" Width="200" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Theme Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc ThemeGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Overall Theme Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc ThemeLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc ThemeDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Meter Skin Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc MeterSkinLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc MeterSkinDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="MeterSkinCombo" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="MeterSkinCombo_SelectionChanged"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- LED dots -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc DigitalDotsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc DigitalDotsDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="MeterDigitalDotsCheck" Grid.Column="1" VerticalAlignment="Center" Checked="MeterDigitalDotsCheck_Changed" Unchecked="MeterDigitalDotsCheck_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Performance Mode Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc PerfGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel Margin="0,6">
                                        <!-- Low-resource performance mode -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc PerfModeLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc PerfModeDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="PerformanceModeCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Divider -->
                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,10"/>

                                        <!-- Pause animations when unfocused -->
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc PauseAnimLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc PauseAnimDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="PauseAnimationsWhenUnfocusedCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ SYSTEM TAB ═══════════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabSystem}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc SystemHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc SystemSubtitle}" FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- System Tray Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc TrayGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Minimize to tray -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc MinTrayLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc MinTrayDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="MinimizeToTrayCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Close to tray -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc CloseTrayLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc CloseTrayDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="CloseToTrayCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Start minimized -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc StartMinLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc StartMinDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="StartMinimizedCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- OS Startup and Update Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc StartupGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Windows Startup -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc RunStartupLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc RunStartupDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="RunOnStartupCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Silent Auto Updates -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc AutoUpdateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc AutoUpdateDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoInstallUpdatesCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Download Beta Updates -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc BetaUpdateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc BetaUpdateDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="DownloadBetaUpdatesCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ THIRD PARTY TAB ════════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabThirdParty}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc ThirdPartyHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc ThirdPartySubtitle}" FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Hardware Integrations Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc StreamDeckGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <!-- Stream deck plugin installation -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{p:Loc StreamDeckLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{p:Loc StreamDeckDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="InstallStreamDeckBtn" Grid.Column="1" Content="{p:Loc InstallStreamDeckBtn}" Width="220" Height="28" Click="InstallStreamDeckBtn_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Discord Group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc DiscordGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Discord Check -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc DiscordLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc DiscordDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="DiscordRichPresenceCheck" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Client ID -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc DiscordClientIdLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc DiscordClientIdDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="DiscordClientIdBox" Grid.Column="1" Width="220" Height="28" ToolTip="Custom Application ID from Discord Developer Portal. Default test ID is 461618159171141643." VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ══ BACKUP & RESTORE TAB ═════════════════════════════ -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{p:Loc SettingsTabBackup}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="{p:Loc BackupHeader}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{p:Loc BackupSubtitle}" FontSize="11" Foreground="#FF8080A8" Margin="0,0,0,16"/>

                                <!-- Backup and Restore operations group -->
                                <StackPanel Style="{StaticResource GroupHeader}">
                                    <Rectangle Style="{StaticResource HeaderAccentBar}"/>
                                    <TextBlock Text="{p:Loc DataMgmtGroup}" Style="{StaticResource HeaderText}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Backup Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc BackupLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc BackupDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="BackupButton" Grid.Column="1" Content="{p:Loc BackupBtn}" Width="200" Height="28" Click="ExportData_Click" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                                        <!-- Restore Row -->
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{p:Loc RestoreLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{p:Loc RestoreDesc}" FontSize="11" Foreground="#FF8080A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="RestoreButton" Grid.Column="1" Content="{p:Loc RestoreBtn}" Width="200" Height="28" Click="ImportData_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- Footer Section at the bottom right content column -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Padding="24,12,24,16"
                            Background="{DynamicResource SecondaryFooterBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{p:Loc OK}"
                                    Width="88"
                                    Margin="0,0,10,0"
                                    Click="OkButton_Click"
                                    IsDefault="True"
                                    Foreground="{DynamicResource AccentGreenBrush}"/>
                            <Button Content="{p:Loc Cancel}"
                                    Width="88"
                                    Click="CancelButton_Click"
                                    IsCancel="True"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <controls:LoadingOverlay x:Name="SettingsLoadingOverlay" Background="#CC0A0A12" Grid.RowSpan="2" Panel.ZIndex="100"/>
            </Grid>
        </Border>
    </Grid>
</Window>
