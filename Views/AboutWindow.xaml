<Window x:Class="PaDDY.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About PaDDY"
        Icon="/PaDDY.ico"
        Width="480" Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                      GlassFrameThickness="5"
                      ResizeBorderThickness="10"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="10">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0">
                    <Grid>
                        <TextBlock Text="About PaDDY"
                                   Foreground="#FF8080A8"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTip="Close"
                                Click="ChromeClose_Click">
                                <Button.Effect>
                                    <DropShadowEffect Color="#FFFF5555" BlurRadius="8" ShadowDepth="0"/>
                                </Button.Effect>
                            <TextBlock Text="&#x2715;" FontSize="14" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 — Logo / header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,20">
                        <StackPanel.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="16" Color="#FF4CAF50" Opacity="0.35"/>
                        </StackPanel.Effect>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Pa" Foreground="#FF7070A8" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="DDY" Foreground="#FF4CAF50" FontSize="30" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="VersionLabel"
                                   Text="v0.0.0"
                                   Foreground="#FF505080"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                        <TextBlock x:Name="AuthorLabel"
                                   Text="© 2020-2026 NoID Softwork. All Rights Reserved."
                                   Foreground="#FF505080"
                                   FontSize="9"
                                   Margin="0,2,0,0"                                
                                   HorizontalAlignment="Center"/>           
                    </StackPanel>

                    <!-- Row 1 — Content card -->
                    <Border Grid.Row="1"
                            Style="{StaticResource GlassCard}"
                            Padding="18,16">
                        <StackPanel>

                            <!-- Description -->
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#FFBBBBD8"
                                       FontSize="12"
                                       LineHeight="20"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center">
                              
                                <Run>PaDDY is a lightweight audio pad recorder that continuously listens to your microphone or system audio and lets you capture the last few seconds on demand.</Run>
                            </TextBlock>

                            <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,14,0,14"/>

                            <!-- Keyboard shortcuts heading -->
                            <TextBlock Text="KEYBOARD SHORTCUTS"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,10"/>

                            <!-- Shortcut rows -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Save buffer to pad" Foreground="#FF9090B8" FontSize="11"/>
                                <Border Grid.Column="1" Background="#FF0C0C18" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="Ctrl + F9 (DEFAULT)" Foreground="#FFB0B0CC" FontSize="11" FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                            
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Edit selected pad" Foreground="#FF9090B8" FontSize="11"/>
                                <Border Grid.Column="1" Background="#FF0C0C18" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="E" Foreground="#FFB0B0CC" FontSize="11" FontFamily="Consolas"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rename selected pad" Foreground="#FF9090B8" FontSize="11"/>
                                <Border Grid.Column="1" Background="#FF0C0C18" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="R" Foreground="#FFB0B0CC" FontSize="11" FontFamily="Consolas"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Monitor selected pad" Foreground="#FF9090B8" FontSize="11"/>
                                <Border Grid.Column="1" Background="#FF0C0C18" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="MOUSE RIGHT-CLICK" Foreground="#FFB0B0CC" FontSize="11" FontFamily="Consolas"/>
                                </Border>
                            </Grid>    

                            <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,14,0,14"/>

                            <!-- Credits link and button -->
                            <Button x:Name="CreditsButton"
                                    Content="View open-source credits..."
                                    HorizontalAlignment="Left"
                                    Click="CreditsButton_Click"/>
                            
                            <Button Content="Visit GitHub Repository"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    Click="GitHubButton_Click"/>
                            
                            <Button x:Name="BackupButton"
                                    Content="Backup"
                                    HorizontalContentAlignment="Center"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    IsEnabled="True"
                                    Click="ExportData_Click"/>

                            <Button x:Name="RestoreButton"
                                    Content="Restore"
                                    HorizontalContentAlignment="Center"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    IsEnabled="True"
                                    Click="ImportData_Click"/>        
                            
                            <Border x:Name="DevVisualizerBorder" Visibility="Collapsed" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="6" Height="60" Margin="0,10,0,10" Background="#11FFFFFF" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="VisualizerImage" Stretch="Fill" />
                                    <TextBlock Text="DirectX 11 Interop Active" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <Button x:Name="CloseButton"
                                    Content="Close"
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    IsCancel="True"
                                    Click="CloseButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
