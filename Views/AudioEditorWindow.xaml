<Window x:Class="PaDDY.AudioEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PaDDY.Controls"
        xmlns:p="clr-namespace:PaDDY.Helpers"
        Title="Audio Editor &amp; Trim"
        Icon="/PaDDY.ico"
        Width="1380" Height="860"
        MinWidth="1150" MinHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#0F1118"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="5"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Custom Button Styles -->
        <Style x:Key="EditorBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#1C1F2E"/>
            <Setter Property="Foreground" Value="#E0E4F0"/>
            <Setter Property="BorderBrush" Value="#2C3044"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#282C40"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3D4260"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#141724"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Green Accent) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource EditorBtn}">
            <Setter Property="Background" Value="#1C2E24"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="BorderBrush" Value="#2A4C3A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#243C2E"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14221A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rack Card Style -->
        <Style x:Key="DawCard" TargetType="Border">
            <Setter Property="Background" Value="#161824"/>
            <Setter Property="BorderBrush" Value="#222636"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Dynamic Handle Control Template -->
        <ControlTemplate x:Key="DawHandleTemplate" TargetType="Thumb">
            <Grid Background="Transparent" Width="16">
                <!-- Vertical green trim marker line -->
                <Border Width="2" Background="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                <!-- Top grip head -->
                <Border Width="12" Height="16" Background="{DynamicResource AccentGreenBrush}" CornerRadius="3" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock Text="||" Foreground="#0F1118" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Bottom grip head -->
                <Border Width="12" Height="16" Background="{DynamicResource AccentGreenBrush}" CornerRadius="3" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <TextBlock Text="||" Foreground="#0F1118" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <!-- Main Root Container -->
        <Border Style="{StaticResource SecondaryWindowFrame}" Margin="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>   <!-- Row 0: Custom Title Bar -->
                    <RowDefinition Height="*"/>    <!-- Row 1: 3-Column Main Editor Body -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Bottom Action Footer Bar -->
                </Grid.RowDefinitions>

                <!-- Row 0: Custom Title Bar -->
                <Border Grid.Row="0"
                        Background="#12141F"
                        BorderBrush="#1E2232"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="🎛" FontSize="13" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Audio Editor &amp; Trim"
                                       Foreground="#E2E6F2"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTip="Close"
                                Click="ChromeClose_Click">
                            <TextBlock Text="&#xE8BB;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 1: Main 3-Column Studio Workspace -->
                <Grid Grid.Row="1" Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" MinWidth="170"/> <!-- Column 0: Left PROJECTS Sidebar -->
                        <ColumnDefinition Width="8"/>                  <!-- Gap -->
                        <ColumnDefinition Width="*"/>                  <!-- Column 1: Center Waveform & Effects Grid -->
                        <ColumnDefinition Width="8"/>                  <!-- Gap -->
                        <ColumnDefinition Width="290" MinWidth="250"/> <!-- Column 2: Right EFFECTS & MASTER BUS Sidebar -->
                    </Grid.ColumnDefinitions>

                    <!-- ═══════════════════════════════════════════════════════════════
                         COLUMN 0: Left PROJECTS Sidebar
                    ═══════════════════════════════════════════════════════════════ -->
                    <Border Grid.Column="0" Style="{StaticResource DawCard}" Padding="10,10,8,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Sidebar Header -->
                            <Grid Grid.Row="0" Margin="2,0,2,10">
                                <TextBlock Text="PROJECTS"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#8A92A8"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="⋮"
                                           FontSize="14"
                                           Foreground="#6C748C"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Cursor="Hand"/>
                            </Grid>

                            <!-- Project Items Tree / List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ProjectsContainer">
                                    <!-- Projects Folder Root -->
                                    <StackPanel Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                            <TextBlock Text="📁" FontSize="11" Foreground="#6C748C" Margin="0,0,6,0"/>
                                            <TextBlock Text="Projects" FontSize="11.5" FontWeight="SemiBold" Foreground="#D0D5E5"/>
                                        </StackPanel>

                                        <!-- Folder Sub-item -->
                                        <StackPanel Margin="14,2,0,4">
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                <TextBlock Text="› 📁" FontSize="10.5" Foreground="#6C748C" Margin="0,0,6,0"/>
                                                <TextBlock Text="Folder" FontSize="11" Foreground="#B0B8CC"/>
                                            </StackPanel>

                                            <!-- Track Sub-folder -->
                                            <StackPanel Margin="14,2,0,4">
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                    <TextBlock Text="› 📁" FontSize="10.5" Foreground="#6C748C" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Track" FontSize="11" Foreground="#B0B8CC"/>
                                                </StackPanel>

                                                <!-- Track File Items -->
                                                <StackPanel Margin="14,2,0,0">
                                                    <Border Padding="6,4" Margin="0,1" CornerRadius="4" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📄" FontSize="10" Foreground="#5C647C" Margin="0,0,6,0"/>
                                                            <TextBlock Text="That hurt my feelings" FontSize="11" Foreground="#A0A8C0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Selected Highlight Active Item -->
                                                    <Border Padding="6,4" Margin="0,1" CornerRadius="4" Background="#1C3828" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📄" FontSize="10" Foreground="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                            <TextBlock x:Name="SidebarActiveFileLabel" Text="That hurt my feelings" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Padding="6,4" Margin="0,1" CornerRadius="4" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📄" FontSize="10" Foreground="#5C647C" Margin="0,0,6,0"/>
                                                            <TextBlock Text="That hurt my feelings" FontSize="11" Foreground="#A0A8C0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Padding="6,4" Margin="0,1" CornerRadius="4" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📄" FontSize="10" Foreground="#5C647C" Margin="0,0,6,0"/>
                                                            <TextBlock Text="That hurt my feelings" FontSize="11" Foreground="#A0A8C0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Padding="6,4" Margin="0,1" CornerRadius="4" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📄" FontSize="10" Foreground="#5C647C" Margin="0,0,6,0"/>
                                                            <TextBlock Text="List.rstr" FontSize="11" Foreground="#8088A0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>


                    <!-- ═══════════════════════════════════════════════════════════════
                         COLUMN 1: Center Main Waveform Display & Inline Effects
                    ═══════════════════════════════════════════════════════════════ -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="240" MinHeight="160"/> <!-- Row 0: Waveform Stage -->
                            <RowDefinition Height="Auto"/>               <!-- Row 1: Timeline Ruler Strip & Trim Handles -->
                            <RowDefinition Height="*"/>                  <!-- Row 2: 2-Column Inline Effects Rack -->
                        </Grid.RowDefinitions>

                        <!-- Row 0 — Waveform Display Container -->
                        <Border Grid.Row="0"
                                Background="#0E1017"
                                BorderBrush="#222636"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Top Info Header Overlay inside Waveform Box -->
                                <Grid VerticalAlignment="Top" Margin="12,10,12,0" Panel.ZIndex="10">
                                    <TextBlock x:Name="FileNameLabel"
                                               Text="That hurt my feelings."
                                               Foreground="#E6EAFA"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TotalDurationLabel"
                                               Text="1.6s"
                                               Foreground="#8C94AC"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Main Waveform ScrollViewer -->
                                <ScrollViewer x:Name="WaveformScrollViewer"
                                              Margin="0,32,0,0"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled"
                                              SizeChanged="WaveformScrollViewer_SizeChanged">
                                    <Grid x:Name="WaveformGrid">
                                        <!-- Fine Grid Lines -->
                                        <Grid x:Name="GridLines" IsHitTestVisible="False" Opacity="0.07">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="1" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="2" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="3" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="4" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="5" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="6" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="7" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="8" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="9" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="10" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="11" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="12" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                        </Grid>
                                        <Grid x:Name="HorizontalGridLines" IsHitTestVisible="False" Opacity="0.05">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"/>
                                            <Border Grid.Row="1" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"/>
                                            <Border Grid.Row="2" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"/>
                                        </Grid>

                                        <!-- Waveform Graphic -->
                                        <Image x:Name="WaveformImage"
                                               Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                        <!-- Unselected Regions Overlays -->
                                        <Border x:Name="LeftOverlay" Background="#0C0E14" Opacity="0.65" HorizontalAlignment="Left" Width="0"/>
                                        <Border x:Name="RightOverlay" Background="#0C0E14" Opacity="0.65" HorizontalAlignment="Right" Width="0"/>

                                        <!-- Playhead Cursor Line -->
                                        <Border x:Name="PlaybackLine" Width="16" HorizontalAlignment="Left" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="PlaybackLineTransform" X="0"/>
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Border Width="1.5" Background="{DynamicResource AccentAmberBrush}" HorizontalAlignment="Center"/>
                                                <Path Data="M3,0 L13,0 L8,8 Z" Fill="{DynamicResource AccentAmberBrush}" Width="16" Height="8" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Hidden vertical meter host for data compatibility -->
                                <Grid x:Name="VertMeterHost" Visibility="Collapsed"/>

                                <!-- Floating Transport Console (Anchored Bottom Center of Waveform Container) -->
                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Panel.ZIndex="20">
                                    <Border Background="#161824" BorderBrush="#2C3044" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Preview / Play Button -->
                                            <Button x:Name="PlayBtn"
                                                    Style="{StaticResource PrimaryBtn}"
                                                    Content="▶ Preview"
                                                    Height="28"
                                                    Padding="12,0"
                                                    FontSize="11.5"
                                                    Click="PlayBtn_Click"/>

                                            <!-- Transport Step Buttons -->
                                            <Button Content="❚◄" Style="{StaticResource EditorBtn}" Height="28" Width="30" Padding="0" Margin="6,0,2,0"/>
                                            <Button Content="►❚" Style="{StaticResource EditorBtn}" Height="28" Width="30" Padding="0" Margin="2,0,10,0"/>

                                            <!-- Zoom Control -->
                                            <TextBlock Text="Zoom:" Foreground="#8A92A8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Slider x:Name="ZoomSlider"
                                                    Minimum="1" Maximum="10" Value="1"
                                                    Width="85" Height="22"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="ZoomSlider_ValueChanged"/>
                                            <TextBlock x:Name="ZoomLabel" Text="1.0x" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" Width="32"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Row 1 — Timeline Ruler & Trim Handle Strip -->
                        <Border Grid.Row="1" Margin="0,6,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <!-- Time Markers Row -->
                                <Grid Grid.Row="0" Margin="4,0">
                                    <TextBlock x:Name="StartTimeLabel" Text="0.00s" Foreground="#8A92A8" FontSize="10.5" HorizontalAlignment="Left"/>
                                    <TextBlock Text="0.20s" Foreground="#5C647C" FontSize="10" HorizontalAlignment="Left" Margin="100,0,0,0"/>
                                    <TextBlock Text="0.40s" Foreground="#5C647C" FontSize="10" HorizontalAlignment="Left" Margin="200,0,0,0"/>
                                    <TextBlock x:Name="TrimmedDurationLabel" Text="0.60s" Foreground="#8A92A8" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="0.80s" Foreground="#5C647C" FontSize="10" HorizontalAlignment="Right" Margin="0,0,200,0"/>
                                    <TextBlock Text="1.20s" Foreground="#5C647C" FontSize="10" HorizontalAlignment="Right" Margin="0,0,100,0"/>
                                    <TextBlock x:Name="EndTimeLabel" Text="1.60s" Foreground="#8A92A8" FontSize="10.5" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Trim Selection Bar & Handles -->
                                <Grid Grid.Row="1">
                                    <Border Background="#141724" BorderBrush="#222636" BorderThickness="1" CornerRadius="4"/>

                                    <!-- Left Trim Handle -->
                                    <Thumb x:Name="LeftHandle"
                                           Width="16"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch"
                                           Cursor="SizeWE"
                                           DragDelta="LeftHandle_DragDelta"
                                           Template="{StaticResource DawHandleTemplate}"/>

                                    <!-- Right Trim Handle -->
                                    <Thumb x:Name="RightHandle"
                                           Width="16"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           Cursor="SizeWE"
                                           DragDelta="RightHandle_DragDelta"
                                           Template="{StaticResource DawHandleTemplate}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Row 2 — 2-Column Inline Studio Effects Rack Chassis -->
                        <Border Grid.Row="2" Style="{StaticResource DawCard}" Padding="10">
                            <ScrollViewer x:Name="EffectsRackScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- COLUMN 1: Fade & Noise Gate -->
                                    <StackPanel Grid.Column="0">
                                        <!-- Fade In / Fade Out Card -->
                                        <Border Style="{StaticResource DawCard}" Background="#121420">
                                            <StackPanel>
                                                <!-- Header -->
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Fade In / Fade Out" FontSize="11.5" FontWeight="Bold" Foreground="#E2E6F2"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="#6C748C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="FadeEnabledCheck" HorizontalAlignment="Right" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </Grid>

                                                <!-- Controls -->
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Fade In (ms)" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="FadeInSlider" Minimum="0" Maximum="5000" Value="500" TickFrequency="100" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="FadeInLabel" Text="500" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Fade Out (ms)" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="FadeOutSlider" Minimum="0" Maximum="5000" Value="500" TickFrequency="100" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="FadeOutLabel" Text="500" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Noise Gate Card -->
                                        <Border Style="{StaticResource DawCard}" Background="#121420">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Noise Gate" FontSize="11.5" FontWeight="Bold" Foreground="#E2E6F2"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="#6C748C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="GateEnabledCheck" HorizontalAlignment="Right" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Threshold (dB)" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="GateThresholdSlider" Minimum="-80" Maximum="0" Value="-40" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="GateThresholdLabel" Text="-40" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Attack (ms)" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="GateAttackSlider" Minimum="1" Maximum="200" Value="10" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="GateAttackLabel" Text="10" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Release (ms)" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="GateReleaseSlider" Minimum="10" Maximum="1000" Value="100" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="GateReleaseLabel" Text="100" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- COLUMN 2: Distortion & Echo -->
                                    <StackPanel Grid.Column="2">
                                        <!-- Distortion Card -->
                                        <Border Style="{StaticResource DawCard}" Background="#121420">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Distortion" FontSize="11.5" FontWeight="Bold" Foreground="#E2E6F2"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="#6C748C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="DistortionEnabledCheck" Content="Enable" HorizontalAlignment="Right" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Drive" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="DistDriveSlider" Minimum="1" Maximum="50" Value="8" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="DistDriveLabel" Text="8" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Mix (wet)" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="DistMixSlider" Minimum="0" Maximum="1" Value="0.80" TickFrequency="0.05" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="DistMixLabel" Text="0.80" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Output" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="DistOutputSlider" Minimum="0" Maximum="1" Value="0.00" TickFrequency="0.05" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="DistOutputLabel" Text="0.00" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Echo Card -->
                                        <Border Style="{StaticResource DawCard}" Background="#121420">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Echo" FontSize="11.5" FontWeight="Bold" Foreground="#E2E6F2"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="#6C748C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="EchoEnabledCheck" Content="Enable" HorizontalAlignment="Right" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Delay (ms)" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="EchoDelaySlider" Minimum="50" Maximum="2000" Value="200" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="EchoDelayLabel" Text="200" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Feedback" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="EchoFeedbackSlider" Minimum="0" Maximum="0.95" Value="0.30" TickFrequency="0.05" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="EchoFeedbackLabel" Text="0.30" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Mix (wet)" FontSize="11" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="EchoMixSlider" Minimum="0" Maximum="1" Value="0.40" TickFrequency="0.05" Height="22" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="EchoMixLabel" Text="0.40" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Hidden backing elements for full feature compatibility -->
                                        <StackPanel Visibility="Collapsed">
                                            <TextBlock x:Name="PlaybackTimecodeLabel"/>
                                            <Slider x:Name="GainSlider" Minimum="-24" Maximum="24" Value="0" ValueChanged="GainSlider_ValueChanged"/>
                                            <TextBlock x:Name="GainLabel"/>
                                            <CheckBox x:Name="EqEnabledCheck"/>
                                            <Slider x:Name="EqSubBassSlider"/><TextBlock x:Name="EqSubBassLabel"/>
                                            <Slider x:Name="EqBassSlider"/><TextBlock x:Name="EqBassLabel"/>
                                            <Slider x:Name="EqMidSlider"/><TextBlock x:Name="EqMidLabel"/>
                                            <Slider x:Name="EqPresenceSlider"/><TextBlock x:Name="EqPresenceLabel"/>
                                            <Slider x:Name="EqTrebleSlider"/><TextBlock x:Name="EqTrebleLabel"/>
                                            <CheckBox x:Name="CompressorEnabledCheck"/>
                                            <Slider x:Name="CompThresholdSlider"/><TextBlock x:Name="CompThresholdLabel"/>
                                            <Slider x:Name="CompRatioSlider"/><TextBlock x:Name="CompRatioLabel"/>
                                            <Slider x:Name="CompAttackSlider"/><TextBlock x:Name="CompAttackLabel"/>
                                            <Slider x:Name="CompReleaseSlider"/><TextBlock x:Name="CompReleaseLabel"/>
                                            <Slider x:Name="CompMakeupSlider"/><TextBlock x:Name="CompMakeupLabel"/>
                                            <CheckBox x:Name="ReverbEnabledCheck"/>
                                            <Slider x:Name="ReverbRoomSlider"/><TextBlock x:Name="ReverbRoomLabel"/>
                                            <Slider x:Name="ReverbDampingSlider"/><TextBlock x:Name="ReverbDampingLabel"/>
                                            <Slider x:Name="ReverbMixSlider"/><TextBlock x:Name="ReverbMixLabel"/>
                                            <CheckBox x:Name="PitchShiftEnabledCheck"/>
                                            <Slider x:Name="PitchShiftSemitonesSlider"/><TextBlock x:Name="PitchShiftSemitonesLabel"/>
                                            <Slider x:Name="PitchShiftGrainSizeSlider"/><TextBlock x:Name="PitchShiftGrainSizeLabel"/>
                                            <Slider x:Name="PitchShiftMixSlider"/><TextBlock x:Name="PitchShiftMixLabel"/>
                                            <CheckBox x:Name="RemasterEnabledCheck"/>
                                            <ComboBox x:Name="RemasterPresetCombo" SelectionChanged="RemasterPresetCombo_SelectionChanged">
                                                <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
                                            </ComboBox>
                                            <Slider x:Name="RemasterWarmthSlider"/><TextBlock x:Name="RemasterWarmthLabel"/>
                                            <Slider x:Name="RemasterPunchSlider"/><TextBlock x:Name="RemasterPunchLabel"/>
                                            <Slider x:Name="RemasterBrillianceSlider"/><TextBlock x:Name="RemasterBrillianceLabel"/>
                                            <Slider x:Name="RemasterWidthSlider"/><TextBlock x:Name="RemasterWidthLabel"/>
                                            <Slider x:Name="RemasterDriveSlider"/><TextBlock x:Name="RemasterDriveLabel"/>
                                            <Slider x:Name="RemasterRatioSlider"/><TextBlock x:Name="RemasterRatioLabel"/>
                                            <Slider x:Name="RemasterCeilingSlider"/><TextBlock x:Name="RemasterCeilingLabel"/>
                                            <Border x:Name="VstSection"><StackPanel><TextBlock x:Name="VstNameLabel"/><Button x:Name="ShowVstEditorButton"/></StackPanel></Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>


                    <!-- ═══════════════════════════════════════════════════════════════
                         COLUMN 2: Right EFFECTS & MASTER BUS Sidebar
                    ═══════════════════════════════════════════════════════════════ -->
                    <Border Grid.Column="4" Style="{StaticResource DawCard}" Padding="10,10,10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Sidebar Header -->
                            <Grid Grid.Row="0" Margin="2,0,2,10">
                                <TextBlock Text="EFFECTS"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#8A92A8"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="▾"
                                           FontSize="12"
                                           Foreground="#6C748C"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Cursor="Hand"/>
                            </Grid>

                            <!-- Side Cards List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- Side Card 1: Fade In / Fade Out -->
                                    <Border Style="{StaticResource DawCard}" Background="#121420" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Fade In / Fade Out" FontSize="11.5" FontWeight="Bold" Foreground="#E2E6F2"/>
                                                    <TextBlock Text="▾" FontSize="10" Foreground="#6C748C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox IsChecked="{Binding ElementName=FadeEnabledCheck, Path=IsChecked, Mode=TwoWay}" HorizontalAlignment="Right" Style="{StaticResource RackPowerSwitch}"/>
                                            </Grid>

                                            <!-- Sliders -->
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Fade In (ms)" FontSize="10.5" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="5000" Value="{Binding ElementName=FadeInSlider, Path=Value, Mode=TwoWay}" TickFrequency="100" Height="20" Margin="4,0"/>
                                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                    <TextBlock Text="{Binding ElementName=FadeInSlider, Path=Value, StringFormat={}{0:F0}}" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Fade Out (ms)" FontSize="10.5" Foreground="#A0A8C0" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="5000" Value="{Binding ElementName=FadeOutSlider, Path=Value, Mode=TwoWay}" TickFrequency="100" Height="20" Margin="4,0"/>
                                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                    <TextBlock Text="{Binding ElementName=FadeOutSlider, Path=Value, StringFormat={}{0:F0}}" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Side Card 2: Distortion (with 3 Rotary Dials!) -->
                                    <Border Style="{StaticResource DawCard}" Background="#121420" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Distortion" FontSize="11.5" FontWeight="Bold" Foreground="#E2E6F2"/>
                                                    <TextBlock Text="▾" FontSize="10" Foreground="#6C748C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox IsChecked="{Binding ElementName=DistortionEnabledCheck, Path=IsChecked, Mode=TwoWay}" HorizontalAlignment="Right" Style="{StaticResource RackPowerSwitch}"/>
                                            </Grid>

                                            <!-- Rotary Knobs -->
                                            <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,6,0,2">
                                                <controls:KnobControl Label="Drive" Minimum="1" Maximum="50" Step="1" Value="{Binding ElementName=DistDriveSlider, Path=Value, Mode=TwoWay}"/>
                                                <controls:KnobControl Label="Mix (wet)" Minimum="0" Maximum="1" Step="0.05" Value="{Binding ElementName=DistMixSlider, Path=Value, Mode=TwoWay}"/>
                                                <controls:KnobControl Label="Output" Minimum="0" Maximum="1" Step="0.05" Value="{Binding ElementName=DistOutputSlider, Path=Value, Mode=TwoWay}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Side Card 3: Echo (with 3 Rotary Dials!) -->
                                    <Border Style="{StaticResource DawCard}" Background="#121420" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Echo" FontSize="11.5" FontWeight="Bold" Foreground="#E2E6F2"/>
                                                    <TextBlock Text="▾" FontSize="10" Foreground="#6C748C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox IsChecked="{Binding ElementName=EchoEnabledCheck, Path=IsChecked, Mode=TwoWay}" HorizontalAlignment="Right" Style="{StaticResource RackPowerSwitch}"/>
                                            </Grid>

                                            <!-- Rotary Knobs -->
                                            <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,6,0,2">
                                                <controls:KnobControl Label="Delay (ms)" Minimum="50" Maximum="2000" Step="10" Value="{Binding ElementName=EchoDelaySlider, Path=Value, Mode=TwoWay}"/>
                                                <controls:KnobControl Label="Feedback" Minimum="0" Maximum="0.95" Step="0.05" Value="{Binding ElementName=EchoFeedbackSlider, Path=Value, Mode=TwoWay}"/>
                                                <controls:KnobControl Label="Mix (wet)" Minimum="0" Maximum="1" Step="0.05" Value="{Binding ElementName=EchoMixSlider, Path=Value, Mode=TwoWay}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Side Card 4: Master Bus Panel -->
                                    <Border Style="{StaticResource DawCard}" Background="#121420" Margin="0,0,0,4">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Master Bus" FontSize="11.5" FontWeight="Bold" Foreground="#E2E6F2"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Arc Gauge Master Gain Meter -->
                                            <controls:ArcGaugeControl Minimum="-24" Maximum="24" Value="{Binding ElementName=GainSlider, Path=Value, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,4,0,8"/>

                                            <!-- Dynamic Audio Spectrum Visualizer -->
                                            <controls:SpectrumVisualizerControl x:Name="MasterSpectrumVisualizer" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 2: Bottom Footer Action Bar -->
                <Border Grid.Row="2"
                        Background="#12141F"
                        BorderBrush="#1E2232"
                        BorderThickness="0,1,0,0"
                        Padding="14,8">
                    <Grid>
                        <!-- Left Options Checkboxes -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="SaveToFavCheckBox" Content="Add to Favourites" Foreground="#C0C8DC" FontSize="11.5" Margin="0,0,18,0"/>
                            <CheckBox x:Name="NonDestructiveCheckBox" Content="Non-Destructive Playback" IsChecked="True" Foreground="#C0C8DC" FontSize="11.5" Checked="NonDestructiveCheckBox_Checked" Unchecked="NonDestructiveCheckBox_Unchecked"/>
                        </StackPanel>

                        <!-- Right Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="SaveBtn"
                                    Style="{StaticResource PrimaryBtn}"
                                    Content="Apply"
                                    Width="90"
                                    Height="32"
                                    FontSize="12"
                                    Margin="0,0,10,0"
                                    Click="SaveBtn_Click"/>

                            <Button x:Name="SaveCopyBtn"
                                    Style="{StaticResource EditorBtn}"
                                    Content="Save as Copy"
                                    Height="32"
                                    Padding="14,0"
                                    FontSize="12"
                                    Margin="0,0,10,0"
                                    Click="SaveCopyBtn_Click"/>

                            <Button x:Name="CancelBtn"
                                    Style="{StaticResource EditorBtn}"
                                    Content="Cancel"
                                    Width="80"
                                    Height="32"
                                    FontSize="12"
                                    Click="CancelBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <controls:LoadingOverlay x:Name="AudioEditorLoadingOverlay"/>
    </Grid>
</Window>
