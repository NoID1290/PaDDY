<Window x:Class="PaDDY.AudioEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Audio Editor &amp; Trim"
        Icon="/PaDDY.ico"
        Width="1160" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                       GlassFrameThickness="5"
                       ResizeBorderThickness="10"
                       UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Glass-style editor button (inherits AppTheme Button, just sets keyed override) -->
        <Style x:Key="EditorBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding"   Value="16,7"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Height"    Value="34"/>
        </Style>

        <!-- Primary action (Save Trim) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource EditorBtn}">
            <Setter Property="Foreground"  Value="{DynamicResource AccentGreenBrush}"/>
        </Style>

        <!-- DAW Handles Control Template -->
        <ControlTemplate x:Key="DawHandleTemplate" TargetType="Thumb">
            <Grid Background="Transparent" Width="16">
                <!-- Vertical marker line -->
                <Border Width="2" Background="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                <!-- Top grab tab -->
                <Path Data="M0,0 L12,0 L12,8 L6,14 L0,8 Z" Fill="{DynamicResource AccentGreenBrush}" Width="12" Height="14" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                    </Path.Effect>
                </Path>
                <!-- Bottom grab tab -->
                <Path Data="M0,14 L12,14 L12,6 L6,0 L0,6 Z" Fill="{DynamicResource AccentGreenBrush}" Width="12" Height="14" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                    </Path.Effect>
                </Path>
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0">
                    <Grid>
                        <TextBlock Text="Audio Editor &amp; Trim"
                                   Foreground="{DynamicResource AccentTitleBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTip="Close"
                                Click="ChromeClose_Click">
                                <Button.Effect>
                                    <DropShadowEffect Color="#FFFF5555" BlurRadius="8" ShadowDepth="0"/>
                                </Button.Effect>
                            <TextBlock Text="&#x2715;" FontSize="14" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

        <!-- Row 0 — Header -->
        <Border Grid.Row="0"
                Style="{StaticResource SecondaryWindowHeaderCard}"
                BorderBrush="#18FFFFFF"
                Padding="16,10"
                Margin="0,0,0,10"
                CornerRadius="8">
            <DockPanel>
                <TextBlock x:Name="FileNameLabel"
                           Text="filename.wav"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TotalDurationLabel"
                           Text="0.0s"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           FontSize="11.5"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Row 1 — Waveform area + vertical meter -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <!-- Waveform -->
            <Border Grid.Column="0"
                    Background="{DynamicResource WindowBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Border.Effect>
                    <StaticResource ResourceKey="PanelShadow"/>
                </Border.Effect>
                <Grid x:Name="WaveformGrid">
                    <!-- Background Grid Lines -->
                    <Grid x:Name="GridLines" IsHitTestVisible="False" Opacity="0.08">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="2" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="3" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="4" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="5" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="6" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="7" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="8" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                    </Grid>
                    <Grid x:Name="HorizontalGridLines" IsHitTestVisible="False" Opacity="0.06">
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,0,1"/>
                    </Grid>

                    <Image x:Name="WaveformImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                    <!-- Dark semi-transparent overlays for the unselected regions, referencing the window background -->
                    <Border x:Name="LeftOverlay"
                            Background="{DynamicResource WindowBgBrush}"
                            Opacity="0.55"
                            HorizontalAlignment="Left"
                            Width="0"/>
                    <Border x:Name="RightOverlay"
                            Background="{DynamicResource WindowBgBrush}"
                            Opacity="0.55"
                            HorizontalAlignment="Right"
                            Width="0"/>

                    <!-- Playback position indicator (DAW style playhead) -->
                    <Border x:Name="PlaybackLine"
                            Width="16"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PlaybackLineTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Border Width="1.5" Background="{DynamicResource AccentAmberBrush}" HorizontalAlignment="Center"/>
                            <Path Data="M3,0 L13,0 L8,8 Z" Fill="{DynamicResource AccentAmberBrush}" Width="16" Height="8" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Left trim handle -->
                    <Thumb x:Name="LeftHandle"
                           Width="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Stretch"
                           Cursor="SizeWE"
                           DragDelta="LeftHandle_DragDelta"
                           Template="{StaticResource DawHandleTemplate}"/>

                    <!-- Right trim handle -->
                    <Thumb x:Name="RightHandle"
                           Width="16"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Cursor="SizeWE"
                           DragDelta="RightHandle_DragDelta"
                           Template="{StaticResource DawHandleTemplate}"/>
                </Grid>
            </Border>

            <!-- Vertical level meter -->
            <Border Grid.Column="1"
                    Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="8,0,0,0"
                    ClipToBounds="True">
                <Border.Effect>
                    <StaticResource ResourceKey="PanelShadow"/>
                </Border.Effect>
                <Grid x:Name="VertMeterHost" Margin="2"/>
            </Border>
        </Grid>

        <!-- Row 2 — Time labels / Timeline Ruler -->
        <Border Grid.Row="2"
                Background="{DynamicResource InputBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,4"
                Margin="0,8,0,0">
            <Grid>
                <TextBlock x:Name="StartTimeLabel"
                           Text="0.00s"
                           Foreground="{DynamicResource AccentGreenBrush}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="TrimmedDurationLabel"
                           Text="Trimmed: 0.0s"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="EndTimeLabel"
                           Text="0.00s"
                           Foreground="{DynamicResource AccentGreenBrush}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Row 3 — Centered Playback Preview Controls -->
        <Border Grid.Row="3" Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PlayBtn"
                            Style="{StaticResource EditorBtn}"
                            Content="▶  Preview"
                            Width="120"
                            Height="34"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Click="PlayBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Col 1 — Effects side panel (spans all rows) -->
        <Grid Grid.Column="1" Grid.RowSpan="5" Margin="12,0,0,0" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Collapse toggle strip -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4,0"
                    VerticalAlignment="Stretch"
                    Cursor="Hand"
                    MouseLeftButtonUp="EffectsPanelChevron_Click">
                <TextBlock x:Name="EffectsPanelChevron" Text="&#x25C4;"
                           FontSize="10" Foreground="{DynamicResource SubtleTextBrush}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Effects content panel -->
            <Border x:Name="EffectsPanelContent" Grid.Column="1" Width="300"
                    Background="{DynamicResource WindowBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8" Margin="4,0,0,0"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <StaticResource ResourceKey="PanelShadow"/>
                </Border.Effect>
                <DockPanel>

                    <!-- Panel header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="EFFECTS PROCESSOR" Foreground="{DynamicResource AccentTitleBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Reset" HorizontalAlignment="Right"
                                FontSize="10.5" Height="22" Padding="12,2"
                                Click="ResetEffects_Click"/>
                    </Grid>

                    <!-- Gain bar -->
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource SecondaryWindowHeaderCard}"
                            BorderBrush="#18FFFFFF" Padding="12,7" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                            <Slider x:Name="GainSlider" Grid.Column="1"
                                    Minimum="-24" Maximum="24" Value="0"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="GainSlider_ValueChanged"/>
                            <TextBlock x:Name="GainLabel" Grid.Column="2" Text="0 dB"
                                       Foreground="{DynamicResource AccentGreenBrush}" FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Collapsible effect cards -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- VST Plugins -->
                            <Border x:Name="VstSection" Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                        <TextBlock Grid.Column="1" Text="VST Plugins" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2" x:Name="VstChevron" Text="&#x25BC;" FontSize="9" Foreground="#FF6060A0" VerticalAlignment="Center" Margin="4,0,0,0" Cursor="Hand" MouseLeftButtonUp="VstChevron_Click"/>
                                    </Grid>
                                    <StackPanel x:Name="VstContent" Visibility="Visible" Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Plugins" Style="{StaticResource SettingsLabel}" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" x:Name="VstNameLabel" Text="None loaded (Configure in Settings)" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Button x:Name="ShowVstEditorButton" Content="Show Plugin Editor" Style="{StaticResource EditorBtn}" Height="24" Padding="8,0" Margin="0,4,0,0" IsEnabled="False" Click="ShowVstEditor_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Fade In / Fade Out -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="FadeHeaderButton" Grid.Column="0"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                Click="FadeHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Fade In / Fade Out" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="FadeChevron" Text="&#x25BA;" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                        <CheckBox Grid.Column="1" x:Name="FadeEnabledCheck" Content="Enable" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" VerticalAlignment="Center" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                    </Grid>
                                    
                                    <StackPanel x:Name="FadeContent" Visibility="Collapsed" Margin="0,4,0,0">
                                        <!-- Visual Graph -->
                                        <Border Height="45" Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                            <Viewbox Stretch="Fill" Margin="15,4">
                                                <Path Data="M 0,35 C 20,35 25,5 30,5 L 70,5 C 75,5 80,35 100,35"
                                                      Stroke="{DynamicResource AccentGreenBrush}" StrokeThickness="2" Fill="{x:Null}"/>
                                            </Viewbox>
                                        </Border>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fade In (ms)" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="FadeInSlider" Minimum="0" Maximum="5000" TickFrequency="100" ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="FadeInLabel" Text="500" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fade Out (ms)" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="FadeOutSlider" Minimum="0" Maximum="5000" TickFrequency="100" ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="FadeOutLabel" Text="500" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Noise Gate -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="GateHeaderButton" Grid.Column="0"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                Click="GateHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Noise Gate" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="GateChevron" Text="&#x25BA;" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                        <CheckBox Grid.Column="1" x:Name="GateEnabledCheck" Content="Enable" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" VerticalAlignment="Center" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                    </Grid>
                                    
                                    <StackPanel x:Name="GateContent" Visibility="Collapsed" Margin="0,4,0,0">
                                        <!-- Visual Graph -->
                                        <Border Height="45" Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                            <Viewbox Stretch="Fill" Margin="25,4">
                                                <Path Data="M 0,35 L 40,35 L 75,5 L 100,5"
                                                      Stroke="{DynamicResource AccentGreenBrush}" StrokeThickness="2" Fill="{x:Null}"/>
                                            </Viewbox>
                                        </Border>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Threshold (dB)" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="GateThresholdSlider" Minimum="-80" Maximum="0" ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="GateThresholdLabel" Text="-40" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Attack (ms)" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="GateAttackSlider" Minimum="1" Maximum="200" ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="GateAttackLabel" Text="10" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Release (ms)" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="GateReleaseSlider" Minimum="10" Maximum="2000" ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="GateReleaseLabel" Text="100" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Pitch Shift -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PitchShiftHeaderButton" Grid.Column="0"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                Click="PitchShiftHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Pitch Shift" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="PitchShiftChevron" Text="&#x25BA;" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                        <CheckBox Grid.Column="1" x:Name="PitchShiftEnabledCheck" Content="Enable" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" VerticalAlignment="Center" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                    </Grid>
                                    
                                    <StackPanel x:Name="PitchShiftContent" Visibility="Collapsed" Margin="0,4,0,0">
                                        <!-- Visual Graph (sine-like wave representing pitch frequency shifting) -->
                                        <Border Height="45" Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                            <Viewbox Stretch="Fill" Margin="25,6">
                                                <Path Data="M 0,20 Q 12.5,5 25,20 T 50,20 T 67.5,20 T 80,20 T 90,20 T 97.5,20 T 100,20"
                                                      Stroke="{DynamicResource AccentGreenBrush}" StrokeThickness="2" Fill="{x:Null}"/>
                                            </Viewbox>
                                        </Border>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Pitch (semitones)" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="PitchShiftSemitonesSlider" Minimum="-24" Maximum="24" TickFrequency="1" ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="PitchShiftSemitonesLabel" Text="0" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
