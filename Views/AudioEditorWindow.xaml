<Window x:Class="PaDDY.AudioEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PaDDY.Controls"
        xmlns:p="clr-namespace:PaDDY.Helpers"
        Title="Audio Editor &amp; Trim"
        Icon="/PaDDY.ico"
        Width="1380" Height="860"
        MinWidth="1150" MinHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="5"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Custom Button Styles -->
        <Style x:Key="EditorBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Accent) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource EditorBtn}">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportToggleBtn" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Daw Card Style -->
        <Style x:Key="DawCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Value Badge Style -->
        <Style x:Key="ValueBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Dynamic Handle Control Template -->
        <ControlTemplate x:Key="DawHandleTemplate" TargetType="Thumb">
            <Grid Background="Transparent" Width="16">
                <!-- Vertical green trim marker line -->
                <Border Width="2" Background="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                <!-- Top grip head -->
                <Border Width="12" Height="16" Background="{DynamicResource AccentGreenBrush}" CornerRadius="3" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock Text="||" Foreground="{DynamicResource ButtonBgBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Bottom grip head -->
                <Border Width="12" Height="16" Background="{DynamicResource AccentGreenBrush}" CornerRadius="3" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <TextBlock Text="||" Foreground="{DynamicResource ButtonBgBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ControlTemplate>
        <!-- Small Icon Reset Button Style -->
        <Style x:Key="SmallIconResetBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Reset section to default values"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="↺" FontSize="12" Foreground="{TemplateBinding Foreground}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Root Container -->
        <Border Style="{StaticResource SecondaryWindowFrame}" Margin="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>   <!-- Row 0: Custom Title Bar -->
                    <RowDefinition Height="*"/>    <!-- Row 1: 2-Column Main Workspace -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Bottom Action Footer Bar -->
                </Grid.RowDefinitions>

                <!-- Row 0: Custom Title Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{DynamicResource TopWindowCornerRadius}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="🎛" FontSize="13" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Audio Editor &amp; Trim"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource ChromeMinBtn}"
                                    ToolTip="Minimize"
                                    Click="ChromeMinimize_Click">
                                <TextBlock Text="&#xE921;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                            <Button x:Name="ChromeMaxRestoreBtn"
                                    Style="{StaticResource ChromeMaxBtn}"
                                    ToolTip="Maximize"
                                    Click="ChromeMaximize_Click">
                                <TextBlock x:Name="ChromeMaxIcon" Text="&#xE922;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                            <Button x:Name="ChromeFullscreenBtn"
                                    Style="{StaticResource ChromeMaxBtn}"
                                    ToolTip="Fullscreen (F11)"
                                    Click="ChromeFullscreen_Click">
                                <TextBlock x:Name="ChromeFullscreenIcon" Text="&#xE740;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                            <Button Style="{StaticResource ChromeCloseBtn}"
                                    ToolTip="Close"
                                    Click="ChromeClose_Click">
                                <TextBlock Text="&#xE8BB;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: Main 2-Column Workspace (Center Editor + Right Side Panel) -->
                <Grid Grid.Row="1" Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>                  <!-- Column 0: Center Waveform & All Studio Effects -->
                        <ColumnDefinition Width="10"/>                 <!-- Gap -->
                        <ColumnDefinition Width="360" MinWidth="310"/> <!-- Column 1: Right Side Panel (File Info, Fade In/Out, Remaster, Master Bus) -->
                    </Grid.ColumnDefinitions>

                    <!-- ═══════════════════════════════════════════════════════════════
                         COLUMN 0: Center Main Waveform Display & Studio Effects Rack
                    ═══════════════════════════════════════════════════════════════ -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="240" MinHeight="160"/> <!-- Row 0: Waveform Stage -->
                            <RowDefinition Height="Auto"/>               <!-- Row 1: Timeline Ruler Strip & Trim Handles -->
                            <RowDefinition Height="*"/>                  <!-- Row 2: Studio Effects Rack (All effects below waveform) -->
                        </Grid.RowDefinitions>

                        <!-- Row 0 — Waveform Display Container -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource WindowBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Top Info Header Overlay inside Waveform Box -->
                                <Grid VerticalAlignment="Top" Margin="12,10,12,0" Panel.ZIndex="10">
                                    <TextBlock x:Name="FileNameLabel"
                                               Text="Audio Track"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TotalDurationLabel"
                                               Text="0.0s"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Main Waveform ScrollViewer -->
                                <ScrollViewer x:Name="WaveformScrollViewer"
                                              Margin="0,32,0,0"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled"
                                              SizeChanged="WaveformScrollViewer_SizeChanged"
                                              ScrollChanged="WaveformScrollViewer_ScrollChanged">
                                    <Grid x:Name="WaveformGrid">
                                        <!-- Fine Grid Lines -->
                                        <Grid x:Name="GridLines" IsHitTestVisible="False" Opacity="0.07">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="1" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="2" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="3" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="4" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="5" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="6" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="7" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="8" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="9" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="10" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="11" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="12" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        </Grid>
                                        <Grid x:Name="HorizontalGridLines" IsHitTestVisible="False" Opacity="0.05">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,0,1"/>
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,0,1"/>
                                            <Border Grid.Row="2" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,0,1"/>
                                        </Grid>

                                        <!-- Waveform Graphic -->
                                        <Image x:Name="WaveformImage"
                                               Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                        <!-- Unselected Regions Overlays -->
                                        <Border x:Name="LeftOverlay" Background="{DynamicResource WindowBgBrush}" Opacity="0.65" HorizontalAlignment="Left" Width="0"/>
                                        <Border x:Name="RightOverlay" Background="{DynamicResource WindowBgBrush}" Opacity="0.65" HorizontalAlignment="Right" Width="0"/>

                                        <!-- Playhead Cursor Line -->
                                        <Border x:Name="PlaybackLine" Width="16" HorizontalAlignment="Left" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="PlaybackLineTransform" X="0"/>
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Border Width="1.5" Background="{DynamicResource AccentAmberBrush}" HorizontalAlignment="Center"/>
                                                <Path Data="M3,0 L13,0 L8,8 Z" Fill="{DynamicResource AccentAmberBrush}" Width="16" Height="8" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Hidden vertical meter host for data compatibility -->
                                <Grid x:Name="VertMeterHost" Visibility="Collapsed"/>

                                <!-- Floating Transport Console (Anchored Bottom Center of Waveform Container) -->
                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Panel.ZIndex="20">
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Preview / Play Button -->
                                            <Button x:Name="PlayBtn"
                                                    Style="{StaticResource PrimaryBtn}"
                                                    Content="▶ Preview"
                                                    Height="28"
                                                    Padding="12,0"
                                                    FontSize="11.5"
                                                    Click="PlayBtn_Click"/>

                                                <ToggleButton x:Name="LoopToggle"
                                                      Style="{StaticResource TransportToggleBtn}"
                                                      Content="↻ Loop"
                                                      ToolTip="Loop the active trim range"
                                                      AutomationProperties.Name="Loop Trim Range"
                                                      Margin="6,0,0,0"/>

                                                    <Button x:Name="ClipAlertButton"
                                                        Content="CLIP"
                                                        ToolTip="Clipping detected. Click to reset."
                                                        AutomationProperties.Name="Reset Clipping Alert"
                                                        Click="ResetClipAlert_Click"
                                                        Visibility="Collapsed"
                                                        Height="28"
                                                        Padding="8,0"
                                                        Margin="6,0,0,0"
                                                        FontSize="10.5"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Background="#FFD50000"
                                                        BorderBrush="#FFFF5252"
                                                        BorderThickness="1"/>

                                            <!-- Functional Crop / Trim Buttons (✂◄ and ►✂) -->
                                            <Button x:Name="TrimInBtn"
                                                    Content="✂◄"
                                                    ToolTip="Set Trim Start to Current Playhead (Trim In)"
                                                    Style="{StaticResource EditorBtn}"
                                                    Height="28" Width="32" Padding="0" Margin="6,0,2,0"
                                                    Click="TrimInBtn_Click"/>

                                            <Button x:Name="TrimOutBtn"
                                                    Content="►✂"
                                                    ToolTip="Set Trim End to Current Playhead (Trim Out)"
                                                    Style="{StaticResource EditorBtn}"
                                                    Height="28" Width="32" Padding="0" Margin="2,0,10,0"
                                                    Click="TrimOutBtn_Click"/>

                                            <!-- Zoom Control -->
                                            <TextBlock Text="Zoom:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Slider x:Name="ZoomSlider"
                                                    Minimum="1" Maximum="10" Value="1"
                                                    Width="85" Height="22"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="ZoomSlider_ValueChanged"/>
                                            <TextBlock x:Name="ZoomLabel" Text="1.0x" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" Width="32"/>
                                                <Button ToolTip="Reset Zoom"
                                                    AutomationProperties.Name="Reset Zoom"
                                                    Click="ResetZoom_Click"
                                                    Style="{StaticResource SmallIconResetBtn}"
                                                    Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Row 1 — Timeline Ruler & Trim Handle Strip -->
                        <Border Grid.Row="1" Margin="0,6,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <!-- Time Markers Row -->
                                <Grid x:Name="TimeMarkersGrid" Grid.Row="0" Margin="4,0" SizeChanged="TimeMarkersGrid_SizeChanged">
                                    <TextBlock x:Name="StartTimeLabel" Text="0.00s" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TimeMarker1" Text="0.20s" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TimeMarker2" Text="0.40s" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TrimmedDurationLabel" Text="0.60s" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TimeMarker3" Text="0.80s" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TimeMarker4" Text="1.20s" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="EndTimeLabel" Text="1.60s" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Trim Selection Bar & Handles -->
                                <Grid Grid.Row="1">
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4"/>

                                    <!-- Left Trim Handle -->
                                    <Thumb x:Name="LeftHandle"
                                           Width="16"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch"
                                           Cursor="SizeWE"
                                           DragDelta="LeftHandle_DragDelta"
                                           Template="{StaticResource DawHandleTemplate}"/>

                                    <!-- Right Trim Handle -->
                                    <Thumb x:Name="RightHandle"
                                           Width="16"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           Cursor="SizeWE"
                                           DragDelta="RightHandle_DragDelta"
                                           Template="{StaticResource DawHandleTemplate}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Row 2 — Center Studio Effects Rack Chassis (All Effects Below Waveform - Collapsible) -->
                        <Border Grid.Row="2" Style="{StaticResource DawCard}" Padding="10">
                            <ScrollViewer x:Name="EffectsRackScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- CENTER COLUMN 1: Noise Gate, Equalizer, Compressor, Pitch Shift -->
                                    <StackPanel Grid.Column="0">

                                        <!-- Noise Gate Card (Collapsible Header + Sliding Switch) -->
                                        <Border Style="{StaticResource DawCard}">
                                            <StackPanel>
                                                <!-- Card Header Bar (Click to Collapse/Expand) -->
                                                <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=GateBody}" MouseDown="CardHeader_MouseDown">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Noise Gate" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- Reset & Power Switch -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button ToolTip="Reset Noise Gate" Click="ResetGate_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                        <CheckBox x:Name="GateEnabledCheck" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Collapsible Card Content Body -->
                                                <StackPanel x:Name="GateBody">
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Threshold (dB)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="GateThresholdSlider" Minimum="-80" Maximum="0" Value="-40" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="GateThresholdLabel" Text="-40" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Attack (ms)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="GateAttackSlider" Minimum="1" Maximum="200" Value="10" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="GateAttackLabel" Text="10" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Release (ms)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="GateReleaseSlider" Minimum="10" Maximum="1000" Value="100" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="GateReleaseLabel" Text="100" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Equalizer Card (Collapsible Header + Sliding Switch) -->
                                        <Border Style="{StaticResource DawCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=EqBody}" MouseDown="CardHeader_MouseDown">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="5-Band Equalizer" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button ToolTip="Reset Equalizer" Click="ResetEq_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                        <CheckBox x:Name="EqEnabledCheck" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="EqBody">
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Sub Bass" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="EqSubBassSlider" Minimum="-12" Maximum="12" Value="0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="EqSubBassLabel" Text="0 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Bass" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="EqBassSlider" Minimum="-12" Maximum="12" Value="0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="EqBassLabel" Text="0 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Mid" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="EqMidSlider" Minimum="-12" Maximum="12" Value="0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="EqMidLabel" Text="0 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Presence" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="EqPresenceSlider" Minimum="-12" Maximum="12" Value="0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="EqPresenceLabel" Text="0 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Treble" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="EqTrebleSlider" Minimum="-12" Maximum="12" Value="0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="EqTrebleLabel" Text="0 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Compressor Card (Collapsible Header + Sliding Switch) -->
                                        <Border Style="{StaticResource DawCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=CompBody}" MouseDown="CardHeader_MouseDown">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Compressor" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button ToolTip="Reset Compressor" Click="ResetCompressor_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                        <CheckBox x:Name="CompressorEnabledCheck" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="CompBody">
                                                    <!-- Arc Gauge for Compressor Threshold -->
                                                    <controls:ArcGaugeControl Title="Threshold" Subtitle="COMPRESSOR" Unit="dB" Minimum="-60" Maximum="0" Step="1" Value="{Binding ElementName=CompThresholdSlider, Path=Value, Mode=TwoWay}" Width="180" Height="115" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                                    <Slider x:Name="CompThresholdSlider" Minimum="-60" Maximum="0" Value="-20" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="CompThresholdLabel" Visibility="Collapsed"/>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Ratio" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="CompRatioSlider" Minimum="1" Maximum="20" Value="4" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="CompRatioLabel" Text="4.0" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Attack (ms)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="CompAttackSlider" Minimum="1" Maximum="100" Value="10" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="CompAttackLabel" Text="10" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Release (ms)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="CompReleaseSlider" Minimum="10" Maximum="1000" Value="100" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="CompReleaseLabel" Text="100" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Makeup (dB)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="CompMakeupSlider" Minimum="0" Maximum="24" Value="0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="CompMakeupLabel" Text="0" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Pitch Shift Card (Collapsible Header + Sliding Switch) -->
                                        <Border Style="{StaticResource DawCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=PitchBody}" MouseDown="CardHeader_MouseDown">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Pitch Shift" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button ToolTip="Reset Pitch Shift" Click="ResetPitchShift_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                        <CheckBox x:Name="PitchShiftEnabledCheck" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="PitchBody">
                                                    <!-- Arc Gauge for Pitch Shift Semitones -->
                                                    <controls:ArcGaugeControl Title="Pitch Shift" Subtitle="PITCH BEND" Unit="st" Minimum="-12" Maximum="12" Step="1" Value="{Binding ElementName=PitchShiftSemitonesSlider, Path=Value, Mode=TwoWay}" Width="180" Height="115" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                                    <Slider x:Name="PitchShiftSemitonesSlider" Minimum="-12" Maximum="12" Value="0" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="PitchShiftSemitonesLabel" Visibility="Collapsed"/>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Grain Size (ms)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="PitchShiftGrainSizeSlider" Minimum="10" Maximum="200" Value="50" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="PitchShiftGrainSizeLabel" Text="50" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Mix (wet)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="PitchShiftMixSlider" Minimum="0" Maximum="1" Value="1.0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="PitchShiftMixLabel" Text="1.00" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- CENTER COLUMN 2: Distortion, Echo, Reverb, VST Plugins -->
                                    <StackPanel Grid.Column="2">

                                        <!-- Distortion Card (Collapsible Header + 3 Rotary Knobs + Sliding Switch) -->
                                        <Border Style="{StaticResource DawCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=DistBody}" MouseDown="CardHeader_MouseDown">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Distortion" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button ToolTip="Reset Distortion" Click="ResetDistortion_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                        <CheckBox x:Name="DistortionEnabledCheck" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="DistBody">
                                                    <!-- 3 Rotary Dial Knobs as requested -->
                                                    <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,6,0,2">
                                                        <controls:KnobControl Label="Drive" Minimum="1" Maximum="50" Step="1" Value="{Binding ElementName=DistDriveSlider, Path=Value, Mode=TwoWay}"/>
                                                        <controls:KnobControl Label="Mix (wet)" Minimum="0" Maximum="1" Step="0.05" Value="{Binding ElementName=DistMixSlider, Path=Value, Mode=TwoWay}"/>
                                                        <controls:KnobControl Label="Output" Minimum="0" Maximum="1" Step="0.05" Value="{Binding ElementName=DistOutputSlider, Path=Value, Mode=TwoWay}"/>
                                                    </UniformGrid>

                                                    <Slider x:Name="DistDriveSlider" Minimum="1" Maximum="50" Value="8" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="DistDriveLabel" Visibility="Collapsed"/>
                                                    <Slider x:Name="DistMixSlider" Minimum="0" Maximum="1" Value="0.80" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="DistMixLabel" Visibility="Collapsed"/>
                                                    <Slider x:Name="DistOutputSlider" Minimum="0" Maximum="1" Value="0.80" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="DistOutputLabel" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Echo Card (Collapsible Header + 3 Rotary Knobs + Sliding Switch) -->
                                        <Border Style="{StaticResource DawCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=EchoBody}" MouseDown="CardHeader_MouseDown">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Echo &amp; Delay" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button ToolTip="Reset Echo &amp; Delay" Click="ResetEcho_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                        <CheckBox x:Name="EchoEnabledCheck" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="EchoBody">
                                                    <!-- 3 Rotary Dial Knobs as requested -->
                                                    <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,6,0,2">
                                                        <controls:KnobControl Label="Delay (ms)" Minimum="50" Maximum="2000" Step="10" Value="{Binding ElementName=EchoDelaySlider, Path=Value, Mode=TwoWay}"/>
                                                        <controls:KnobControl Label="Feedback" Minimum="0" Maximum="0.95" Step="0.05" Value="{Binding ElementName=EchoFeedbackSlider, Path=Value, Mode=TwoWay}"/>
                                                        <controls:KnobControl Label="Mix (wet)" Minimum="0" Maximum="1" Step="0.05" Value="{Binding ElementName=EchoMixSlider, Path=Value, Mode=TwoWay}"/>
                                                    </UniformGrid>

                                                    <Slider x:Name="EchoDelaySlider" Minimum="50" Maximum="2000" Value="200" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="EchoDelayLabel" Visibility="Collapsed"/>
                                                    <Slider x:Name="EchoFeedbackSlider" Minimum="0" Maximum="0.95" Value="0.30" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="EchoFeedbackLabel" Visibility="Collapsed"/>
                                                    <Slider x:Name="EchoMixSlider" Minimum="0" Maximum="1" Value="0.40" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="EchoMixLabel" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reverb Card (Collapsible Header + 3 Rotary Knobs + Sliding Switch) -->
                                        <Border Style="{StaticResource DawCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=ReverbBody}" MouseDown="CardHeader_MouseDown">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Reverb" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button ToolTip="Reset Reverb" Click="ResetReverb_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                        <CheckBox x:Name="ReverbEnabledCheck" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="ReverbBody">
                                                    <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,6,0,2">
                                                        <controls:KnobControl Label="Room Size" Minimum="0" Maximum="1" Step="0.05" Value="{Binding ElementName=ReverbRoomSlider, Path=Value, Mode=TwoWay}"/>
                                                        <controls:KnobControl Label="Damping" Minimum="0" Maximum="1" Step="0.05" Value="{Binding ElementName=ReverbDampingSlider, Path=Value, Mode=TwoWay}"/>
                                                        <controls:KnobControl Label="Mix (wet)" Minimum="0" Maximum="1" Step="0.05" Value="{Binding ElementName=ReverbMixSlider, Path=Value, Mode=TwoWay}"/>
                                                    </UniformGrid>

                                                    <Slider x:Name="ReverbRoomSlider" Minimum="0" Maximum="1" Value="0.5" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="ReverbRoomLabel" Visibility="Collapsed"/>
                                                    <Slider x:Name="ReverbDampingSlider" Minimum="0" Maximum="1" Value="0.5" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="ReverbDampingLabel" Visibility="Collapsed"/>
                                                    <Slider x:Name="ReverbMixSlider" Minimum="0" Maximum="1" Value="0.3" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                    <TextBlock x:Name="ReverbMixLabel" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- VST Plugins Card (Collapsible Header) -->
                                        <Border x:Name="VstSection" Style="{StaticResource DawCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=VstBody}" MouseDown="CardHeader_MouseDown">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="VST Plugins" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="VstBody">
                                                    <TextBlock x:Name="VstNameLabel" Text="No VST Plugin Loaded" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                                    <StackPanel x:Name="VstPluginRackPanel" Margin="0,0,0,8"/>
                                                    <Button x:Name="ShowVstEditorButton" Style="{StaticResource EditorBtn}" Content="Open VST Editor" Height="28" Click="ShowVstEditor_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>


                    <!-- ═══════════════════════════════════════════════════════════════
                         COLUMN 1: Right Side Panel (File Info, Fade In/Out, Remaster Rack, Master Bus)
                    ═══════════════════════════════════════════════════════════════ -->
                    <Border Grid.Column="2" Style="{StaticResource DawCard}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Sidebar Header & Output Spectrum Visualizer Meter -->
                            <Grid Grid.Row="0" Margin="2,0,2,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="MASTER &amp; FADE RACK"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTitleBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,6"/>

                                <!-- Dynamic Audio Spectrum Visualizer (Top Level) -->
                                <controls:SpectrumVisualizerControl Grid.Row="1" x:Name="MasterSpectrumVisualizer" Margin="0,2,0,4"/>
                            </Grid>

                            <!-- File Info remains visible while the effects rack scrolls. -->
                            <Border Grid.Row="1" Style="{StaticResource DawCard}" Margin="0,0,10,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=FileInfoBody}" MouseDown="CardHeader_MouseDown">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="File Info" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="FileInfoBody" Margin="2,0,2,2">
                                        <TextBlock x:Name="PlaybackTimecodeLabel" Text="00:00.000 / 00:00.000" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}" Margin="0,0,0,8"/>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Format:" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FileFormatLabel" Text="--" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sample Rate:" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FileSampleRateLabel" Text="--" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Channels:" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FileChannelsLabel" Text="--" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="File Size:" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FileSizeLabel" Text="--" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Side Cards List -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,0">
                                    <!-- Side Card 2: Fade In / Fade Out (Collapsible Header + Sliding Switch + Sliders) -->
                                    <Border Style="{StaticResource DawCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=FadeBody}" MouseDown="CardHeader_MouseDown">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Fade In / Fade Out" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button ToolTip="Reset Fade In / Fade Out" Click="ResetFade_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                    <CheckBox x:Name="FadeEnabledCheck" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="FadeBody">
                                                <!-- Fade In Slider -->
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Fade In (ms)" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="FadeInSlider" Minimum="0" Maximum="5000" Value="500" TickFrequency="100" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="FadeInLabel" Text="500" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Fade Out Slider -->
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Fade Out (ms)" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="FadeOutSlider" Minimum="0" Maximum="5000" Value="500" TickFrequency="100" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                        <TextBlock x:Name="FadeOutLabel" Text="500" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Side Card 3: Remaster Rack (Collapsible Header + Sliding Switch + Presets & Controls) -->
                                    <Border Style="{StaticResource DawCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=RemasterBody}" MouseDown="CardHeader_MouseDown">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Remaster Rack" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button ToolTip="Reset Remaster Rack" Click="ResetRemaster_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                    <CheckBox x:Name="RemasterEnabledCheck" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="RemasterBody">
                                                <ComboBox x:Name="RemasterPresetCombo"
                                                          Margin="0,2,0,8" Height="26" FontSize="11"
                                                          Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                          SelectionChanged="RemasterPresetCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Clean &amp; Transparent"/>
                                                    <ComboBoxItem Content="Warm Analog"/>
                                                    <ComboBoxItem Content="Punchy Club"/>
                                                    <ComboBoxItem Content="Vocal &amp; Acoustic"/>
                                                    <ComboBoxItem Content="Loud Maximizer"/>
                                                    <ComboBoxItem Content="Custom"/>
                                                </ComboBox>

                                                <!-- Arc Gauges for Remaster Warmth & Punch -->
                                                <UniformGrid Columns="2" Margin="0,2,0,6">
                                                    <controls:ArcGaugeControl Title="Warmth" Subtitle="ANALOG" Unit="dB" Minimum="-6" Maximum="6" Step="0.5" Value="{Binding ElementName=RemasterWarmthSlider, Path=Value, Mode=TwoWay}" Width="150" Height="105"/>
                                                    <controls:ArcGaugeControl Title="Punch" Subtitle="DYNAMICS" Unit="dB" Minimum="-6" Maximum="6" Step="0.5" Value="{Binding ElementName=RemasterPunchSlider, Path=Value, Mode=TwoWay}" Width="150" Height="105"/>
                                                </UniformGrid>

                                                <Slider x:Name="RemasterWarmthSlider" Minimum="-6" Maximum="6" Value="0" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                <TextBlock x:Name="RemasterWarmthLabel" Visibility="Collapsed"/>
                                                <Slider x:Name="RemasterPunchSlider" Minimum="-6" Maximum="6" Value="0" Visibility="Collapsed" ValueChanged="EffectSlider_Changed"/>
                                                <TextBlock x:Name="RemasterPunchLabel" Visibility="Collapsed"/>

                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="48"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Brilliance" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="RemasterBrillianceSlider" Minimum="-6" Maximum="6" Value="0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="RemasterBrillianceLabel" Text="0.0 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                </Grid>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="48"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Stereo Width" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="RemasterWidthSlider" Minimum="0" Maximum="2" Value="1.0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="RemasterWidthLabel" Text="1.00x" Foreground="{DynamicResource AccentGreenBrush}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                </Grid>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="48"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Drive" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="RemasterDriveSlider" Minimum="1" Maximum="10" Value="1.0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="RemasterDriveLabel" Text="1.00" Foreground="{DynamicResource AccentGreenBrush}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                </Grid>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="48"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Ratio" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="RemasterRatioSlider" Minimum="1" Maximum="10" Value="2.0" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="RemasterRatioLabel" Text="2.0:1" Foreground="{DynamicResource AccentGreenBrush}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                </Grid>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="48"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Ceiling" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" x:Name="RemasterCeilingSlider" Minimum="-6" Maximum="0" Value="-0.1" Height="24" Margin="4,0" ValueChanged="EffectSlider_Changed"/>
                                                    <Border Grid.Column="2" Style="{StaticResource ValueBadge}"><TextBlock x:Name="RemasterCeilingLabel" Text="-0.1 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Side Card 4: Master Bus Panel (Collapsible Header) -->
                                    <Border Style="{StaticResource DawCard}" Margin="0,0,0,4">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="{Binding ElementName=MasterBusBody}" MouseDown="CardHeader_MouseDown">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="3" Height="14" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Master Bus" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button ToolTip="Reset Master Bus" Click="ResetMasterBus_Click" Style="{StaticResource SmallIconResetBtn}"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="MasterBusBody">
                                                <!-- Arc Gauge Master Gain Control -->
                                                <controls:ArcGaugeControl Title="Master Gain" Subtitle="OUTPUT BUS" Unit="dB" Minimum="-24" Maximum="24" Step="0.5" Value="{Binding ElementName=GainSlider, Path=Value, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                                <Slider x:Name="GainSlider" Minimum="-24" Maximum="24" Value="0" Visibility="Collapsed" ValueChanged="GainSlider_ValueChanged"/>
                                                <TextBlock x:Name="GainLabel" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 2: Bottom Footer Action Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,8">
                    <Grid>
                        <!-- Left Options Checkboxes -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="SaveToFavCheckBox" Content="Add to Favourites" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" Margin="0,0,18,0"/>
                            <CheckBox x:Name="NonDestructiveCheckBox" Content="Non-Destructive Playback" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" Checked="NonDestructiveCheckBox_Checked" Unchecked="NonDestructiveCheckBox_Unchecked"/>
                        </StackPanel>

                        <!-- Right Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ResetAllBtn"
                                    Style="{StaticResource EditorBtn}"
                                    Content="Reset All"
                                    Height="32"
                                    Padding="14,0"
                                    FontSize="12"
                                    Margin="0,0,10,0"
                                    ToolTip="Reset all audio processing effects, trim range, and gain to defaults"
                                    Click="ResetAllBtn_Click"/>

                            <Button x:Name="SaveBtn"
                                    Style="{StaticResource PrimaryBtn}"
                                    Content="Apply"
                                    Width="90"
                                    Height="32"
                                    FontSize="12"
                                    Margin="0,0,10,0"
                                    Click="SaveBtn_Click"/>

                            <Button x:Name="SaveCopyBtn"
                                    Style="{StaticResource EditorBtn}"
                                    Content="Save as Copy"
                                    Height="32"
                                    Padding="14,0"
                                    FontSize="12"
                                    Margin="0,0,10,0"
                                    Click="SaveCopyBtn_Click"/>

                            <Button x:Name="CancelBtn"
                                    Style="{StaticResource EditorBtn}"
                                    Content="Cancel"
                                    Width="80"
                                    Height="32"
                                    FontSize="12"
                                    Click="CancelBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <controls:LoadingOverlay x:Name="AudioEditorLoadingOverlay"/>
    </Grid>
</Window>
