                                        </Border>
                                        <Border Grid.Column="4" Grid.Row="3" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                            <TextBlock x:Name="EqTrebleLabel" Text="0 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="9" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Row 4 — Action buttons -->
        <Border Grid.Row="4"
                Background="{DynamicResource SecondaryFooterBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,10,0,0">
            <Grid>
                <!-- Left: Checkboxes -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <CheckBox x:Name="SaveToFavCheckBox"
                              Content="Add to Favourites"
                              Foreground="{DynamicResource SecondaryTextBrush}"
                              FontSize="11.5"
                              Margin="0,0,16,0"/>
                    <CheckBox x:Name="NonDestructiveCheckBox"
                              Content="Non-Destructive Playback"
                              Foreground="{DynamicResource SecondaryTextBrush}"
                              FontSize="11.5"
                              Checked="NonDestructiveCheckBox_Checked"
                              Unchecked="NonDestructiveCheckBox_Unchecked"/>
                </StackPanel>

                <!-- Right: Cancel, Save as Copy, Save Trim -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource EditorBtn}"
                            Content="Cancel"
                            IsCancel="True"/>
                    <Button x:Name="SaveCopyBtn"
                            Style="{StaticResource EditorBtn}"
                            Content="✂  Save as Copy"
                            Margin="8,0,0,0"
                            Click="SaveCopyBtn_Click"/>
                    <Button x:Name="SaveBtn"
                            Style="{StaticResource PrimaryBtn}"
                            Content="✂  Save Trim"
                            Margin="8,0,0,0"
                            Click="SaveBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
