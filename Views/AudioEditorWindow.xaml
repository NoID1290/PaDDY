                                                        </Grid>
                                                    </Button>
                                                    <CheckBox Grid.Column="1" x:Name="EchoEnabledCheck" Content="{p:Loc Enable}" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </Grid>
                                                
                                                <StackPanel x:Name="EchoContent" Visibility="Visible" Margin="0,6,0,0">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{p:Loc FxDelayMs}" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="EchoDelaySlider" Minimum="50" Maximum="2000" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="EchoDelayLabel" Text="200" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{p:Loc FxFeedback}" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="EchoFeedbackSlider" Minimum="0" Maximum="0.95" TickFrequency="0.05" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="EchoFeedbackLabel" Text="0.30" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{p:Loc FxMixWet}" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="EchoMixSlider" Minimum="0" Maximum="1" TickFrequency="0.05" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="EchoMixLabel" Text="0.40" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reverb Rack Module -->
                                        <Border x:Name="ReverbModuleCard" Style="{StaticResource RackModuleCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="ReverbHeaderButton" Grid.Column="0"
                                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                            Click="ReverbHeaderButton_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="22"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                            <TextBlock Grid.Column="1" Text="{p:Loc FxReverb}" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" FontWeight="Bold"/>
                                                            <TextBlock Grid.Column="2" x:Name="ReverbChevron" Text="▼" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </Button>
                                                    <CheckBox Grid.Column="1" x:Name="ReverbEnabledCheck" Content="{p:Loc Enable}" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </Grid>
                                                
                                                <StackPanel x:Name="ReverbContent" Visibility="Visible" Margin="0,6,0,0">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{p:Loc FxRoomSize}" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="ReverbRoomSlider" Minimum="0" Maximum="1" TickFrequency="0.05" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="ReverbRoomLabel" Text="0.50" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{p:Loc FxDamping}" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="ReverbDampingSlider" Minimum="0" Maximum="1" TickFrequency="0.05" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="ReverbDampingLabel" Text="0.50" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{p:Loc FxMixWet}" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="ReverbMixSlider" Minimum="0" Maximum="1" TickFrequency="0.05" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="ReverbMixLabel" Text="0.30" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Remaster Rack Module -->
                                        <Border x:Name="RemasterModuleCard" Style="{StaticResource RackModuleCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="RemasterHeaderButton" Grid.Column="0"
                                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                            Click="RemasterHeaderButton_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="22"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                            <TextBlock Grid.Column="1" Text="Track Remaster" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" FontWeight="Bold"/>
                                                            <TextBlock Grid.Column="2" x:Name="RemasterChevron" Text="▼" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </Button>
                                                    <CheckBox Grid.Column="1" x:Name="RemasterEnabledCheck" Content="{p:Loc Enable}" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </Grid>
                                                
                                                <StackPanel x:Name="RemasterContent" Visibility="Visible" Margin="0,6,0,0">
                                                    <!-- Preset Dropdown -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Preset" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="1" x:Name="RemasterPresetCombo"
                                                                  SelectionChanged="RemasterPresetCombo_SelectionChanged"
                                                                  FontSize="11" Height="26">
                                                            <ComboBoxItem Content="Clean &amp; Transparent"/>
                                                            <ComboBoxItem Content="Warm Analog"/>
                                                            <ComboBoxItem Content="Punchy Club / EDM"/>
                                                            <ComboBoxItem Content="Vocal &amp; Acoustic"/>
                                                            <ComboBoxItem Content="Loud Maximizer"/>
                                                            <ComboBoxItem Content="Custom"/>
                                                        </ComboBox>
                                                    </Grid>
                                                    
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Warmth (dB)" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="RemasterWarmthSlider" Minimum="-6" Maximum="6" TickFrequency="0.5" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="RemasterWarmthLabel" Text="+1.5 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Punch (dB)" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="RemasterPunchSlider" Minimum="-6" Maximum="6" TickFrequency="0.5" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="RemasterPunchLabel" Text="+1.0 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Brilliance (dB)" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="RemasterBrillianceSlider" Minimum="-6" Maximum="6" TickFrequency="0.5" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="RemasterBrillianceLabel" Text="+2.0 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Stereo Width" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="RemasterWidthSlider" Minimum="0" Maximum="2" TickFrequency="0.05" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="RemasterWidthLabel" Text="1.20x" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Saturation" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="RemasterDriveSlider" Minimum="0" Maximum="1" TickFrequency="0.05" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="RemasterDriveLabel" Text="0.15" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Glue Ratio" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="RemasterRatioSlider" Minimum="1" Maximum="8" TickFrequency="0.1" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="RemasterRatioLabel" Text="2.5:1" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Peak Ceiling" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="RemasterCeilingSlider" Minimum="-6" Maximum="0" TickFrequency="0.1" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="RemasterCeilingLabel" Text="-0.3 dB" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- VST Plugins Rack Module -->
                                        <Border x:Name="VstSection" Style="{StaticResource RackModuleCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="22"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                    <TextBlock Grid.Column="1" Text="VST PLUGINS" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" FontWeight="Bold"/>
                                                    <TextBlock Grid.Column="2" x:Name="VstChevron" Text="▼" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0" Cursor="Hand" MouseLeftButtonUp="VstChevron_Click"/>
                                                </Grid>
                                                <StackPanel x:Name="VstContent" Visibility="Visible" Margin="0,8,0,0">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Plugins" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" x:Name="VstNameLabel" Text="None loaded (Configure in Settings)" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </Grid>
                                                    <Button x:Name="ShowVstEditorButton" Content="Show Plugin Editor" Style="{StaticResource EditorBtn}" Height="26" Padding="12,0" Margin="0,4,0,0" IsEnabled="False" Click="ShowVstEditor_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>

                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Row 5 — Action buttons -->
                    <Border Grid.Row="5"
                            Background="{DynamicResource SecondaryFooterBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,4,0,0">
                        <Grid>
                            <!-- Left: Checkboxes -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <CheckBox x:Name="SaveToFavCheckBox"
                                          Content="{p:Loc AddToFavourites}"
                                          Foreground="{DynamicResource SecondaryTextBrush}"
                                          FontSize="11.5"
                                          Margin="0,0,16,0"/>
                                <CheckBox x:Name="NonDestructiveCheckBox"
                                          Content="{p:Loc NonDestructivePlayback}"
                                          Foreground="{DynamicResource SecondaryTextBrush}"
                                          FontSize="11.5"
                                          Checked="NonDestructiveCheckBox_Checked"
                                          Unchecked="NonDestructiveCheckBox_Unchecked"/>
                            </StackPanel>

                            <!-- Right: Cancel, Save as Copy, Apply -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource EditorBtn}"
                                        Content="{p:Loc Cancel}"
                                        IsCancel="True"
                                        Click="CancelBtn_Click"/>
                                <Button x:Name="SaveCopyBtn"
                                        Style="{StaticResource EditorBtn}"
                                        Content="{p:Loc SaveAsCopy}"
                                        Margin="8,0,0,0"
                                        Click="SaveCopyBtn_Click"/>
                                <Button x:Name="SaveBtn"
                                        Style="{StaticResource PrimaryBtn}"
                                        Content="{p:Loc Apply}"
                                        Margin="8,0,0,0"
                                        Click="SaveBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

                <!-- Loading Screen Overlay -->
                <Border Grid.RowSpan="2" CornerRadius="12" ClipToBounds="True" Panel.ZIndex="100">
                    <controls:LoadingOverlay x:Name="AudioEditorLoadingOverlay" Background="#CC0D0D14" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
