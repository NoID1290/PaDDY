<Window x:Class="PaDDY.AudioEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Trim Audio"
        Icon="/PaDDY.ico"
        Width="1160" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                      GlassFrameThickness="5"
                      ResizeBorderThickness="10"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Glass-style editor button (inherits AppTheme Button, just sets keyed override) -->
        <Style x:Key="EditorBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding"   Value="16,7"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Height"    Value="34"/>
        </Style>

        <!-- Primary action (Save Trim) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource EditorBtn}">
            <Setter Property="Background"  Value="#FF1A2E1A"/>
            <Setter Property="BorderBrush" Value="#404CAF50"/>
            <Setter Property="Foreground"  Value="#FFAAD4AA"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0">
                    <Grid>
                        <TextBlock Text="Trim Audio"
                                   Foreground="#FF8080A8"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTip="Close"
                                Click="ChromeClose_Click">
                                <Button.Effect>
                                    <DropShadowEffect Color="#FFFF5555" BlurRadius="8" ShadowDepth="0"/>
                                </Button.Effect>
                            <TextBlock Text="&#x2715;" FontSize="14" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

        <!-- Row 0 — Header -->
        <Border Grid.Row="0"
                Style="{StaticResource SecondaryWindowHeaderCard}"
                BorderBrush="#22FFFFFF"
                Padding="14,8"
                Margin="0,0,0,10">
            <DockPanel>
                <TextBlock x:Name="FileNameLabel"
                           Text="filename.wav"
                           Foreground="#FFD0D8F0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TotalDurationLabel"
                           Text="0.0s"
                           Foreground="#FF6060A0"
                           FontSize="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Row 1 — Waveform area + vertical meter -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <!-- Waveform -->
            <Border Grid.Column="0"
                    Background="#FF0D1019"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    CornerRadius="7"
                    ClipToBounds="True">
                <Border.Effect>
                    <StaticResource ResourceKey="PanelShadow"/>
                </Border.Effect>
                <Grid x:Name="WaveformGrid">
                    <Image x:Name="WaveformImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                    <Border x:Name="LeftOverlay"
                            Background="#88000010"
                            HorizontalAlignment="Left"
                            Width="0"/>
                    <Border x:Name="RightOverlay"
                            Background="#88000010"
                            HorizontalAlignment="Right"
                            Width="0"/>

                    <!-- Playback position indicator -->
                    <Border x:Name="PlaybackLine"
                            Background="#FFFFC107"
                            Width="2"
                            HorizontalAlignment="Left"
                            Margin="0"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PlaybackLineTransform" X="0"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Left trim handle -->
                    <Thumb x:Name="LeftHandle"
                           Width="10"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Stretch"
                           Cursor="SizeWE"
                           DragDelta="LeftHandle_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#CC4CAF50"
                                        CornerRadius="4,0,0,4"
                                        BorderBrush="#FF66BB6A"
                                        BorderThickness="2,0,0,0"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <!-- Right trim handle -->
                    <Thumb x:Name="RightHandle"
                           Width="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Cursor="SizeWE"
                           DragDelta="RightHandle_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#CC4CAF50"
                                        CornerRadius="0,4,4,0"
                                        BorderBrush="#FF66BB6A"
                                        BorderThickness="0,0,2,0"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>

            <!-- Vertical level meter -->
            <Border Grid.Column="1"
                    Background="#FF0D1019"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    CornerRadius="7"
                    Margin="6,0,0,0"
                    ClipToBounds="True">
                <Border.Effect>
                    <StaticResource ResourceKey="PanelShadow"/>
                </Border.Effect>
                <Grid x:Name="VertMeterHost" Margin="1"/>
            </Border>
        </Grid>

        <!-- Row 2 — Time labels -->
        <Grid Grid.Row="2" Margin="2,7,2,0">
            <TextBlock x:Name="StartTimeLabel"
                       Text="0.00s"
                       Foreground="#FF4CAF50"
                       FontSize="11"
                       HorizontalAlignment="Left"/>
            <TextBlock x:Name="TrimmedDurationLabel"
                       Text="Trimmed: 0.0s"
                       Foreground="#FF606090"
                       FontSize="11"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="EndTimeLabel"
                       Text="0.00s"
                       Foreground="#FF4CAF50"
                       FontSize="11"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- Col 1 — Effects side panel (spans all rows) -->
        <Grid Grid.Column="1" Grid.RowSpan="5" Margin="10,0,0,0" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Collapse toggle strip -->
            <Border Grid.Column="0"
                    Background="#FF0D1019"
                    BorderBrush="#28FFFFFF" BorderThickness="1"
                    CornerRadius="6" Padding="3,0"
                    VerticalAlignment="Stretch">
                <TextBlock x:Name="EffectsPanelChevron" Text="&#x25C4;"
                           FontSize="9" Foreground="#FF6060A0"
                           VerticalAlignment="Center"
                           Cursor="Hand" MouseLeftButtonUp="EffectsPanelChevron_Click"/>
            </Border>

            <!-- Effects content panel -->
            <Border x:Name="EffectsPanelContent" Grid.Column="1" Width="300"
                    Background="#FF0D1019"
                    BorderBrush="#28FFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="8" Margin="4,0,0,0"
                    VerticalAlignment="Stretch">
                <DockPanel>

                    <!-- Panel header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Effects" Foreground="#FF8080A8" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="Reset" HorizontalAlignment="Right"
                                FontSize="10" Height="22" Padding="10,2"
                                Click="ResetEffects_Click"/>
                    </Grid>

                    <!-- Gain bar -->
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource SecondaryWindowHeaderCard}"
                            BorderBrush="#18FFFFFF" Padding="12,7" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain"
                                       Foreground="#FF8080A8" FontSize="11" VerticalAlignment="Center"/>
                            <Slider x:Name="GainSlider" Grid.Column="1"
                                    Minimum="-24" Maximum="24" Value="0"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="GainSlider_ValueChanged"/>
                            <TextBlock x:Name="GainLabel" Grid.Column="2" Text="0 dB"
                                       Foreground="#FF6060A0" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Collapsible effect cards -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Fade In / Fade Out -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" x:Name="FadeEnabledCheck" Content="Enable"
                                                  Foreground="{StaticResource AccentGreenBrush}" FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                        <Button x:Name="FadeHeaderButton"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                Click="FadeHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Fade In / Fade Out"
                                                           Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="FadeChevron" Text="&#x25BA;"
                                                           FontSize="9" Foreground="#FF6060A0"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                    <StackPanel x:Name="FadeContent" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fade In (ms)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="FadeInSlider"
                                                    Minimum="0" Maximum="5000" TickFrequency="100"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="FadeInLabel" Text="500"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fade Out (ms)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="FadeOutSlider"
                                                    Minimum="0" Maximum="5000" TickFrequency="100"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="FadeOutLabel" Text="500"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Noise Gate -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" x:Name="GateEnabledCheck" Content="Enable"
                                                  Foreground="{StaticResource AccentGreenBrush}" FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                        <Button x:Name="GateHeaderButton"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                Click="GateHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Noise Gate"
                                                           Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="GateChevron" Text="&#x25BA;"
                                                           FontSize="9" Foreground="#FF6060A0"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                    <StackPanel x:Name="GateContent" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Threshold (dB)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="GateThresholdSlider"
                                                    Minimum="-80" Maximum="0"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="GateThresholdLabel" Text="-40"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Attack (ms)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="GateAttackSlider"
                                                    Minimum="1" Maximum="200"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="GateAttackLabel" Text="10"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Release (ms)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="GateReleaseSlider"
                                                    Minimum="10" Maximum="2000"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="GateReleaseLabel" Text="100"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Compressor -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" x:Name="CompressorEnabledCheck" Content="Enable"
                                                  Foreground="{StaticResource AccentGreenBrush}" FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                        <Button x:Name="CompressorHeaderButton"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                Click="CompressorHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Compressor"
                                                           Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="CompressorChevron" Text="&#x25BA;"
                                                           FontSize="9" Foreground="#FF6060A0"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                    <StackPanel x:Name="CompressorContent" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Threshold (dB)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="CompThresholdSlider"
                                                    Minimum="-60" Maximum="0"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="CompThresholdLabel" Text="-18"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Ratio"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="CompRatioSlider"
                                                    Minimum="1" Maximum="20" TickFrequency="0.5"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="CompRatioLabel" Text="4.0"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Attack (ms)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="CompAttackSlider"
                                                    Minimum="1" Maximum="200"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="CompAttackLabel" Text="10"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Release (ms)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="CompReleaseSlider"
                                                    Minimum="10" Maximum="2000"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="CompReleaseLabel" Text="120"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Makeup (dB)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="CompMakeupSlider"
                                                    Minimum="0" Maximum="24"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="CompMakeupLabel" Text="0"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Distortion -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" x:Name="DistortionEnabledCheck" Content="Enable"
                                                  Foreground="{StaticResource AccentGreenBrush}" FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                        <Button x:Name="DistortionHeaderButton"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                Click="DistortionHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Distortion"
                                                           Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="DistortionChevron" Text="&#x25BA;"
                                                           FontSize="9" Foreground="#FF6060A0"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                    <StackPanel x:Name="DistortionContent" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Drive"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="DistDriveSlider"
                                                    Minimum="1" Maximum="50"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="DistDriveLabel" Text="8"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Mix (wet)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="DistMixSlider"
                                                    Minimum="0" Maximum="1" TickFrequency="0.05"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="DistMixLabel" Text="0.60"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Output"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="DistOutputSlider"
                                                    Minimum="0" Maximum="1" TickFrequency="0.05"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="DistOutputLabel" Text="0.80"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Echo -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" x:Name="EchoEnabledCheck" Content="Enable"
                                                  Foreground="{StaticResource AccentGreenBrush}" FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                        <Button x:Name="EchoHeaderButton"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                Click="EchoHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Echo"
                                                           Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="EchoChevron" Text="&#x25BA;"
                                                           FontSize="9" Foreground="#FF6060A0"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                    <StackPanel x:Name="EchoContent" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Delay (ms)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="EchoDelaySlider"
                                                    Minimum="50" Maximum="2000"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="EchoDelayLabel" Text="200"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Feedback"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="EchoFeedbackSlider"
                                                    Minimum="0" Maximum="0.95" TickFrequency="0.05"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="EchoFeedbackLabel" Text="0.30"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Mix (wet)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="EchoMixSlider"
                                                    Minimum="0" Maximum="1" TickFrequency="0.05"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="EchoMixLabel" Text="0.40"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Reverb -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" x:Name="ReverbEnabledCheck" Content="Enable"
                                                  Foreground="{StaticResource AccentGreenBrush}" FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                        <Button x:Name="ReverbHeaderButton"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                Click="ReverbHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Reverb"
                                                           Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="ReverbChevron" Text="&#x25BA;"
                                                           FontSize="9" Foreground="#FF6060A0"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                    <StackPanel x:Name="ReverbContent" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Room Size"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="ReverbRoomSlider"
                                                    Minimum="0" Maximum="1" TickFrequency="0.05"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="ReverbRoomLabel" Text="0.50"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Damping"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="ReverbDampingSlider"
                                                    Minimum="0" Maximum="1" TickFrequency="0.05"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="ReverbDampingLabel" Text="0.50"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Mix (wet)"
                                                       Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="ReverbMixSlider"
                                                    Minimum="0" Maximum="1" TickFrequency="0.05"
                                                    ValueChanged="EffectSlider_Changed"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                                <TextBlock x:Name="ReverbMixLabel" Text="0.30"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           FontSize="10" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Equalizer -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" x:Name="EqEnabledCheck" Content="Enable"
                                                  Foreground="{StaticResource AccentGreenBrush}" FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                        <Button x:Name="EqHeaderButton"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                Click="EqHeaderButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                <TextBlock Grid.Column="1" Text="Equalizer (5-Band)"
                                                           Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" x:Name="EqChevron" Text="&#x25BA;"
                                                           FontSize="9" Foreground="#FF6060A0"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                    <!-- Horizontal 5-band EQ -->
                                    <Grid x:Name="EqContent" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="80"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Band labels -->
                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="80Hz"
                                                   Style="{StaticResource SettingsLabel}" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Grid.Column="1" Grid.Row="0" Text="250Hz"
                                                   Style="{StaticResource SettingsLabel}" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Grid.Column="2" Grid.Row="0" Text="1kHz"
                                                   Style="{StaticResource SettingsLabel}" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Grid.Column="3" Grid.Row="0" Text="4kHz"
                                                   Style="{StaticResource SettingsLabel}" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Grid.Column="4" Grid.Row="0" Text="12kHz"
                                                   Style="{StaticResource SettingsLabel}" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <!-- Vertical sliders -->
                                        <Slider Grid.Column="0" Grid.Row="1" x:Name="EqSubBassSlider"
                                                Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                ValueChanged="EffectSlider_Changed"/>
                                        <Slider Grid.Column="1" Grid.Row="1" x:Name="EqBassSlider"
                                                Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                ValueChanged="EffectSlider_Changed"/>
                                        <Slider Grid.Column="2" Grid.Row="1" x:Name="EqMidSlider"
                                                Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                ValueChanged="EffectSlider_Changed"/>
                                        <Slider Grid.Column="3" Grid.Row="1" x:Name="EqPresenceSlider"
                                                Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                ValueChanged="EffectSlider_Changed"/>
                                        <Slider Grid.Column="4" Grid.Row="1" x:Name="EqTrebleSlider"
                                                Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                ValueChanged="EffectSlider_Changed"/>
                                        <!-- Value badges -->
                                        <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                            <TextBlock x:Name="EqSubBassLabel" Text="0 dB"
                                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="9"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                            <TextBlock x:Name="EqBassLabel" Text="0 dB"
                                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="9"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                            <TextBlock x:Name="EqMidLabel" Text="0 dB"
                                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="9"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="3" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                            <TextBlock x:Name="EqPresenceLabel" Text="0 dB"
                                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="9"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="4" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                            <TextBlock x:Name="EqTrebleLabel" Text="0 dB"
                                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="9"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Row 4 — Action buttons -->
        <Border Grid.Row="4"
            Background="{StaticResource SecondaryFooterBackgroundBrush}"
                BorderBrush="#14FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <!-- Left: Preview + Add to Favourites -->
                <Button x:Name="PlayBtn"
                        Style="{StaticResource EditorBtn}"
                        Content="&#x25B6;  Preview"
                        DockPanel.Dock="Left"
                        Click="PlayBtn_Click"/>
                <CheckBox x:Name="SaveToFavCheckBox"
                          Content="Add to Favourites"
                          Foreground="#FFB0B0CC"
                          DockPanel.Dock="Left"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"/>

                <!-- Right: Cancel, Save as Copy, Save Trim -->
                <Button x:Name="SaveBtn"
                        Style="{StaticResource PrimaryBtn}"
                        Content="✂  Save Trim"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Click="SaveBtn_Click"/>
                <Button x:Name="SaveCopyBtn"
                        Style="{StaticResource EditorBtn}"
                        Content="✂  Save as Copy"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Click="SaveCopyBtn_Click"/>
                <Button Style="{StaticResource EditorBtn}"
                        Content="Cancel"
                        DockPanel.Dock="Right"
                        IsCancel="True"/>
            </DockPanel>
        </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
