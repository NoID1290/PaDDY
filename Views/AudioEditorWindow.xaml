<Window x:Class="PaDDY.AudioEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PaDDY.Controls"
        xmlns:p="clr-namespace:PaDDY.Helpers"
        Title="{p:Loc AudioEditorTitle}"
        Icon="/PaDDY.ico"
        Width="1420" Height="920"
        MinWidth="1200" MinHeight="780"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="5"
                            ResizeBorderThickness="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Glass-style editor button -->
        <Style x:Key="EditorBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding"   Value="16,7"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Height"    Value="34"/>
        </Style>

        <!-- Primary action (Apply Trim) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource EditorBtn}">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- View Switcher Segmented RadioButton Style -->
        <Style x:Key="ViewSwitcherBtnStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BadgeBgBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rack Category Selector Tab Style -->
        <Style x:Key="CategoryTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BadgeBgBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DAW Handles Control Template -->
        <ControlTemplate x:Key="DawHandleTemplate" TargetType="Thumb">
            <Grid Background="Transparent" Width="16">
                <!-- Vertical marker line -->
                <Border Width="2" Background="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                <!-- Top grab tab -->
                <Path Data="M0,0 L12,0 L12,8 L6,14 L0,8 Z" Fill="{DynamicResource AccentGreenBrush}" Width="12" Height="14" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                    </Path.Effect>
                </Path>
                <!-- Bottom grab tab -->
                <Path Data="M0,14 L12,14 L12,6 L6,0 L0,6 Z" Fill="{DynamicResource AccentGreenBrush}" Width="12" Height="14" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                    </Path.Effect>
                </Path>
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{DynamicResource TopWindowCornerRadius}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <!-- Title Bar Icon Graphic -->
                            <TextBlock Text="🎛" FontSize="13" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{p:Loc AudioEditorTitle}"
                                       Foreground="{DynamicResource AccentTitleBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTip="Close"
                                Click="ChromeClose_Click">
                            <TextBlock Text="&#xE8BB;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Editor Area -->
                <Grid Grid.Row="1" Margin="14,10,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Track Header & View Switcher -->
                        <RowDefinition Height="230" MinHeight="140"/> <!-- Row 1: Full-Width Waveform Stage -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Timeline Ruler / Time Labels -->
                        <RowDefinition Height="Auto"/> <!-- Row 3: Transport & Zoom Console -->
                        <RowDefinition Height="*"/>    <!-- Row 4: Studio Effects Processor Rack Chassis -->
                        <RowDefinition Height="Auto"/> <!-- Row 5: Action Footer -->
                    </Grid.RowDefinitions>

                    <!-- Row 0 — Track Header & Workspace View Switcher -->
                    <Border Grid.Row="0"
                            Style="{StaticResource SecondaryWindowHeaderCard}"
                            BorderBrush="#18FFFFFF"
                            Padding="16,8"
                            Margin="0,0,0,8"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Track File Name -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock Text="AUDIO TRACK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}"/>
                                </Border>
                                <TextBlock x:Name="FileNameLabel"
                                           Text="filename.wav"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Center: Workspace View Switcher -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <RadioButton x:Name="ViewModeSplitRadio" Content="🎛 SPLIT VIEW" IsChecked="True" Style="{StaticResource ViewSwitcherBtnStyle}" Click="ViewMode_Split_Click" ToolTip="Show Waveform &amp; Effects Rack together"/>
                                <RadioButton x:Name="ViewModeWaveformRadio" Content="🌊 WAVEFORM FOCUS" Style="{StaticResource ViewSwitcherBtnStyle}" Click="ViewMode_Waveform_Click" ToolTip="Expand Waveform view for high-precision trimming"/>
                                <RadioButton x:Name="ViewModeEffectsRadio" Content="🎚 EFFECTS FOCUS" Style="{StaticResource ViewSwitcherBtnStyle}" Click="ViewMode_Effects_Click" ToolTip="Expand Effects Rack for maximum effect parameter controls"/>
                            </StackPanel>

                            <!-- Right: Total Track Duration -->
                            <TextBlock x:Name="TotalDurationLabel"
                                       Grid.Column="2"
                                       Text="0.0s"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 1 — Waveform area + vertical meter (Spans Full Window Width) -->
                    <Grid x:Name="WaveformRowGrid" Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>

                        <!-- Waveform -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource WindowBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                ClipToBounds="True">
                            <Border.Effect>
                                <StaticResource ResourceKey="PanelShadow"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="WaveformScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          SizeChanged="WaveformScrollViewer_SizeChanged">
                                <Grid x:Name="WaveformGrid">
                                    <!-- Background Grid Lines -->
                                    <Grid x:Name="GridLines" IsHitTestVisible="False" Opacity="0.08">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="2" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="3" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="4" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="5" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="6" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="7" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="8" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="9" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="10" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="11" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="12" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,1,0"/>
                                    </Grid>
                                    <Grid x:Name="HorizontalGridLines" IsHitTestVisible="False" Opacity="0.06">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,0,1"/>
                                        <Border Grid.Row="1" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,0,1"/>
                                        <Border Grid.Row="2" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="0,0,0,1"/>
                                    </Grid>

                                    <Image x:Name="WaveformImage"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                    <!-- Dark semi-transparent overlays for the unselected regions -->
                                    <Border x:Name="LeftOverlay"
                                            Background="{DynamicResource WindowBgBrush}"
                                            Opacity="0.60"
                                            HorizontalAlignment="Left"
                                            Width="0"/>
                                    <Border x:Name="RightOverlay"
                                            Background="{DynamicResource WindowBgBrush}"
                                            Opacity="0.60"
                                            HorizontalAlignment="Right"
                                            Width="0"/>

                                    <!-- Playback position indicator (DAW style playhead) -->
                                    <Border x:Name="PlaybackLine"
                                            Width="16"
                                            HorizontalAlignment="Left"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="PlaybackLineTransform" X="0"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Border Width="1.5" Background="{DynamicResource AccentAmberBrush}" HorizontalAlignment="Center"/>
                                            <Path Data="M3,0 L13,0 L8,8 Z" Fill="{DynamicResource AccentAmberBrush}" Width="16" Height="8" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Left trim handle -->
                                    <Thumb x:Name="LeftHandle"
                                           Width="16"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch"
                                           Cursor="SizeWE"
                                           DragDelta="LeftHandle_DragDelta"
                                           Template="{StaticResource DawHandleTemplate}"/>

                                    <!-- Right trim handle -->
                                    <Thumb x:Name="RightHandle"
                                           Width="16"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           Cursor="SizeWE"
                                           DragDelta="RightHandle_DragDelta"
                                           Template="{StaticResource DawHandleTemplate}"/>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <!-- Vertical level meter -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="8,0,0,0"
                                ClipToBounds="True">
                            <Border.Effect>
                                <StaticResource ResourceKey="PanelShadow"/>
                            </Border.Effect>
                            <Grid x:Name="VertMeterHost" Margin="2"/>
                        </Border>
                    </Grid>

                    <!-- Row 2 — Time labels / Timeline Ruler -->
                    <Border x:Name="TimelineRowBorder" Grid.Row="2"
                            Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,4"
                            Margin="0,0,0,8">
                        <Grid>
                            <TextBlock x:Name="StartTimeLabel"
                                        Text="0.00s"
                                        Foreground="{DynamicResource AccentGreenBrush}"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TrimmedDurationLabel"
                                        Text="Trimmed: 0.0s"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EndTimeLabel"
                                        Text="0.00s"
                                        Foreground="{DynamicResource AccentGreenBrush}"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Row 3 — Transport & Playback controls -->
                    <Border x:Name="TransportRowBorder" Grid.Row="3"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6"
                            Margin="0,0,0,8">
                        <Grid>
                            <!-- Center: Playback / Timecode -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PlayBtn"
                                        Style="{StaticResource EditorBtn}"
                                        Content="{p:Loc PreviewBtn}"
                                        Width="130"
                                        Height="34"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Click="PlayBtn_Click"/>
                                <TextBlock x:Name="PlaybackTimecodeLabel"
                                           Text="00:00.000 / 00:00.000"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"
                                           FontFamily="Consolas, Courier New, monospace"/>
                            </StackPanel>

                            <!-- Right: Zoom Control -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{p:Loc ZoomLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="ZoomSlider"
                                        Minimum="1" Maximum="10" Value="1"
                                        Width="120"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        ValueChanged="ZoomSlider_ValueChanged"/>
                                <TextBlock x:Name="ZoomLabel" Text="1.0x" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" Width="32"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 4 — Studio Effects Processor Rack Chassis -->
                    <Border x:Name="EffectsRowBorder" Grid.Row="4"
                            Background="{DynamicResource WindowBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,8"
                            VerticalAlignment="Stretch">
                        <Border.Effect>
                            <StaticResource ResourceKey="PanelShadow"/>
                        </Border.Effect>
                        <DockPanel x:Name="EffectsPanelContent">

                            <!-- Single Unified Studio Effects Rack Header Bar -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,6"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Title & Status -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentGreenBrush}" Margin="0,0,8,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" Color="#4CAF50" Opacity="0.9"/>
                                            </Border.Effect>
                                        </Border>
                                        <TextBlock Text="STUDIO EFFECTS PROCESSOR RACK"
                                                   Foreground="{DynamicResource AccentTitleBrush}"
                                                   FontSize="11.5" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Master Gain Console -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="MASTER GAIN" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="GainSlider" Width="200" Height="26"
                                                Minimum="-24" Maximum="24" Value="0"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="GainSlider_ValueChanged"/>
                                        <Border Style="{StaticResource ValueBadge}" Margin="10,0,0,0" Width="58">
                                            <TextBlock x:Name="GainLabel" Text="0 dB"
                                                       Foreground="{DynamicResource AccentGreenBrush}" FontSize="11"
                                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Actions: Reset All & Single Hide Button -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="{p:Loc ResetAll}" HorizontalAlignment="Right"
                                                Style="{StaticResource EditorBtn}" Height="26" Padding="12,0" Margin="0,0,12,0"
                                                Click="ResetEffects_Click"/>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="EffectsPanelChevron_Click">
                                            <TextBlock x:Name="EffectsPanelChevron" Text="▼ HIDE RACK"
                                                       FontSize="10" Foreground="{DynamicResource AccentGreenBrush}"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Rack Category Filter Bar -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,4"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <RadioButton x:Name="CatAllRadio" Content="⚡ ALL MODULES" IsChecked="True" Style="{StaticResource CategoryTabStyle}" Tag="All" Click="RackCategory_Click"/>
                                    <RadioButton x:Name="CatDynamicsRadio" Content="🎛 DYNAMICS" Style="{StaticResource CategoryTabStyle}" Tag="Dynamics" Click="RackCategory_Click"/>
                                    <RadioButton x:Name="CatToneRadio" Content="🎚 TONE &amp; PITCH" Style="{StaticResource CategoryTabStyle}" Tag="Tone" Click="RackCategory_Click"/>
                                    <RadioButton x:Name="CatSpatialRadio" Content="🌌 SPATIAL &amp; REMASTER" Style="{StaticResource CategoryTabStyle}" Tag="Spatial" Click="RackCategory_Click"/>
                                    <RadioButton x:Name="CatVstRadio" Content="🔌 VST PLUGINS" Style="{StaticResource CategoryTabStyle}" Tag="Vst" Click="RackCategory_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Multi-Column Studio Hardware Rack Modules Stack (Spacious 2-Column Grid) -->
                            <ScrollViewer x:Name="EffectsRackScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- COLUMN 1: Dynamics, Envelopes & Tone -->
                                    <StackPanel Grid.Column="0">

                                        <!-- Fade In / Fade Out Rack Module -->
                                        <Border x:Name="FadeModuleCard" Style="{StaticResource RackModuleCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="FadeHeaderButton" Grid.Column="0"
                                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                            Click="FadeHeaderButton_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="22"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                                                            <TextBlock Grid.Column="1" Text="{p:Loc FxFade}" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" FontWeight="Bold"/>
                                                            <TextBlock Grid.Column="2" x:Name="FadeChevron" Text="▼" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </Button>
                                                    <CheckBox Grid.Column="1" x:Name="FadeEnabledCheck" Content="{p:Loc Enable}" Style="{StaticResource RackPowerSwitch}" Checked="EffectEnabled_Changed" Unchecked="EffectEnabled_Changed"/>
                                                </Grid>
                                                
                                                <StackPanel x:Name="FadeContent" Visibility="Visible" Margin="0,6,0,0">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{p:Loc FxFadeInMs}" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="FadeInSlider" Minimum="0" Maximum="5000" TickFrequency="100" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
                                                        <Border Grid.Column="2" Style="{StaticResource ValueBadge}">
                                                            <TextBlock x:Name="FadeInLabel" Text="500" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{p:Loc FxFadeOutMs}" Style="{StaticResource SettingsLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="FadeOutSlider" Minimum="0" Maximum="5000" TickFrequency="100" Height="26" Margin="6,0" ValueChanged="EffectSlider_Changed"/>
