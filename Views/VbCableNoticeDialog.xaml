<Window x:Class="PaDDY.VbCableNoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VB-Audio Virtual Cable (VB-CABLE) — Download &amp; Notice"
        Icon="/PaDDY.ico"
        Width="700"
        MinWidth="660"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            GlassFrameThickness="4"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="12">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{DynamicResource TopWindowCornerRadius}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="VB-Audio Virtual Cable (VB-CABLE)"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Style="{StaticResource ChromeCloseBtn}"
                                HorizontalAlignment="Right"
                                ToolTip="Close"
                                Click="CancelBtn_Click">
                            <TextBlock Text="&#xE8BB;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="22,18,22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Card -->
                    <Border Grid.Row="0"
                            Style="{StaticResource SecondaryWindowHeaderCard}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            Padding="18,14"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="8" Background="#1A4CAF50" BorderBrush="#404CAF50" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="🎛" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="VB-Audio Virtual Cable" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Margin="10,0,0,0" Padding="7,2.5" CornerRadius="4" Background="#264CAF50" VerticalAlignment="Center">
                                        <TextBlock Text="WHQL Signed" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}"/>
                                    </Border>
                                    <Border Margin="6,0,0,0" Padding="7,2.5" CornerRadius="4" Background="#262196F3" VerticalAlignment="Center">
                                        <TextBlock Text="Donationware" FontSize="10" FontWeight="Bold" Foreground="#FF64B5F6"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Programmed by Vincent Burel / VB-Audio Software" FontSize="11.5" Foreground="{DynamicResource AccentTitleBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Explanation & Credit Glass Card -->
                    <Border Grid.Row="1"
                            Style="{StaticResource GlassCard}"
                            Padding="18,16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <!-- On-Demand Download Notice -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🌐" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Official On-Demand Download Notice" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="PaDDY facilitates on-demand downloading of the official, unmodified driver package directly from official VB-Audio servers upon your request. No driver binaries are bundled with PaDDY's installer."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="22,0,0,14"/>

                            <!-- Donationware & Support Notice -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="❤️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Support VB-Audio Software" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="VB-CABLE is high-performance donationware. All participations, contributions, and donations to VB-Audio Software are welcome."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="22,0,0,16"/>

                            <!-- VB-Audio Links Card -->
                            <Border Background="{DynamicResource BadgeBgBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="VB-Audio Official Web Portal" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="https://vb-audio.com" FontSize="11" Foreground="{DynamicResource AccentTitleBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Visit Website / Donate"
                                                Height="30"
                                                Padding="14,0"
                                                Margin="0,0,8,0"
                                                Click="OpenVbAudioWebsite_Click"/>
                                        <Button Content="Licensing"
                                                Height="30"
                                                Padding="12,0"
                                                Click="OpenLicensingPage_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Technical Specs Card -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="• WHQL Certified: Windows 10 &amp; 11 (Secure Boot Ready)" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="• Package Download Size: ~1.3 MB (Official Archive)" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="• Speaker Device: 'CABLE Input'" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="• Microphone Device: 'CABLE Output'" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Click 'Download &amp; Install' to begin automated setup."
                                   FontSize="11"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Cancel"
                                    Width="95"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    IsCancel="True"
                                    Click="CancelBtn_Click"/>
                            <Button Content="Download &amp; Install"
                                    MinWidth="180"
                                    Height="34"
                                    Padding="18,0"
                                    FontWeight="SemiBold"
                                    Background="{DynamicResource AccentGreenBrush}"
                                    Foreground="#FF0A1A0F"
                                    IsDefault="True"
                                    Click="DownloadAndInstallBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
