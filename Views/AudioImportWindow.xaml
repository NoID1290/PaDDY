<Window x:Class="PaDDY.Views.AudioImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:p="clr-namespace:PaDDY.Helpers"
        Title="Import &amp; Convert Audio - PaDDY"
        Icon="/PaDDY.ico"
        Width="580" Height="680"
        MinWidth="520" MinHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowGlowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFont}"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="8">
        <Border Style="{StaticResource SecondaryWindowFrame}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Border Grid.Row="0"
                        x:Name="HeaderBorder"
                        Background="{DynamicResource TitleBarGradient}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{DynamicResource TopWindowCornerRadius}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <!-- Icon -->
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Import &amp; Convert Audio"
                                       Foreground="{DynamicResource AccentTitleBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="FileCountBadge"
                                       Text="1 of 1"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource ChromeCloseBtn}"
                                    ToolTip="Close"
                                    Click="CancelButton_Click">
                                <TextBlock Text="&#xE8BB;" FontSize="10" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16,18,16">
                    <StackPanel>

                        <!-- Multi-file pagination banner (visible when > 1 file) -->
                        <Border x:Name="MultiFileNavCard"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,14"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PrevFileButton" Grid.Column="0" Content="&#xE76B; Prev" FontFamily="Segoe MDL2 Assets, Segoe UI"
                                        Padding="10,4" Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Click="PrevFileButton_Click"/>
                                <TextBlock x:Name="MultiFileStatusText" Grid.Column="1" Text="Processing File 1 of 3"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}"/>
                                <Button x:Name="NextFileButton" Grid.Column="2" Content="Next &#xE76C;" FontFamily="Segoe UI, Segoe MDL2 Assets"
                                        Padding="10,4" Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Click="NextFileButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Audio Source Info Card -->
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#2000E676" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="&#xEC4F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="SourceFileNameText" Text="AudioFileName.wav"
                                                   FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SourceFilePathText" Text="C:\Path\To\File.wav"
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Source format tag -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SOURCE FORMAT" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="SourceFormatTag" Text="WAV" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- Duration -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="DURATION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="SourceDurationText" Text="0:00" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- Channels / Sample Rate -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CHANNELS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="SourceChannelsText" Text="Stereo" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- File Size -->
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="SIZE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="SourceFileSizeText" Text="0 MB" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Setting 1: Pad / Recording Name -->
                        <TextBlock Text="PAD NAME" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,6"/>
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,14">
                            <Grid Margin="10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="PadNameTextBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                                         FontSize="13"
                                         VerticalAlignment="Center"
                                         TextChanged="PadNameTextBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Setting 2: Target Audio Format (Converter) -->
                        <TextBlock Text="AUDIO FORMAT (CONVERTER)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,6"/>
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Output Audio Codec" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock x:Name="FormatDescText" Text="Lossless standard format for instant zero-latency playback" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="AudioFormatComboBox"
                                              Grid.Column="1"
                                              Height="32"
                                              VerticalAlignment="Center"
                                              SelectionChanged="AudioFormatComboBox_SelectionChanged">
                                        <ComboBoxItem Content="WAV (.wav) — PCM" Tag="wav"/>
                                        <ComboBoxItem Content="MP3 (.mp3) — Standard" Tag="mp3"/>
                                        <ComboBoxItem Content="FLAC (.flac) — Lossless" Tag="flac"/>
                                        <ComboBoxItem Content="OGG (.ogg) — Vorbis" Tag="ogg"/>
                                        <ComboBoxItem Content="OPUS (.opus) — Low Latency" Tag="opus"/>
                                        <ComboBoxItem Content="AAC (.m4a) — High Quality" Tag="aac"/>
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Setting 3: Pad Color Customizer -->
                        <TextBlock Text="PAD COLOR" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,6"/>
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Swatches WrapPanel -->
                                <WrapPanel x:Name="ColorSwatchesPanel" Margin="0,0,0,10"/>

                                <!-- Custom Hex and Preview Row -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Hex Input -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Custom Hex Color" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <Border Background="{DynamicResource ControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Height="30">
                                            <TextBox x:Name="CustomHexTextBox"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                                                     FontSize="12"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0"
                                                     TextChanged="CustomHexTextBox_TextChanged"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Pad Preview Swatch -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Preview" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <Border x:Name="PadPreviewBorder"
                                                Width="90" Height="30"
                                                CornerRadius="6"
                                                BorderThickness="1.5"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                Background="{DynamicResource CardBgBrush}">
                                            <TextBlock x:Name="PadPreviewLabel"
                                                       Text="PAD"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Conversion Progress Section -->
                        <Border x:Name="ProgressCard"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource AccentGreenBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,14"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="ProgressStatusText" Text="Converting audio..." FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}"/>
                                </Grid>
                                <ProgressBar x:Name="ConversionProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{DynamicResource AccentGreenBrush}" Background="#30000000" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="ApplyAllCheckBox"
                                      Grid.Column="0"
                                      Content="Apply format &amp; color to all"
                                      Foreground="{DynamicResource SecondaryTextBrush}"
                                      FontSize="11.5"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                            <Button x:Name="CancelButton"
                                    Grid.Column="2"
                                    Content="Cancel"
                                    Width="90" Height="34"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource CardBgBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Click="CancelButton_Click"/>

                            <Button x:Name="SaveButton"
                                    Grid.Column="3"
                                    Content="Import &amp; Save"
                                    Width="120" Height="34"
                                    FontWeight="SemiBold"
                                    Background="{DynamicResource AccentGreenBrush}"
                                    Foreground="#FF0A0E17"
                                    BorderThickness="0"
                                    Click="SaveButton_Click"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
