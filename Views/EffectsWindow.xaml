<Window x:Class="PaDDY.Views.EffectsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:PaDDY.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0"
                Background="{ThemeResource TitleBarGradient}"
                BorderBrush="#16FFFFFF"
                BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="TitleText"
                           Text="Effects"
                           Foreground="{ThemeResource SubtleTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
                <Button Style="{StaticResource ChromeCloseBtn}"
                        HorizontalAlignment="Right"
                        ToolTipService.ToolTip="Close"
                        Click="ChromeClose_Click">
                    <TextBlock Text="&#x2715;" FontSize="11" FontFamily="Segoe UI"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1"
                Margin="10,0,10,10"
                Padding="16"
                CornerRadius="0,0,12,12"
                Background="{ThemeResource SecondaryWindowBackgroundBrush}"
                BorderBrush="{ThemeResource WindowEdgeBrush}"
                BorderThickness="0"
                >
            <StackPanel>


                <!-- ── Fade In / Fade Out (per-clip only) ─────────────────── -->
                <Border x:Name="FadeSection"
                        Style="{StaticResource GlassCard}"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                            <TextBlock Grid.Column="1" Text="Fade In / Fade Out"
                                       Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                            <CheckBox Grid.Column="2" x:Name="FadeEnabledCheck"
                                      Foreground="{ThemeResource AccentGreenBrush}"
                                      Content="Enable" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" x:Name="FadeChevron" Text="&#x25BA;"
                                       FontSize="9" Foreground="#FF6060A0"
                                       VerticalAlignment="Center" Margin="4,0,0,0" PointerReleased="FadeChevron_Click"/>
                        </Grid>
                        <StackPanel x:Name="FadeContent" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fade In (ms)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="FadeInSlider"
                                        Minimum="0" Maximum="5000" TickFrequency="100"
                                        ValueChanged="FadeInSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="FadeInLabel" Text="500"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fade Out (ms)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="FadeOutSlider"
                                        Minimum="0" Maximum="5000" TickFrequency="100"
                                        ValueChanged="FadeOutSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="FadeOutLabel" Text="500"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Noise Gate ──────────────────────────────────────────── -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                            <TextBlock Grid.Column="1" Text="Noise Gate"
                                       Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                            <CheckBox Grid.Column="2" x:Name="GateEnabledCheck"
                                      Foreground="{ThemeResource AccentGreenBrush}"
                                      Content="Enable" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" x:Name="GateChevron" Text="&#x25BA;"
                                       FontSize="9" Foreground="#FF6060A0"
                                       VerticalAlignment="Center" Margin="4,0,0,0" PointerReleased="GateChevron_Click"/>
                        </Grid>
                        <StackPanel x:Name="GateContent" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Threshold (dB)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="GateThresholdSlider"
                                        Minimum="-80" Maximum="0"
                                        ValueChanged="GateThresholdSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="GateThresholdLabel" Text="-40"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Attack (ms)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="GateAttackSlider"
                                        Minimum="1" Maximum="200"
                                        ValueChanged="GateAttackSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="GateAttackLabel" Text="10"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Release (ms)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="GateReleaseSlider"
                                        Minimum="10" Maximum="2000"
                                        ValueChanged="GateReleaseSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="GateReleaseLabel" Text="100"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Echo ───────────────────────────────────────────────── -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                            <TextBlock Grid.Column="1" Text="Echo"
                                       Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                            <CheckBox Grid.Column="2" x:Name="EchoEnabledCheck"
                                      Foreground="{ThemeResource AccentGreenBrush}"
                                      Content="Enable" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" x:Name="EchoChevron" Text="&#x25BA;"
                                       FontSize="9" Foreground="#FF6060A0"
                                       VerticalAlignment="Center" Margin="4,0,0,0" PointerReleased="EchoChevron_Click"/>
                        </Grid>
                        <StackPanel x:Name="EchoContent" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Delay (ms)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="EchoDelaySlider"
                                        Minimum="50" Maximum="2000"
                                        ValueChanged="EchoDelaySlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="EchoDelayLabel" Text="200"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Feedback"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="EchoFeedbackSlider"
                                        Minimum="0" Maximum="0.95" TickFrequency="0.05"
                                        ValueChanged="EchoFeedbackSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="EchoFeedbackLabel" Text="0.30"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mix (wet)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="EchoMixSlider"
                                        Minimum="0" Maximum="1" TickFrequency="0.05"
                                        ValueChanged="EchoMixSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="EchoMixLabel" Text="0.40"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Compressor ──────────────────────────────────────────── -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                            <TextBlock Grid.Column="1" Text="Compressor"
                                       Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                            <CheckBox Grid.Column="2" x:Name="CompEnabledCheck"
                                      Foreground="{ThemeResource AccentGreenBrush}"
                                      Content="Enable" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" x:Name="CompChevron" Text="&#x25BA;"
                                       FontSize="9" Foreground="#FF6060A0"
                                       VerticalAlignment="Center" Margin="4,0,0,0" PointerReleased="CompChevron_Click"/>
                        </Grid>
                        <StackPanel x:Name="CompContent" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Threshold (dB)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="CompThresholdSlider"
                                        Minimum="-60" Maximum="0"
                                        ValueChanged="CompSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="CompThresholdLabel" Text="-18"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ratio (:1)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="CompRatioSlider"
                                        Minimum="1" Maximum="20" TickFrequency="0.5"
                                        ValueChanged="CompSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="CompRatioLabel" Text="4.0"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Attack (ms)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="CompAttackSlider"
                                        Minimum="1" Maximum="200"
                                        ValueChanged="CompSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="CompAttackLabel" Text="10"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Release (ms)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="CompReleaseSlider"
                                        Minimum="20" Maximum="1000"
                                        ValueChanged="CompSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="CompReleaseLabel" Text="120"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Makeup (dB)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="CompMakeupSlider"
                                        Minimum="0" Maximum="24"
                                        ValueChanged="CompSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="CompMakeupLabel" Text="0"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Distortion ──────────────────────────────────────────── -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                            <TextBlock Grid.Column="1" Text="Distortion"
                                       Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                            <CheckBox Grid.Column="2" x:Name="DistEnabledCheck"
                                      Foreground="{ThemeResource AccentGreenBrush}"
                                      Content="Enable" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" x:Name="DistChevron" Text="&#x25BA;"
                                       FontSize="9" Foreground="#FF6060A0"
                                       VerticalAlignment="Center" Margin="4,0,0,0" PointerReleased="DistChevron_Click"/>
                        </Grid>
                        <StackPanel x:Name="DistContent" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Drive"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="DistDriveSlider"
                                        Minimum="1" Maximum="50"
                                        ValueChanged="DistSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="DistDriveLabel" Text="8"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mix (wet)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="DistMixSlider"
                                        Minimum="0" Maximum="1" TickFrequency="0.05"
                                        ValueChanged="DistSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="DistMixLabel" Text="0.60"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Output"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="DistLevelSlider"
                                        Minimum="0" Maximum="1" TickFrequency="0.05"
                                        ValueChanged="DistSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="DistLevelLabel" Text="0.80"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Reverb ──────────────────────────────────────────────── -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                            <TextBlock Grid.Column="1" Text="Reverb"
                                       Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                            <CheckBox Grid.Column="2" x:Name="ReverbEnabledCheck"
                                      Foreground="{ThemeResource AccentGreenBrush}"
                                      Content="Enable" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" x:Name="ReverbChevron" Text="&#x25BA;"
                                       FontSize="9" Foreground="#FF6060A0"
                                       VerticalAlignment="Center" Margin="4,0,0,0" PointerReleased="ReverbChevron_Click"/>
                        </Grid>
                        <StackPanel x:Name="ReverbContent" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Room Size"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="ReverbRoomSlider"
                                        Minimum="0" Maximum="1" TickFrequency="0.05"
                                        ValueChanged="ReverbSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="ReverbRoomLabel" Text="0.50"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Damping"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="ReverbDampSlider"
                                        Minimum="0" Maximum="1" TickFrequency="0.05"
                                        ValueChanged="ReverbSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="ReverbDampLabel" Text="0.50"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mix (wet)"
                                           Style="{StaticResource SettingsLabel}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="ReverbMixSlider"
                                        Minimum="0" Maximum="1" TickFrequency="0.05"
                                        ValueChanged="ReverbSlider_ValueChanged"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadge}" Margin="6,0,0,0">
                                    <TextBlock x:Name="ReverbMixLabel" Text="0.30"
                                               Foreground="{ThemeResource AccentGreenBrush}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Equalizer ───────────────────────────────────────────── -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Style="{StaticResource HeaderAccentBar}"/>
                            <TextBlock Grid.Column="1" Text="Equalizer (5-Band)"
                                       Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                            <CheckBox Grid.Column="2" x:Name="EqEnabledCheck"
                                      Foreground="{ThemeResource AccentGreenBrush}"
                                      Content="Enable" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" x:Name="EqChevron" Text="&#x25BA;"
                                       FontSize="9" Foreground="#FF6060A0"
                                       VerticalAlignment="Center" Margin="4,0,0,0" PointerReleased="EqChevron_Click"/>
                        </Grid>
                        <!-- Horizontal 5-band EQ -->
                        <Grid x:Name="EqContent" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition />
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <!-- Band labels -->
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="80Hz"
                                       Style="{StaticResource SettingsLabel}" FontSize="9"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="250Hz"
                                       Style="{StaticResource SettingsLabel}" FontSize="9"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Grid.Column="2" Grid.Row="0" Text="1kHz"
                                       Style="{StaticResource SettingsLabel}" FontSize="9"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Grid.Column="3" Grid.Row="0" Text="4kHz"
                                       Style="{StaticResource SettingsLabel}" FontSize="9"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Grid.Column="4" Grid.Row="0" Text="12kHz"
                                       Style="{StaticResource SettingsLabel}" FontSize="9"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <!-- Vertical sliders -->
                            <Slider Grid.Column="0" Grid.Row="1" x:Name="EqSubBassSlider"
                                    Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    ValueChanged="EqSlider_ValueChanged"/>
                            <Slider Grid.Column="1" Grid.Row="1" x:Name="EqBassSlider"
                                    Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    ValueChanged="EqSlider_ValueChanged"/>
                            <Slider Grid.Column="2" Grid.Row="1" x:Name="EqMidSlider"
                                    Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    ValueChanged="EqSlider_ValueChanged"/>
                            <Slider Grid.Column="3" Grid.Row="1" x:Name="EqPresenceSlider"
                                    Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    ValueChanged="EqSlider_ValueChanged"/>
                            <Slider Grid.Column="4" Grid.Row="1" x:Name="EqTrebleSlider"
                                    Orientation="Vertical" Minimum="-12" Maximum="12" TickFrequency="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    ValueChanged="EqSlider_ValueChanged"/>
                            <!-- Value badges -->
                            <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                <TextBlock x:Name="EqSubBassLabel" Text="0 dB"
                                           Foreground="{ThemeResource AccentGreenBrush}" FontSize="9"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                <TextBlock x:Name="EqBassLabel" Text="0 dB"
                                           Foreground="{ThemeResource AccentGreenBrush}" FontSize="9"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                <TextBlock x:Name="EqMidLabel" Text="0 dB"
                                           Foreground="{ThemeResource AccentGreenBrush}" FontSize="9"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="3" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                <TextBlock x:Name="EqPresenceLabel" Text="0 dB"
                                           Foreground="{ThemeResource AccentGreenBrush}" FontSize="9"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="4" Grid.Row="2" Style="{StaticResource ValueBadge}" Margin="2,4,2,0">
                                <TextBlock x:Name="EqTrebleLabel" Text="0 dB"
                                           Foreground="{ThemeResource AccentGreenBrush}" FontSize="9"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Footer buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ResetBtn"
                            Content="Reset All"
                            
                            Margin="0,0,8,0"
                            Click="ResetBtn_Click"/>
                    <Button x:Name="OkBtn"
                            Content="OK"
                            
                            Margin="0,0,8,0"
                            Foreground="{ThemeResource AccentGreenBrush}"
                            Click="OkBtn_Click"/>
                    <Button Content="Cancel"
                            
                            Click="ChromeClose_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>






