<Window x:Class="PaDDY.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PaDDY.Controls"
        Title="Starting PaDDY..." 
        Height="250" Width="250"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen" 
        Topmost="True" 
        ShowInTaskbar="False">
    <Grid>
        <!-- The LoadingOverlay itself has a Background of #CC0A0A12 so we can just use it directly -->
        <controls:LoadingOverlay x:Name="SplashLoadingOverlay" />
    </Grid>
</Window>
