<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NoIDSoftwork.Core</AssemblyName>
    <RootNamespace>PaDDY</RootNamespace>
    <Version>1.3.0.0601</Version>
    <AssemblyVersion>1.3.0.0601</AssemblyVersion>
    <FileVersion>1.3.0.0601</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>PaDDY.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="AudioProcessor\AudioProcessor.csproj" />
    <ProjectReference Include="EffectProcessor\EffectProcessor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.4" ExcludeFromSingleFile="true" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" ExcludeFromSingleFile="true" />
    <PackageReference Include="Whisper.net" Version="1.8.1" ExcludeFromSingleFile="true" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="ExcludeAppDllsFromSingleFile" BeforeTargets="_ComputeFilesToBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'NoIDSoftwork.AudioProcessor' or                      '%(Filename)' == 'NoIDSoftwork.EffectProcessor'" ExcludeFromSingleFile="true" />
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'MessagePack' or                      '%(ResolvedFileToPublish.NuGetPackageId)' == 'MessagePack.Annotations' or                      '%(ResolvedFileToPublish.NuGetPackageId)' == 'Microsoft.Data.Sqlite' or                      '%(ResolvedFileToPublish.NuGetPackageId)' == 'Microsoft.Data.Sqlite.Core' or                      '%(ResolvedFileToPublish.NuGetPackageId)' == 'SQLitePCLRaw.bundle_e_sqlite3' or                      '%(ResolvedFileToPublish.NuGetPackageId)' == 'SQLitePCLRaw.core' or                      '%(ResolvedFileToPublish.NuGetPackageId)' == 'SQLitePCLRaw.lib.e_sqlite3' or                      '%(ResolvedFileToPublish.NuGetPackageId)' == 'SQLitePCLRaw.provider.e_sqlite3'" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Remove="AudioProcessor\**" />
    <None Remove="AudioProcessor\**" />
    <EmbeddedResource Remove="AudioProcessor\**" />
    <Page Remove="AudioProcessor\**" />
    <ApplicationDefinition Remove="AudioProcessor\**" />
    <Compile Remove="EffectProcessor\**" />
    <None Remove="EffectProcessor\**" />
    <EmbeddedResource Remove="EffectProcessor\**" />
    <Page Remove="EffectProcessor\**" />
    <ApplicationDefinition Remove="EffectProcessor\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="AudioProcessor\vendors\licenses\*.txt">
      <Link>licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="AudioProcessor\vendors\VENDORING_MANIFEST.md">
      <Link>licenses\VENDORING_MANIFEST.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="PaDDY.ico" />
    <Resource Include="Themes\Fonts\ari-w9500.ttf" />
    <Resource Include="Themes\Fonts\ari-w9500-bold.ttf" />
    <Resource Include="Themes\Fonts\ari-w9500-condensed.ttf" />
    <Resource Include="Themes\Fonts\ari-w9500-condensed-bold.ttf" />
    <Resource Include="Themes\Fonts\ari-w9500-condensed-display.ttf" />
    <Resource Include="Themes\Fonts\ari-w9500-display.ttf" />
  </ItemGroup>
  <Target Name="RenameExeAfterBuild" AfterTargets="Build">
    <Move SourceFiles="$(OutputPath)NoIDSoftwork.Core.exe" DestinationFiles="$(OutputPath)PaDDY.exe" Condition="Exists('$(OutputPath)NoIDSoftwork.Core.exe')" />
  </Target>
  <Target Name="RenameExeAfterPublish" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)NoIDSoftwork.Core.exe" DestinationFiles="$(PublishDir)PaDDY.exe" Condition="Exists('$(PublishDir)NoIDSoftwork.Core.exe')" />
  </Target>
</Project>