<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NoIDSoftwork.Core</AssemblyName>
    <RootNamespace>PaDDY</RootNamespace>
    <Version>2.3.2.0820</Version>
    <AssemblyVersion>2.3.2.0820</AssemblyVersion>
    <FileVersion>2.3.2.0820</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>PaDDY.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <InformationalVersion>2.3.2.0820</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="AudioProcessor\AudioProcessor.csproj" />
    <ProjectReference Include="EffectProcessor\EffectProcessor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>
  <Target Name="ExcludeAppDllsFromSingleFile" BeforeTargets="_ComputeFilesToBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <!-- Project references -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'NoIDSoftwork.AudioProcessor' or '%(Filename)' == 'NoIDSoftwork.EffectProcessor'" ExcludeFromSingleFile="true" />
      <!-- All NuGet packages except .NET Core / WindowsDesktop runtime packs -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' != '' and&#xD;&#xA;                                        !$([System.String]::Copy('%(ResolvedFileToPublish.NuGetPackageId)').StartsWith('Microsoft.NETCore.App')) and&#xD;&#xA;                                        !$([System.String]::Copy('%(ResolvedFileToPublish.NuGetPackageId)').StartsWith('Microsoft.WindowsDesktop.App'))" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Remove="AudioProcessor\**" />
    <None Remove="AudioProcessor\**" />
    <EmbeddedResource Remove="AudioProcessor\**" />
    <Page Remove="AudioProcessor\**" />
    <ApplicationDefinition Remove="AudioProcessor\**" />
    <Compile Remove="EffectProcessor\**" />
    <None Remove="EffectProcessor\**" />
    <EmbeddedResource Remove="EffectProcessor\**" />
    <Page Remove="EffectProcessor\**" />
    <ApplicationDefinition Remove="EffectProcessor\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Licenses\*.txt">
      <Link>licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="AudioProcessor\vendors\VENDORING_MANIFEST.md">
      <Link>licenses\VENDORING_MANIFEST.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="AudioProcessor\vendors\NAudio.Lame\NAudio.Lame\libmp3lame.64.dll">
      <Link>libmp3lame.64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="AudioProcessor\vendors\BASS\x64\bass.dll">
      <Link>bass.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include=".inno\com.paddy.streamDeckPlugin">
      <LogicalName>com.paddy.streamDeckPlugin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="PaDDY.ico" />
    <Resource Include="Themes\Fonts\GeneralSans-Variable.ttf" />
    <Resource Include="Themes\Fonts\ari-w9500-condensed-display.ttf" />
    <Resource Include="Themes\Fonts\ari-w9500-display.ttf" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="DiscordGameSDK\discord_game_sdk.dll">
      <LogicalName>discord_game_sdk.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RenameExeAfterBuild" AfterTargets="Build">
    <Delete Files="$(OutputPath)PaDDY.exe" Condition="Exists('$(OutputPath)NoIDSoftwork.Core.exe') And Exists('$(OutputPath)PaDDY.exe')" />
    <Move SourceFiles="$(OutputPath)NoIDSoftwork.Core.exe" DestinationFiles="$(OutputPath)PaDDY.exe" Condition="Exists('$(OutputPath)NoIDSoftwork.Core.exe')" />
  </Target>
  <Target Name="RenameExeAfterPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)PaDDY.exe" Condition="Exists('$(PublishDir)NoIDSoftwork.Core.exe') And Exists('$(PublishDir)PaDDY.exe')" />
    <Move SourceFiles="$(PublishDir)NoIDSoftwork.Core.exe" DestinationFiles="$(PublishDir)PaDDY.exe" Condition="Exists('$(PublishDir)NoIDSoftwork.Core.exe')" />
  </Target>
  <!--
    PaDDY ships for win-x64 ONLY.  NuGet packages (Whisper.net.Runtime,
    SQLitePCLRaw, etc.) may copy native binaries for other platforms into
    runtimes\. The targets below aggressively prune every non-win-x64 subfolder.
  -->
  <Target Name="PruneUnusedRuntimeFolders" AfterTargets="Build" Condition="Exists('$(OutputPath)runtimes')">
    <RemoveDir Directories="&#xD;&#xA;      $(OutputPath)runtimes\win-arm64;&#xD;&#xA;      $(OutputPath)runtimes\win-x86;&#xD;&#xA;      $(OutputPath)runtimes\win-arm;&#xD;&#xA;      $(OutputPath)runtimes\win10-arm;&#xD;&#xA;      $(OutputPath)runtimes\win10-arm64;&#xD;&#xA;      $(OutputPath)runtimes\win10-x86;&#xD;&#xA;      $(OutputPath)runtimes\linux-x64;&#xD;&#xA;      $(OutputPath)runtimes\linux-arm64;&#xD;&#xA;      $(OutputPath)runtimes\linux-arm;&#xD;&#xA;      $(OutputPath)runtimes\osx-x64;&#xD;&#xA;      $(OutputPath)runtimes\osx-arm64;&#xD;&#xA;      $(OutputPath)runtimes\maccatalyst-arm64;&#xD;&#xA;      $(OutputPath)runtimes\android-arm64-v8a;&#xD;&#xA;      $(OutputPath)runtimes\android-x86" />
  </Target>
  <Target Name="PruneUnusedRuntimeFoldersPublish" AfterTargets="Publish" Condition="Exists('$(PublishDir)runtimes')">
    <RemoveDir Directories="&#xD;&#xA;      $(PublishDir)runtimes\win-arm64;&#xD;&#xA;      $(PublishDir)runtimes\win-x86;&#xD;&#xA;      $(PublishDir)runtimes\win-arm;&#xD;&#xA;      $(PublishDir)runtimes\win10-arm;&#xD;&#xA;      $(PublishDir)runtimes\win10-arm64;&#xD;&#xA;      $(PublishDir)runtimes\win10-x86;&#xD;&#xA;      $(PublishDir)runtimes\linux-x64;&#xD;&#xA;      $(PublishDir)runtimes\linux-arm64;&#xD;&#xA;      $(PublishDir)runtimes\linux-arm;&#xD;&#xA;      $(PublishDir)runtimes\osx-x64;&#xD;&#xA;      $(PublishDir)runtimes\osx-arm64;&#xD;&#xA;      $(PublishDir)runtimes\maccatalyst-arm64;&#xD;&#xA;      $(PublishDir)runtimes\android-arm64-v8a;&#xD;&#xA;      $(PublishDir)runtimes\android-x86" />
  </Target>
</Project>